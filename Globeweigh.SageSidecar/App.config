<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <appSettings>
    <!-- ===== The Evergreen API, where the queue lives ===== -->
    <add key="ApiBaseUrl" value="http://evergreen:5099" />
    <!-- Must equal Sage:SidecarKey in the API's appsettings.json on the server. -->
    <add key="SidecarKey" value="" />

    <!-- ===== The Sage 50 company to post into ===== -->
    <!-- The company's ACCDATA folder. A UNC path is fine, but then the account the service
         runs as needs rights to it: LocalSystem has none on the network, so either run the
         service as a domain user (install-service.ps1 -Credential) or install the sidecar
         on the Sage server itself and use the local path.
           C:\ProgramData\Sage\Accounts\2022\COMPANY.000\ACCDATA
           \\SAGESERVER\SAGE\COMPANY.000\ACCDATA
           C:\ProgramData\Sage\Accounts\2022\DemoData\ACCDATA      (the demo company) -->
    <add key="SageDataPath" value="" />
    <!-- A Sage user for the sidecar. Give it its OWN login: SDO holds a Sage user seat while
         connected, and sharing a login with a person gets one of them thrown out. -->
    <add key="SageUsername" value="manager" />
    <add key="SagePassword" value="" />
    <add key="SageWorkspaceName" value="Globeweigh" />

    <!-- ===== Mapping ===== -->
    <!-- Units | Pallets - what QTY_ORDER means on the Sage order line. Must agree with what
         the unit price is per. Evergreen's prices (order line / costing zone) are per BAG -
         e.g. 3.28 for a 60L compost - so Units (pallets x bags-per-pallet). Pallets would
         send 3 x 3.28 for a 3-pallet line instead of 210 x 3.28. -->
    <add key="QuantityBasis" value="Units" />
    <!-- Sage order-header field that receives the Evergreen reference (EVG-<order no>).
         Also how the sidecar recognises an order that is already in Sage. ANALYSIS_1,
         ANALYSIS_2, ANALYSIS_3, or blank for neither. -->
    <add key="ReferenceField" value="ANALYSIS_1" />
    <!-- A line whose SKU is not a Sage stock code is posted under this special product
         code (S1 = Sage's "special product item") with the SKU kept in the description.
         Blank = FAIL the order instead, so every line has to be a real Sage product. -->
    <add key="NonStockCode" value="S1" />
    <!-- Nominal and tax code for such non-stock lines (real stock lines take theirs from
         the Sage product record). Tax code is the number: 1 = T1 standard, 0 = T0 zero. -->
    <add key="DefaultNominalCode" value="4000" />
    <add key="DefaultTaxCode" value="1" />
    <!-- Tax rates by code number, used only if Sage will not report the rate itself. -->
    <add key="TaxRates" value="0:0;1:20;2:5;9:0" />
    <!-- Goes in the order's "Taken by" box. -->
    <add key="TakenBy" value="Globeweigh" />
    <!-- Before posting, look through this many of the newest Sage orders for one already
         carrying the reference (a post that succeeded but was never acknowledged). 0 = off. -->
    <add key="DuplicateScanDepth" value="500" />

    <!-- ===== Behaviour ===== -->
    <add key="Enabled" value="true" />
    <add key="PollSeconds" value="10" />
    <add key="ErrorBackoffSeconds" value="30" />
    <!-- How often to re-read the Sage customer ledger into the API's mirror (Admin > Sage
         Link > Customers), in minutes. 0 = only when someone presses Refresh from Sage. -->
    <add key="CustomerSyncMinutes" value="60" />
    <!-- The sales mirror behind Reports (audit-trail invoices/credits + invoice lines): how
         often to re-read it, in minutes (0 = only on Refresh from Sage); how far back it goes
         (from 1 January this many years ago: 1 = last year and this year); and the early stop
         when reading the audit trail newest-first (stop after this many consecutive entries
         older than the window; 0 = read every entry). The invoice file is always read whole:
         Evergreen's credit notes carry their own low numbers and sit at the start of it. A
         full read is about 5 minutes. -->
    <add key="SalesSyncMinutes" value="180" />
    <add key="SalesHistoryYears" value="1" />
    <add key="SalesScanStopRun" value="3000" />
  </appSettings>
</configuration>
