<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{72964950-2141-4B82-9E13-0F326C125004}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>Globeweigh.SageSidecar</RootNamespace>
    <AssemblyName>Globeweigh.SageSidecar</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <!-- x86 ONLY, on purpose. Sage's SDO engine (sg50SdoEngine280.dll) is a 32-bit in-process
       COM server: an AnyCPU/x64 build compiles fine and then fails at the first
       new SDOEngine() with "class not registered" - which is exactly the trap the old
       WPF projects, built x64 against the same reference, were sitting on. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Newtonsoft.Json, Version=12.0.0.0, Culture=neutral, PublicKeyToken=30ad4fe6b2a6aeed, processorArchitecture=MSIL">
      <HintPath>..\packages\Newtonsoft.Json.12.0.2\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Configuration" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Xml" />
    <!-- Sage Data Objects v28. A compiled-in interop (TlbImp of SdoEng280.tlb, checked in
         under lib\) rather than a <COMReference>, so this builds on any machine without the
         SDO typelib being registered - losing that registration on a rebuilt dev box is what
         took the old Admin project down. Embedded, so nothing extra ships. At RUNTIME the
         real SDO engine must be on the box: the Sage 50 client, or Sage50Accounts_SDO.msi
         from Documents\Sage 50cloud Accounts v28.1.404.0 Developer SDO. -->
    <Reference Include="Interop.SageDataObject280">
      <HintPath>lib\Interop.SageDataObject280.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ApiClient.cs" />
    <Compile Include="Diagnostics.cs" />
    <Compile Include="ExportWorker.cs" />
    <Compile Include="Log.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SagePayload.cs" />
    <Compile Include="SageSopWriter.cs" />
    <Compile Include="SidecarConfig.cs" />
    <Compile Include="SidecarService.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App.config" />
    <None Include="packages.config" />
    <None Include="deploy.ps1" />
    <None Include="install-service.ps1" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
