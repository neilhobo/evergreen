<shared:WindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
	xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
 xmlns:shared="clr-namespace:Globeweigh.Shared"
 xmlns:converters="clr-namespace:Globeweigh.Shared.Converters"
	x:Class="Globeweigh.Shared.ServerConfigView" WindowStartupLocation="CenterScreen"
    Title="Server Config" Height="530" Width="700" 
    md:DialogServiceViews.IsRegistered="True" >

    <shared:WindowBase.Resources>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>

        <Style x:Key="BlueRoundedButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource DarkGreyBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DarkGreyBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <Grid >
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" Name="content" FontWeight="{TemplateBinding FontWeight}" FontFamily="Segoe UI Semibold" Margin="0,2,0,4"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="BorderBrush" Value="{DynamicResource MainBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource MainBorderBrush}"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </shared:WindowBase.Resources>


    <Grid x:Name="ParentGrid" Margin="2" Background="#FFCDCDCD">
        <Grid x:Name="LayoutRoot" Background="White" Margin="3">
            <Border BorderThickness="1" Margin="0" Background="White">
                <StackPanel Margin="0,0,0,46" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" >
                    <!--<Image Width="160" Height="100" Source="/Globeweigh.Admin;component/Images/ClonakiltyLogo.png" Margin="0,0,0,20"/>-->
                    <TextBlock Text="Error connecting to the server" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" Margin="0,0,0,30" FontSize="29.333" FontWeight="Light"/>
                    <TextBlock Text="Server instance " HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" Margin="0,0,0,4" FontSize="13.333" FontWeight="Light" FontFamily="Segoe UI Semibold"/>
                    <dxe:TextEdit EditValue="{Binding ServerInstance, UpdateSourceTrigger=PropertyChanged}" FontSize="13.333" Margin="0,0,0,6" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Database Name" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" Margin="0,10,0,4" FontSize="13.333" FontWeight="Light" FontFamily="Segoe UI Semibold"/>
                    <dxe:TextEdit EditValue="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" FontSize="13.333" Margin="0,0,0,10" Height="32" VerticalContentAlignment="Center"/>

                    <Grid Margin="0,30,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Test Connection" HorizontalAlignment="Left" Height="30" Width="120" Style="{DynamicResource BlueRoundedButtonStyle}" Command="{Binding LoginCommand}" Background="#FF5A94F1" Foreground="White" BorderThickness="0" BorderBrush="{x:Null}"/>

                        <Grid Grid.Column="1" Margin="10,0,0,0" Visibility="{Binding ConnectionSuccessfull, Converter={StaticResource NullToCollapsedConverter}}">
                            <Image  Source="/Globeweigh.Shared;component/Images/GreenTick-32.png"  Visibility="{Binding ConnectionSuccessful, Converter={StaticResource TrueToVisibilityConverter}}"/>
                            <Image Source="/Globeweigh.Shared;component/Images/RedX-32.png"  Visibility="{Binding ConnectionSuccessful, Converter={StaticResource TrueToCollapsedConverter}}"/>
                        </Grid>
                        <Button Content="Save &amp; continue" HorizontalAlignment="Right" Height="30" Visibility="{Binding ConnectionSuccessful, Converter={StaticResource TrueToVisibilityConverter}}" Width="130" Style="{DynamicResource BlueRoundedButtonStyle}" Command="{Binding LoginCommand}" Background="#FF5A94F1" Foreground="White" BorderThickness="0" BorderBrush="{x:Null}" Grid.Column="2"/>

                    </Grid>
                </StackPanel>
            </Border>
            <!--            <dx:WaitIndicator x:Name="busyIndicator" dx:ThemeManager.ThemeName="MetropolisLight"/>-->


        </Grid>
    </Grid>
</shared:WindowBase>
