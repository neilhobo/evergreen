<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Touch.CaptureWeightView" WindowStyle="None" Margin="50"
        AllowsTransparency="True" mc:Ignorable="d"  ResizeMode="NoResize"  
        Width="800" Height="860"
        md:DialogServiceViews.IsRegistered ="True" Background="{DynamicResource MainNavyBrush}" IsOwnerSize="False" >

    <shared:WindowBase.Resources>


        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>
        <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        
        <system:Boolean x:Key="True">True</system:Boolean>
        <system:Boolean x:Key="False">False</system:Boolean>

    </shared:WindowBase.Resources>
    <Border Background="White" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource TransactionBorderHeaderStyle}">
                <TextBlock Text="{Binding HeaderText}" VerticalAlignment="Center" FontSize="30" Margin="20,0" Foreground="{DynamicResource MainNavyBrush}"/>
            </Border>
            <Grid Grid.Column="1" Grid.Row="1" Margin="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource ItemBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource LightGreyBrush}">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="rdoAuto" Style="{DynamicResource RadioSwitchStyle}" Content="Auto" GroupName="boxes" IsChecked="{Binding IsManual, Converter={StaticResource RadioButtonCheckedConverter},ConverterParameter={StaticResource False}}" BorderThickness="1,1,0,1" />
                        <RadioButton x:Name="rdoManual" Style="{DynamicResource RadioSwitchStyle}" Content="Manual" GroupName="boxes" IsChecked="{Binding IsManual, Converter={StaticResource RadioButtonCheckedConverter},ConverterParameter={StaticResource True}}" BorderThickness="0,1,1,1" Grid.ColumnSpan="2" Grid.Column="1"/>
                    </Grid>
                </Border>
                <!--<Grid Grid.Row="1" Height="80" Margin="20,0" Visibility="{Binding ExpectedWeightDisplay, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="535*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Expected Weight:" VerticalAlignment="Center" FontSize="28" Foreground="{DynamicResource MainNavyBrush}"/>
                    <TextBlock Text="{Binding ExpectedWeightDisplay}" VerticalAlignment="Center" FontSize="28" Foreground="{DynamicResource MainNavyBrush}" Grid.Column="1" Margin="20,0,0,0"/>
                </Grid>-->
                <Grid Background="{DynamicResource LightGreyBrush}" Grid.Row="2"  Visibility="{Binding ElementName=rdoAuto, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}">
                    <Grid Background="#FF424242" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <dxga:DigitalGaugeControl Text="{Binding LiveWeight}" Margin="0,10" VerticalAlignment="Center" HorizontalAlignment="Right" >
                            <dxga:DigitalGaugeControl.SymbolView>
                                <dxga:SevenSegmentsView>
                                    <dxga:SevenSegmentsView.Presentation>
                                        <dxga:DefaultSevenSegmentsPresentation FillActive="#FF43E64A" FillInactive="#0F555555" />
                                    </dxga:SevenSegmentsView.Presentation>
                                </dxga:SevenSegmentsView>
                            </dxga:DigitalGaugeControl.SymbolView>
                        </dxga:DigitalGaugeControl>
                        <TextBlock Text="Kg" Grid.Column="1" FontSize="50" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                    </Grid>

                </Grid>
                <Grid Background="#FF424242" Margin="20" d:IsHidden="True" Visibility="{Binding ElementName=rdoManual, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border>
                        <controls:TransactionContentControl x:Name="ManualWeight"  Style="{DynamicResource TransactionComboBoxContentPopupStyleNew}" Text="{Binding ManualWeight, FallbackValue=1235}" TextBlockHorizontalAlignment="Right" Background="White" Height="200" Margin="20,0,0,0" TextDataFontSize="120"/>

                    </Border>
                    <!--                    <TextBox Margin="20" Text="{Binding ManualWeight, UpdateSourceTrigger=PropertyChanged}"  VerticalContentAlignment="Center" FontSize="48" TextAlignment="Right"/>-->
                    <TextBlock Text="Kg" Grid.Column="1" FontSize="50" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                </Grid>
                <Border Grid.Row="3" BorderBrush="{DynamicResource ItemBorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource LightGreyBrush}">
                    <Grid>
                        <Button Command="{Binding SaveCommand}" Content="Capture Weight" FontSize="56" Margin="30" Background="White" Style="{StaticResource PrimaryButtonStyleAction}" BorderThickness="2" Foreground="{DynamicResource MainNavyBrush}" Height="200"/>


                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Border Style="{DynamicResource TransactionBorderFooterStyle}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!--<Button Command="{Binding SaveCommand}" Width="140" Content="Save" HorizontalAlignment="Left" Margin="0,0,40,0" Style="{DynamicResource TransactionButtonStyle}"/>-->
                        <Button Command="{Binding CancelCommand}" Width="140" Content="Cancel" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyleCancel}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</shared:WindowBase>
