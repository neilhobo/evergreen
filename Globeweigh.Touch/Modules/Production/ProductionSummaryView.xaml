<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	         xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
	         xmlns:internal="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/internal"
	         xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
	         xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:userControls="clr-namespace:Globeweigh.Touch.UserControls"
             md:DialogServiceViews.IsRegistered="True" 
	         x:Class="Globeweigh.Touch.ProductionSummaryView"
             mc:Ignorable="d"
             d:DesignHeight="1024" d:DesignWidth="1280"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding ProductionSummaryView, Source={StaticResource Locator}}" Background="White"
             >
    <UserControl.Resources>



            <Style x:Key="rowStyle" TargetType="{x:Type dxg:RowControl}">
                <Setter Property="Height" Value="40"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            

            <Style TargetType="{x:Type dxg:GridColumnHeader}">
                <Setter Property="Height" Value="40"></Setter>
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontSize" Value="16" />
            </Style>


    
    </UserControl.Resources>
    <Border  Margin="15" Background="White">
        <Grid Background="{DynamicResource GlobeweighBlueBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid   Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <!-- <Button Width="60" Height="60" Style="{DynamicResource BackButtonStyle}" Margin="6,0,0,0" Command="{Binding HomeCommand}"/> -->
                    <internal:BackButton Margin="2,2,10,2" VerticalAlignment="Center" Command="{Binding HomeCommand}" StrokeThickness="4" Width="66" Height="66"  />
                    <TextBlock Text="Production" Margin="10,0,0,0" Style="{DynamicResource HeaderTextBlockStyle}" Foreground="White"/>
                </StackPanel>
                <userControls:LoggedInUserControl Grid.Column="2" HorizontalAlignment="Right"/>
                <userControls:DateFilter Grid.Column="1" FilterDate="{Binding FilterDate}" FilterDateBackCommand="{Binding FilterDateBackCommand}" FilterDateForwardCommand="{Binding FilterDateForwardCommand}"  HorizontalAlignment="Right" FontSize="30" Width="400" Foreground="White" />
            </Grid>

                <Grid Background="{DynamicResource MainContentGrey}" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0"/>
                        </Grid.ColumnDefinitions>
                    <dxg:GridControl x:Name="grdSummary" ItemsSource="{Binding ProductList}" SelectedItem="{Binding SelectedProduct}" ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" >
                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True" AllowFilterEditor="False" ShowVerticalLines="True" ShowHorizontalLines="True" ShowGroupPanel="False" Margin="4"
                                            AllowSorting="False" ShowIndicator="False"  AutoWidth="True"  NavigationStyle="Row"  RowStyle="{DynamicResource rowStyle}" VerticalScrollbarVisibility="Auto" ShowFilterPanelMode="Never"/>
                            </dxg:GridControl.View>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Gtin" Width="120" FixedWidth="True" Header="Evergreen Code" />
                            <dxg:GridColumn FieldName="Description"  Header="Product" />
                            <dxg:GridColumn FieldName="Size" Width="60" FixedWidth="True" />
                            <dxg:GridColumn FieldName="Upp" Width="60" FixedWidth="True" Header="UPP" />
                            <dxg:GridColumn FieldName="RecordCount" Header="No. Of Pallets" Width="90" FixedWidth="True"/>
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem SummaryType="Count" Alignment="Right" />
                        </dxg:GridControl.TotalSummary>
                    </dxg:GridControl>
                        <!--<dxg:GridControl x:Name="grdPallets" ItemsSource="{Binding PalletList}" SelectedItem="{Binding SelectedPallet}" ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                    Loaded="GrdPallets_OnLoaded" Grid.Column="1" >
                            <dxg:GridControl.View>
                                <dxg:TableView AllowPerPixelScrolling="True" AllowFilterEditor="False" ShowVerticalLines="True" ShowHorizontalLines="True" ShowGroupPanel="False" Margin="4"
                                            AllowSorting="False" ShowIndicator="False"  AutoWidth="True"  NavigationStyle="Row"  RowStyle="{DynamicResource rowStyle}" VerticalScrollbarVisibility="Auto" ShowFilterPanelMode="Never"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="PalletNo" FixedWidth="True" Width="100">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        <dxg:GridColumn FieldName="LocationName" Header="Location" >
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl>-->
                    </Grid>
                    <Border  Grid.Column="1" BorderBrush="{DynamicResource DividerLineGrayBrush}" BorderThickness="2,0,0,0" Background="{DynamicResource MainContentGrey}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <!--<Button Command="{Binding PrintLabelCommand}" Style="{DynamicResource PrimaryButtonStyleAction}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdPallets}"  Content="RE-PRINT LABEL"  Width="200"  Margin="0,30,0,0" HorizontalAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" Height="60" HorizontalContentAlignment="Center" Grid.Column="1"/>-->
                            </StackPanel>
                            <!--<Grid Grid.Row="2" Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="163*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource ItemBorderBrush}" BorderThickness="2" >
                                    <TextBlock Text="Pallet Count" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="22" Foreground="{DynamicResource MainNavyBrush}" FontFamily="Segoe UI Semibold" Grid.Row="4"/>
                                </Border>
                                <Border BorderBrush="{DynamicResource ItemBorderBrush}" BorderThickness="2,0,2,2" Grid.Row="1" Background="White">
                                    <TextBlock Text="{Binding PalletCount}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="80" Foreground="{DynamicResource MainNavyBrush}" FontFamily="Segoe UI Semibold" Grid.Row="4"/>
                                </Border>
                            </Grid>-->
                        </Grid>
                    </Border>
                </Grid>
     

        </Grid>
    </Border>
</UserControl>

