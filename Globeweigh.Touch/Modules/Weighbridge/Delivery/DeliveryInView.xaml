<UserControl
    x:Class="Globeweigh.Touch.DeliveryInView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    xmlns:local="clr-namespace:Globeweigh.Touch"
    xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
    xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
    xmlns:internal="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/internal"
    mc:Ignorable="d"
    d:DesignHeight="1080"
    d:DesignWidth="1280"
    md:DialogServiceViews.IsRegistered="True"
    shared:ViewModelBehavior.LoadUnload="True"
    DataContext="{Binding DeliveryInView, Source={StaticResource Locator}}"
    Background="{DynamicResource MainNavyBrush}"
    Stylus.IsPressAndHoldEnabled="False"
    Stylus.IsFlicksEnabled="False">

    <UserControl.Resources>

        <!-- Converters -->
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>

        <!-- Base style for all touch-friendly lists -->
        <Style x:Key="BaseListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly"/>
            <!--<Setter Property="ScrollViewer.CanContentScroll" Value="False"/>-->
            <Setter Property="ScrollViewer.PanningDeceleration" Value="0.001"/>
            <Setter Property="ScrollViewer.PanningRatio" Value="1"/>
            <!--<Setter Property="SelectionMode" Value="Single"/>-->
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        
        <!-- Base style (row colours are theme hooks: white/black normally, dark keys
             with white text in Dark mode — like the on-screen keyboard) -->
        <Style x:Key="BaseItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource WbListItemBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource WbListItemTextBrush}"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Outline only appears in sunlight mode (rows are white-on-white there) -->
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource WbPanelBorderBrush}" BorderThickness="{DynamicResource WbListItemBorderThickness}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="{DynamicResource GlobeweighBlueBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Haulier/Supplier -->
        <Style x:Key="NameItemContainerStyleBase"
       TargetType="ListBoxItem"
       BasedOn="{StaticResource BaseItemContainerStyle}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           Margin="10,0"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Product -->
        <Style x:Key="ProductItemContainerStyleBase"
       TargetType="ListBoxItem"
       BasedOn="{StaticResource BaseItemContainerStyle}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Description}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           Margin="10,0"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>

    <Border Background="{DynamicResource MainContentGrey}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="{DynamicResource GlobeweighBlueBrush}">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                        <internal:BackButton Margin="0,0,10,0"
                                             VerticalAlignment="Center"
                                             Command="{Binding BackCommand}"
                                             StrokeThickness="4"
                                             Width="66"
                                             Height="66"/>

                    </StackPanel>
                    <!-- Theme switches (mutually exclusive via ThemeManager; persist per machine) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Sunlight" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox IsChecked="{Binding IsSunlight, Source={x:Static local:ThemeManager.Instance}, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,30,0"/>
                        <TextBlock Text="Dark Mode" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <CheckBox IsChecked="{Binding IsDark, Source={x:Static local:ThemeManager.Instance}, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="6,10,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Haulier -->
                <Border Margin="0" BorderThickness="4" BorderBrush="{DynamicResource WbPanelBorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,0,0,4" BorderBrush="{DynamicResource WbPanelBorderBrush}">
                            <TextBlock Text="Haulier"
                                       Style="{DynamicResource GroupHeaderTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       FontSize="26"/>
                        </Border>
                        <Grid Margin="10" Grid.Row="1">
                            <ListBox  ItemsSource="{Binding HaulierList}" SelectedItem="{Binding SelectedHaulier}" Style="{StaticResource BaseListBoxStyle}"
                                      Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Grid.Row="1" 
                                     ItemContainerStyle="{DynamicResource NameItemContainerStyleBase}" Margin="0,2,0,6" >
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Product -->
                <Border Margin="0" BorderThickness="0,4,4,4" BorderBrush="{DynamicResource WbPanelBorderBrush}" Grid.Column="1"
                        Visibility="{Binding SelectedHaulier, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,0,0,4" BorderBrush="{DynamicResource WbPanelBorderBrush}">
                            <TextBlock Text="Product"
                                       Style="{DynamicResource GroupHeaderTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       FontSize="26"/>
                        </Border>
                        <Grid Margin="10" Grid.Row="1">
                            <ListBox  ItemsSource="{Binding ProductList}" SelectedItem="{Binding SelectedProduct}" Style="{StaticResource BaseListBoxStyle}"
                                      Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Grid.Row="1" 
                                     ItemContainerStyle="{DynamicResource ProductItemContainerStyleBase}" Margin="0,2,0,6" >
                                <!--<ListBoxItem x:Name="production" Content="Production" IsSelected="True"  />
                                <ListBoxItem x:Name="productionSummary" Content="Production Summary" Margin="0,0,0,0"  />-->
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Supplier -->
                <Border Margin="0" BorderThickness="0,4,4,4" BorderBrush="{DynamicResource WbPanelBorderBrush}" Grid.Column="2"
                        Visibility="{Binding SelectedProduct, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,0,0,4" BorderBrush="{DynamicResource WbPanelBorderBrush}">
                            <TextBlock Text="Supplier"
                                       Style="{DynamicResource GroupHeaderTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       FontSize="26"/>
                        </Border>
                        <Grid Margin="10" Grid.Row="1">
     
                            <ListBox  ItemsSource="{Binding ProductSupplierList}" SelectedItem="{Binding SelectedProductSupplier}" Style="{StaticResource BaseListBoxStyle}"
                                      Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Grid.Row="1" 
                                     ItemContainerStyle="{DynamicResource NameItemContainerStyleBase}" Margin="0,2,0,6" >
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Bog List -->
                <Border Margin="0" BorderThickness="0,4,4,4" BorderBrush="{DynamicResource WbPanelBorderBrush}" Grid.Column="3"
                        Visibility="{Binding SelectedProductSupplier, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,0,0,4" BorderBrush="{DynamicResource WbPanelBorderBrush}">
                            <TextBlock Text="Bog List"
                                       Style="{DynamicResource GroupHeaderTextBlockStyle}"
                                       Margin="10,0,0,0"
                                       FontSize="26"/>
                        </Border>
                        <Grid Margin="10" Grid.Row="1">
                            <!--<ListBox x:Name="lstBogs"
                                     Style="{StaticResource TouchListBox}"
                                     ItemContainerStyle="{StaticResource TouchListBoxItem}"
                                     ItemsSource="{Binding BogList}"
                                     SelectedItem="{Binding SelectedBog}"
                                     ItemTemplate="{StaticResource BogTemplate}"/>-->
                            <ListBox  ItemsSource="{Binding BogList}" SelectedItem="{Binding SelectedBog}" Style="{StaticResource BaseListBoxStyle}"
                                      Background="{x:Null}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Grid.Row="1" 
                                     ItemContainerStyle="{DynamicResource NameItemContainerStyleBase}" Margin="0,2,0,6" >
                                <!--<ListBoxItem x:Name="production" Content="Production" IsSelected="True"  />
                                <ListBoxItem x:Name="productionSummary" Content="Production Summary" Margin="0,0,0,0"  />-->
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button Command="{Binding NextCommand}"
                        Style="{DynamicResource PrimaryButtonStyleAction}"
                        Content="Next"
                        Width="250"
                        Height="80"
                        Margin="0"
                        FontSize="30"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
