<UserControl
    x:Class="Globeweigh.Touch.WeighbridgeWeighView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared" 
    xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges" 
    xmlns:internal="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/internal" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    xmlns:local="clr-namespace:Globeweigh.Touch"
    xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared" d:DesignHeight="1024" d:DesignWidth="1280" md:DialogServiceViews.IsRegistered="True" shared:ViewModelBehavior.LoadUnload="True"
    Background="{DynamicResource MainNavyBrush}"
    DataContext="{Binding WeighbridgeWeighView, Source={StaticResource Locator}}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter" />
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <converters:NullToVisibleConverter x:Key="NullToVisibleConverter" />
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter" />
        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter" />

    </UserControl.Resources>
    <Grid>
        <Border Background="{DynamicResource LightGreyBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource GlobeweighBlueBrush}">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0" VerticalAlignment="Center" Orientation="Horizontal">
                            <internal:BackButton Width="66" Height="66" Margin="0,0,10,0" VerticalAlignment="Center" Command="{Binding BackCommand}" StrokeThickness="4" />
                            <TextBlock Margin="10,0,0,0" Foreground="White" Style="{DynamicResource HeaderTextBlockStyle}" Text="{Binding CurrentBatch.BatchNo, StringFormat='Batch No: {0}'}" />
                        </StackPanel>
                        <!--<userControls:LoggedInUserControl Grid.Column="1"/>-->
                    </Grid>
                </Border>


                <Border Grid.Row="1" BorderBrush="{DynamicResource WbPanelBorderBrush}" BorderThickness="4">
                    <Grid>
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="550" />
                            </Grid.ColumnDefinitions>

                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="50" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="20" />
                                    <RowDefinition Height="100" />
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="28" Style="{DynamicResource DefaultTextBlockStyle}" Text="Haulier" />
                                <TextBlock Grid.Column="1" FontSize="28" Style="{DynamicResource DefaultTextBlockContentStyle}" Text="{Binding CurrentWeighbridgeRecord.HaulierName}" />
                                <TextBlock Grid.Row="1" FontSize="28" Style="{DynamicResource DefaultTextBlockStyle}" Text="Product" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="28" Style="{DynamicResource DefaultTextBlockContentStyle}" Text="{Binding CurrentWeighbridgeRecord.Product}" />
                                <TextBlock Grid.Row="2" Margin="0,10" FontSize="28" Style="{DynamicResource DefaultTextBlockStyle}" Text="Supplier" Visibility="{Binding CurrentWeighbridgeRecord.Supplier, Converter={StaticResource NullToCollapsedConverter}}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="28" Style="{DynamicResource DefaultTextBlockContentStyle}" Text="{Binding CurrentWeighbridgeRecord.Supplier}" Visibility="{Binding CurrentWeighbridgeRecord.Supplier, Converter={StaticResource NullToCollapsedConverter}}" />
                                <TextBlock Grid.Row="3" Margin="0,10" FontSize="28" Style="{DynamicResource DefaultTextBlockStyle}" Text="Bog" Visibility="{Binding CurrentWeighbridgeRecord.BogName, Converter={StaticResource NullToCollapsedConverter}}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="28" Style="{DynamicResource DefaultTextBlockContentStyle}" Text="{Binding CurrentWeighbridgeRecord.BogName}" Visibility="{Binding CurrentWeighbridgeRecord.BogName, Converter={StaticResource NullToCollapsedConverter}}" />
                                <TextBlock Grid.Row="4" Margin="0" FontSize="34" FontWeight="Bold" Style="{DynamicResource DefaultTextBlockStyle}" Text="Vehicle Reg:" />
                                <controls:TransactionContentControl
                                    x:Name="VehicleReg" Grid.Row="4" Grid.Column="1" Width="300" Height="100" Margin="0" HorizontalAlignment="Left" FontSize="34" FontWeight="Bold"
                                    Style="{DynamicResource TextBlockPopupContentStyle}"
                                    Text="{Binding CurrentWeighbridgeRecord.VehicleReg, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding IsOut, Converter={StaticResource TrueToCollapsedConverter}}" />

                                <!--<TextBlock Text="Vehicle Reg"  Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="5" Margin="0,10" Visibility="{Binding SelectedPending, Converter={StaticResource NullToCollapsedConverter}}" FontSize="28"/>-->
                                <TextBlock Grid.Row="4" Grid.Column="1" FontSize="34" FontWeight="Bold" Style="{DynamicResource DefaultTextBlockContentStyle}" Text="{Binding CurrentWeighbridgeRecord.VehicleReg}" Visibility="{Binding IsOut, Converter={StaticResource TrueToVisibilityConverter}}" />
                                <Border Grid.Row="6" Grid.ColumnSpan="2" Background="Red" Visibility="{Binding IsOut, Converter={StaticResource TrueToCollapsedConverter}}">
                                    <TextBlock Margin="0" HorizontalAlignment="Center" FontSize="44" FontWeight="Bold" Foreground="White" Style="{DynamicResource DefaultTextBlockStyle}" Text="DO YOU HAVE A DOCKET NO?" />
                                </Border>
                                <Grid x:Name="YesNoSwitch" Grid.Row="7" Grid.ColumnSpan="2" Visibility="{Binding IsOut, Converter={StaticResource TrueToCollapsedConverter}}">
                                    <Grid.Resources>
                                        <converters:BoolEqualsConverter x:Key="BoolEqualsConverter" />

                                        <!--  Make RadioButtons look like Buttons  -->
                                        <Style x:Key="RadioAsButton" TargetType="RadioButton">
                                            <Setter Property="Padding" Value="10,8" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="BorderBrush" Value="#CCC" />
                                            <Setter Property="Background" Value="#F6F6F6" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="RadioButton">
                                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WbYesNoCheckedBrush}" />
                                                                <!--  primary  -->
                                                                <Setter Property="Foreground" Value="White" />
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource WbYesNoCheckedBorderBrush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#999" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.5" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Grid.Resources>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  YES  -->
                                    <RadioButton x:Name="chkYes" Grid.Column="0" Margin="0,10,10,10" BorderBrush="Black" BorderThickness="4" Content="YES" FontSize="60" GroupName="YesNo" IsChecked="{Binding IsDocketSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=True, FallbackValue=True}" Style="{StaticResource RadioAsButton}" />

                                    <!--  NO  -->
                                    <RadioButton Grid.Column="1" Margin="10,10,0,10" BorderBrush="Black" BorderThickness="4" Content="NO" FontSize="60" GroupName="YesNo" IsChecked="{Binding IsDocketSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource BoolEqualsConverter}, ConverterParameter=False}" Style="{StaticResource RadioAsButton}" />

                                </Grid>


                                <TextBlock Grid.Row="8" Margin="0" FontSize="34" FontWeight="Bold" Style="{DynamicResource DefaultTextBlockStyle}" Text="Docket No:" Visibility="{Binding ElementName=chkYes, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}" />
                                <controls:TransactionContentControl
                                    x:Name="DocketNumber" Grid.Row="8" Grid.Column="1" Width="300" Height="100" Margin="10" HorizontalAlignment="Left" FontSize="34" FontWeight="Bold"
                                    Style="{DynamicResource TextBlockPopupContentStyle}"
                                    Text="{Binding CurrentWeighbridgeRecord.DocketNumber, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding ElementName=chkYes, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}" />
                            </Grid>
                            <Border Grid.Column="2" Margin="0,0,5,0">
                                <Grid Margin="20,20,0,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border BorderBrush="{DynamicResource WbPanelBorderBrush}" BorderThickness="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="80" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border BorderBrush="{DynamicResource WbPanelBorderBrush}" BorderThickness="0,0,0,4">

                                                <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="40" Style="{DynamicResource DefaultTextBlockStyle}" Text="Weight" />

                                            </Border>

                                            <!-- Live weight. In sunlight mode: black digits on white — a dark glossy
                                                 panel mirrors outdoors. Two gauges carry the two segment palettes since
                                                 the DX presentation fill isn't themeable. -->
                                            <Border Grid.RowSpan="2" Grid.Column="3" Margin="10,0.1,10,10" Background="{DynamicResource WbGaugePanelBrush}" BorderBrush="{DynamicResource WbGaugePanelBorderBrush}" BorderThickness="3" CornerRadius="3">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <dxga:DigitalGaugeControl Margin="6,10,0,10" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding LiveWeight}"
                                                                              Visibility="{Binding IsSunlight, Source={x:Static local:ThemeManager.Instance}, Converter={StaticResource TrueToCollapsedConverter}}">
                                                        <dxga:SevenSegmentsView>
                                                            <dxga:SevenSegmentsView.Presentation>
                                                                <dxga:DefaultSevenSegmentsPresentation FillActive="#FF43E64A" FillInactive="#0F555555" />
                                                            </dxga:SevenSegmentsView.Presentation>
                                                        </dxga:SevenSegmentsView>
                                                    </dxga:DigitalGaugeControl>
                                                    <dxga:DigitalGaugeControl Margin="6,10,0,10" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding LiveWeight}"
                                                                              Visibility="{Binding IsSunlight, Source={x:Static local:ThemeManager.Instance}, Converter={StaticResource TrueToVisibilityConverter}}">
                                                        <dxga:SevenSegmentsView>
                                                            <dxga:SevenSegmentsView.Presentation>
                                                                <dxga:DefaultSevenSegmentsPresentation FillActive="#FF111111" FillInactive="#10000000" />
                                                            </dxga:SevenSegmentsView.Presentation>
                                                        </dxga:SevenSegmentsView>
                                                    </dxga:DigitalGaugeControl>
                                                    <TextBlock Grid.Column="1" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="50" Foreground="{DynamicResource WbGaugeTextBrush}" Text="Kg" />
                                                </Grid>

                                            </Border>

                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource WbPanelBorderBrush}" BorderThickness="4,0,4,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="60" />
                                                <RowDefinition Height="60" />
                                                <RowDefinition Height="40" />
                                            </Grid.RowDefinitions>
                                            <Button Width="400" Height="160" Margin="0" BorderThickness="4" Command="{Binding SaveCommand}" Content="Weigh" FontSize="60" IsEnabled="{Binding IsBusy, Converter={StaticResource TrueToFalseConverter}}">
                                                <Button.Style>
                                                    <Style BasedOn="{StaticResource PrimaryButtonStyleAction}" TargetType="{x:Type Button}">
                                                        <Setter Property="Content" Value="Weigh" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentWeighbridgeRecord.IsOutgoing}" Value="True">
                                                                <Setter Property="Content" Value="Weigh" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Grid.Row="1" Margin="0" HorizontalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="Red" Style="{DynamicResource DefaultTextBlockStyle}" Text="Vehicle Reg Required" Visibility="{Binding CurrentWeighbridgeRecord.VehicleReg, Converter={StaticResource NullToVisibleConverter}}" />
                                            <TextBlock Grid.Row="2" Margin="0" HorizontalAlignment="Center" FontSize="34" FontWeight="Bold" Foreground="Red" Text="Docket No Required">
                                                <TextBlock.Style>
                                                    <!--  Keep your default style if you have one  -->
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <!--  1) DocketNumber is null  -->
                                                                    <Condition Binding="{Binding CurrentWeighbridgeRecord.DocketNumber}" Value="{x:Null}" />
                                                                    <!--  2) YES button (named chkYes) is checked  -->
                                                                    <Condition Binding="{Binding ElementName=chkYes, Path=IsChecked}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="0,0,10,0" HorizontalAlignment="Right" Orientation="Horizontal" />
            </Grid>
        </Border>
        <Border d:IsHidden="True" Background="#FFCDFFB3" BorderBrush="White" BorderThickness="4" Visibility="{Binding SuccessOverlayVisible, Converter={StaticResource TrueToVisibilityConverter}}">
            <Grid Margin="20,0,20,100" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100" Text="Weigh successful!" />
                <TextBlock Grid.Row="1" Margin="0,100,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Text="Please exit the weighbridge when ready" TextAlignment="Center" TextWrapping="Wrap" />
                <!--<TextBlock Text="{Binding CountdownValue}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="300" Grid.Row="1" Margin="0,10,0,0"/>-->
            </Grid>
        </Border>
        <Border d:IsHidden="True" Background="#FFCDFFB3" BorderBrush="White" BorderThickness="4" Visibility="{Binding InCountdownMode, Converter={StaticResource TrueToVisibilityConverter}}">
            <Grid Margin="20,0,20,100" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100" Text="Weigh successful!" />
                <TextBlock Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="250" Text="{Binding CountdownValue, FallbackValue=5}" />
            </Grid>
        </Border>

    </Grid>

</UserControl>
