<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	         xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:local="clr-namespace:Globeweigh.Touch"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
	         md:DialogServiceViews.IsRegistered="True"
	         x:Class="Globeweigh.Touch.WeighbridgeInView"
             mc:Ignorable="d" 
             d:DesignHeight="1024" d:DesignWidth="1280" 
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding WeighbridgeInView, Source={StaticResource Locator}}" Background="{DynamicResource MainNavyBrush}">
    <UserControl.Resources>


        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>

        <Style x:Key="OpenCloseBarrierButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryButtonStyleAction}">
            <Setter Property="Content" Value="Open Barrier"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BarrierOpen}" Value="True">
                    <Setter Property="Content" Value="Close Barrier"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    <Border   Background="{DynamicResource LightGreyBrush}">
        <Grid  >
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid >
                <Grid   Margin="5" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>
                    <Grid Background="{DynamicResource GlobeweighBlueBrush}" Grid.ColumnSpan="3">
                        <!-- Theme switches: Sunlight (white, black text) or Dark Mode (dark, white
                             text). Mutually exclusive; persist per machine via ThemeManager. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Sunlight" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox IsChecked="{Binding IsSunlight, Source={x:Static local:ThemeManager.Instance}, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,30,0"/>
                            <TextBlock Text="Dark Mode" Foreground="White" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <CheckBox IsChecked="{Binding IsDark, Source={x:Static local:ThemeManager.Instance}, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Image Source="/Images/Globe-96.png"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Globeweigh Factory " Foreground="White" FontSize="24" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CurrentVersion, FallbackValue=v1.0.0}" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="24" />
                        </StackPanel>
                    </Grid>
                    <!-- Live weight. In sunlight mode the panel flips to black digits on white
                         (a dark glossy panel mirrors outdoors); the two gauges below carry the
                         two segment palettes since the DX presentation fill isn't themeable. -->
                    <Border Margin="10,0.1,10,10" Background="{DynamicResource WbGaugePanelBrush}" BorderBrush="{DynamicResource WbGaugePanelBorderBrush}" BorderThickness="3" CornerRadius="3" Grid.Column="3" Grid.RowSpan="2">

                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <dxga:DigitalGaugeControl Text="{Binding LiveWeight}" Margin="6,10,0,10" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                      Visibility="{Binding IsSunlight, Source={x:Static local:ThemeManager.Instance}, Converter={StaticResource TrueToCollapsedConverter}}">
                                <dxga:SevenSegmentsView>
                                    <dxga:SevenSegmentsView.Presentation>
                                        <dxga:DefaultSevenSegmentsPresentation FillActive="#FF43E64A" FillInactive="#0F555555" />
                                    </dxga:SevenSegmentsView.Presentation>
                                </dxga:SevenSegmentsView>
                            </dxga:DigitalGaugeControl>
                            <dxga:DigitalGaugeControl Text="{Binding LiveWeight}" Margin="6,10,0,10" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                      Visibility="{Binding IsSunlight, Source={x:Static local:ThemeManager.Instance}, Converter={StaticResource TrueToVisibilityConverter}}">
                                <dxga:SevenSegmentsView>
                                    <dxga:SevenSegmentsView.Presentation>
                                        <dxga:DefaultSevenSegmentsPresentation FillActive="#FF111111" FillInactive="#10000000" />
                                    </dxga:SevenSegmentsView.Presentation>
                                </dxga:SevenSegmentsView>
                            </dxga:DigitalGaugeControl>
                            <TextBlock Text="Kg" Grid.Column="1" FontSize="50" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource WbGaugeTextBrush}" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                        </Grid>

                    </Border>
                    <!--<userControls1:LoggedInUserControl Grid.Column="3"/>-->
                </Grid>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0"/>
                    <RowDefinition Height="454*"/>
                </Grid.RowDefinitions>
                <Grid Background="{DynamicResource WbHeroPanelBrush}">
                    <Grid Margin="30,10,50,10" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="2*"/>

                        </Grid.RowDefinitions>
                        <TextBlock Text="Evergreen Horticulture" Foreground="{DynamicResource WbHeroTextBrush}" FontSize="46" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Segoe UI Semibold"/>
                        <StackPanel Orientation="Vertical" Grid.Row="1" VerticalAlignment="Top">
                            <TextBlock Text="{Binding CurrentDate, FallbackValue=Tuesday 1st January, StringFormat=D}" Foreground="{DynamicResource WbHeroTextBrush}" FontSize="30" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Segoe UI Semilight" />
                            <TextBlock Text="{Binding CurrentDate, StringFormat=\{0:h:mm tt\}}" Foreground="{DynamicResource WbHeroTextBrush}" FontSize="30" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Segoe UI Semilight" />
                        </StackPanel>



                    </Grid>
                </Grid>

                <Grid Background="{DynamicResource MainContentGrey}" Grid.Row="1" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Grid  Width="600"  Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource OpenCloseBarrierButtonStyle}"
        Command="{Binding OpenBarrierCommand}"
        FontSize="60"
        Height="Auto"
        Margin="0,30,0,30"/>


                        <Grid Grid.Column="2" Margin="0,30" Visibility="{Binding IsMyMachine, Converter={StaticResource TrueToVisibilityConverter}}" Width="80">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Ellipse Fill="{DynamicResource WbBarrierOpenBrush}" Visibility="{Binding BarrierOpen, Converter={StaticResource TrueToVisibilityConverter}}" HorizontalAlignment="Center" Height="60" Margin="0" VerticalAlignment="Center" Width="60" Stroke="{DynamicResource WbBarrierStrokeBrush}" StrokeThickness="3" Grid.Row="1"/>
                            <Ellipse Fill="{DynamicResource WbBarrierClosedBrush}" Visibility="{Binding BarrierOpen, Converter={StaticResource TrueToCollapsedConverter}}" HorizontalAlignment="Center" Height="60" Margin="0" VerticalAlignment="Center" Width="60" Grid.Column="1" Stroke="{DynamicResource WbBarrierStrokeBrush}" StrokeThickness="3"/>
                        </Grid>
                    </Grid>

                    <Button Command="{Binding CollectionCommand}"  Content="Collection" Width="600" IsEnabled="True" Style="{DynamicResource PrimaryButtonStyleAction}" Height="Auto" Margin="0,30" FontSize="60" Grid.Row="2" />
                    <Button Command="{Binding DeliveryCommand}"  Content="Delivery" Width="600"  Style="{DynamicResource PrimaryButtonStyleAction}" Height="Auto" Margin="0,30" FontSize="60" Grid.Row="3"/>
                </Grid>


            </Grid>

        </Grid>
    </Border>
</UserControl>
