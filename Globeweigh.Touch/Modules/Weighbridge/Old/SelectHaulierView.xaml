<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        x:Class="Globeweigh.Touch.SelectHaulierView" WindowStyle="None" Margin="50"
        AllowsTransparency="True" mc:Ignorable="d"  ResizeMode="NoResize"   dx:ThemeManager.ThemeName="MetropolisLight"
        d:DesignWidth="1280" d:DesignHeight="1024" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered ="True" Background="{DynamicResource MainNavyBrush}" IsOwnerSize="True" >

    <shared:WindowBase.Resources>


        <Style x:Key="rowStyle" TargetType="{x:Type dxg:RowControl}">
            <Setter Property="Height" Value="40"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource GlobeweighLightBlueBrush}" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>







    </shared:WindowBase.Resources>
    <Border Background="{DynamicResource LightGreyBrush}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="123*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{DynamicResource TransactionBorderHeaderStyle}">
                <TextBlock Text="Select Haulier" VerticalAlignment="Center" FontSize="32" Margin="14,0,20,0" Foreground="{DynamicResource GlobeweighBlueBrush}" FontFamily="Segoe UI Semibold"/>
            </Border>
            <Grid Grid.Row="1" Margin="10">

                <dxg:GridControl x:Name="grdProducts" ItemsSource="{Binding HaulierList}"  SelectedItem="{Binding SelectedHaulier}" Loaded="GrdProducts_OnLoaded" FontSize="16" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,6,0">
                    <dxg:GridControl.View>
                        <dxg:TableView AllowPerPixelScrolling="True" ShowGroupPanel="False" ShowColumnHeaders="False" FadeSelectionOnLostFocus="False" ShowIndicator="False" RowStyle="{DynamicResource rowStyle}" AutoWidth="True"  NavigationStyle="Row"  VerticalScrollbarVisibility="Auto" FontFamily="Segoe UI Semibold"/>
                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="Name" Header="Haulier Name"/>
                </dxg:GridControl>

            </Grid>
            <Grid Grid.Row="3">
                <Border Style="{DynamicResource TransactionBorderFooterStyle}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding SelectCommand}" IsEnabled="{Binding ElementName=list, Path=SelectedItems.Count}" Width="140" Content="Select" HorizontalAlignment="Left" Margin="0,0,40,0" Style="{DynamicResource PrimaryButtonStyleAction}"/>
                        <Button Command="{Binding CancelCommand}" Width="140" Content="Cancel" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyleCancel}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</shared:WindowBase>



