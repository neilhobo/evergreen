<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	         xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:userControls="clr-namespace:Globeweigh.Touch.UserControls"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
	         xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
	         xmlns:internal="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/internal"
	         md:DialogServiceViews.IsRegistered="True" 
	         x:Class="Globeweigh.Touch.WeighbridgeListView"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1280" 
             shared:ViewModelBehavior.LoadUnload="True" 
             DataContext="{Binding WeighbridgeListView, Source={StaticResource Locator}}" Background="#FFEBEBED">
    <UserControl.Resources>
        <ResourceDictionary>

            <converters:PercentageConverter x:Key="PercentageConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
            <converters:NullToVisibleConverter x:Key="NullToVisibilityConverter"/>

            <Style x:Key="clearBackgroundCellStyle" TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                <Style.Triggers>
                    <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                        <Setter Property="Background" Value="White" />
                        <!--<Setter Property="Foreground" Value="Black" />-->
                    </Trigger>
                </Style.Triggers>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>
    <Border  Margin="15" Background="White">
        <Grid Background="{DynamicResource GlobeweighBlueBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid   Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <!-- <Button Width="60" Height="60" Style="{DynamicResource BackButtonStyle}" Margin="6,0,0,0" Command="{Binding HomeCommand}"/> -->
                    <internal:BackButton Margin="2,2,10,2" VerticalAlignment="Center" Command="{Binding HomeCommand}" StrokeThickness="4" Width="66" Height="66"  />
                    <TextBlock Text="Weighbridge Records" Margin="10,0,0,0" Style="{DynamicResource HeaderTextBlockStyle}" Foreground="White"/>
                </StackPanel>
                <userControls:LoggedInUserControl Grid.Column="2" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Grid.Row="1" Background="{DynamicResource MainContentGrey}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="4*"/>
                </Grid.RowDefinitions>
                <Border  >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,1" BorderBrush="{DynamicResource DividerLineGrayBrush}">
                            <TextBlock Text="Pending (Incoming / Outgoing)" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" />
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <dxg:GridControl x:Name="grdPending"  ShowLoadingPanel="{Binding IsPendingBusy}" Loaded="Grd_OnLoaded" ItemsSource="{Binding PendingList}" SelectedItem="{Binding SelectedPending}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="5">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tvPending" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="WeighType" Header=" " FixedWidth="True" Width="80" CellStyle="{DynamicResource clearBackgroundCellStyle }">
                                    <dxg:GridColumn.DisplayTemplate>
                                        <ControlTemplate>
                                            <TextBlock Margin="4,0,0,0" x:Name="PART_Editor">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                        <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RowData.Row.IsOutgoing}" Value="True">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </ControlTemplate>
                                    </dxg:GridColumn.DisplayTemplate>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="HaulierName" Header="Haulier" />
                                <dxg:GridColumn FieldName="VehicleReg" Header="Vehicle Reg"/>
                                <dxg:GridColumn FieldName="PendingWeighDate" Width="180" Header="Weigh Date" FixedWidth="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="PendingWeight" Header="Weight (Kg)" FixedWidth="True" Width="120">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="SampleBoxWeight" Header="Sample Box Weight (Kg)" FixedWidth="True" Width="160" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>

                            </dxg:GridControl>
                            <Border  Grid.Column="1" BorderBrush="{DynamicResource DividerLineGrayBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource MainContentGrey}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Button Command="{Binding AddIncomingCommand}" Style="{DynamicResource PrimaryButtonStyleAction}" Content="Add Incoming" Width="180" Height="60"  Margin="0"/>
                                    <Button Command="{Binding AddOutgoingCommand}" Style="{DynamicResource PrimaryButtonStyleAction}" Content="Add Outgoing" Width="180" Height="60"  Margin="0" Grid.Row="1"/>
                                    <Border Grid.Row="2" VerticalAlignment="Center" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerLineGrayBrush}" Margin="10,0"/>
                                    <!--<Button Command="{Binding EditPendingCommand}" Style="{DynamicResource PrimaryButtonStyleAction}" Content="Edit" Width="180" IsEnabled="{Binding ElementName=grdPending, Path=SelectedItems.Count}" Height="60" Margin="0,10,0,0" Grid.Row="3"/>
                                    <Button Command="{Binding DeletePendingCommand}" Style="{DynamicResource PrimaryButtonStyleAction}" Content="Delete" Width="180" IsEnabled="{Binding ElementName=grdPending, Path=SelectedItems.Count}" Height="60" Margin="0,0,0,10" Grid.Row="4"/>-->

                                    <Button Command="{Binding WeighInOutCommand}"  Width="180" IsEnabled="{Binding ElementName=grdPending, Path=SelectedItems.Count}" Height="60" Margin="0" Grid.Row="3" Visibility="{Binding SelectedPending, Converter={StaticResource NullToCollapsedConverter}}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyleBase}">
                                                <Setter Property="Content" Value="Weigh Out"/>
                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding SelectedPending.IsOutgoing}" Value="True">
                                                        <Setter Property="Content" Value="Weigh In"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                    </Button>
                                    <!--<Button Command="{Binding ViewDetailsPendingCommand}" Style="{DynamicResource PrimaryButtonStyleBase}" Content="Detail View" Width="180" IsEnabled="{Binding ElementName=grdPending, Path=SelectedItems.Count}" Visibility="{Binding SelectedPending, Converter={StaticResource NullToCollapsedConverter}}" Height="60" Margin="0" Grid.Row="4"/>-->



                                </Grid>


                            </Border>

                            <Grid Background="{DynamicResource MainContentGrey}" Visibility="{Binding PendingErrorFound, Converter={StaticResource TrueToVisibilityConverter}}" d:IsHidden="True" Grid.ColumnSpan="2">
                                <Border Margin="200,50" BorderBrush="White" BorderThickness="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Error fetching results"  HorizontalAlignment="Center" FontSize="36" VerticalAlignment="Center" FontFamily="Segoe UI Semilight" Foreground="#FF4B4B4B" />
                                        <Button Content="Retry" Command="{Binding RetryPendingRefreshCommand}" Grid.Row="1" Style="{DynamicResource PrimaryButtonStyleBase}" Width="200"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
                <Border Grid.Row="1" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="80"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,1" BorderBrush="{DynamicResource DividerLineGrayBrush}">
                            <TextBlock Text="Weighbridge Records" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" />

                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0"/>
                            </Grid.ColumnDefinitions>
                            <dxg:GridControl x:Name="grd"  Loaded="Grd_OnLoaded" ShowLoadingPanel="{Binding IsPendingBusy}" ItemsSource="{Binding WeighbridgeRecordList}" SelectedItem="{Binding SelectedWeighbridgeRecord}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="5">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tvGrid" />
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="HaulierName" Header="Haulier" />
                                <dxg:GridColumn FieldName="VehicleReg" Header="Vehicle Reg" FixedWidth="True" Width="100"/>
                                <dxg:GridColumn FieldName="DateWeightIn" Width="160" Header="Incoming Weigh Date">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="WeightIn" Header="Weight In (Kg)">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="DateWeightOut" Width="160" Header="Outgoing Weigh Date">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="WeightOut" Header="Weight Out (Kg)" FixedWidth="True" Width="110">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="NetWeight" Header="Net Weight (Kg)" FixedWidth="True" Width="110" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="SampleBoxWeight" Header="Sample Box Weight (Kg)" FixedWidth="True" Width="160" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="M3Volume" Header="m3 Volume" FixedWidth="True" Width="150" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" MaskType="Numeric" Mask="N2" MaskUseAsDisplayFormat="True"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>


                            </dxg:GridControl>

                            <Grid Background="{DynamicResource MainContentGrey}" Visibility="{Binding ErrorFound, Converter={StaticResource TrueToVisibilityConverter}}" d:IsHidden="True">
                                <Border Margin="200,50" BorderBrush="White" BorderThickness="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Error fetching results"  HorizontalAlignment="Center" FontSize="36" VerticalAlignment="Center" FontFamily="Segoe UI Semilight" Foreground="#FF4B4B4B" />
                                        <Button Content="Retry" Command="{Binding RetryWeighbridgeRefreshCommand}" Grid.Row="1" Style="{DynamicResource PrimaryButtonStyleBase}" Width="200"/>
                                    </Grid>
                                </Border>
                            </Grid>
                            <!--<Border  Grid.Column="1" BorderBrush="{DynamicResource DividerLineGrayBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource MainContentGrey}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Button Command="{Binding PrintDocketCommand}" Style="{DynamicResource PrimaryButtonStyleBase}" Content="Print Docket" Width="180" IsEnabled="{Binding ElementName=grd, Path=SelectedItems.Count}" Visibility="{Binding SelectedPending, Converter={StaticResource NullToCollapsedConverter}}" Height="60" Margin="0" Grid.Row="3"/>
                                   
                                    <Button Command="{Binding ViewDetailsCommand}" Style="{DynamicResource PrimaryButtonStyleBase}" Content="Detail View" Width="180" IsEnabled="{Binding ElementName=grd, Path=SelectedItems.Count}" Visibility="{Binding SelectedPending, Converter={StaticResource NullToCollapsedConverter}}" Height="60" Margin="0" Grid.Row="4"/>


                                </Grid>


                            </Border>-->
                        </Grid>
                        <Border Grid.Row="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,20,0" Grid.Column="1">
                                    <!--<Button Command="{Binding EditCommand}" Style="{DynamicResource PrimaryButtonStyleBase}" Content="Preview Docket" Width="180" IsEnabled="{Binding ElementName=grd, Path=SelectedItems.Count}"  Height="60" Margin="0,0,40,0" Grid.Row="4"/>-->
                                </StackPanel>
                            </Grid>

                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>

</UserControl>
