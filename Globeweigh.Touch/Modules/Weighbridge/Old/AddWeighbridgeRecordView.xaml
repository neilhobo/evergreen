<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
        xmlns:command="http://www.galasoft.ch/mvvmlight"
        xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:model="clr-namespace:Globeweigh.Model;assembly=Globeweigh.Model"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Touch.AddWeighbridgeRecordView" WindowStyle="None" Margin="0"
        AllowsTransparency="True" mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="1080" ResizeMode="NoResize"  
        md:DialogServiceViews.IsRegistered ="True" Background="{DynamicResource MainNavyBrush}" IsOwnerSize="True">

    <shared:WindowBase.Resources>

        <converters:FalseToVisibilityConverter x:Key="FalseToVisibilityConverter"/>
        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <!--<converters:OrderTypeEnumBooleanConverter x:Key="OrderTypeEnumBooleanConverter"/>-->

        <system:Boolean x:Key="True">True</system:Boolean>
        <system:Boolean x:Key="False">False</system:Boolean>

        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>

        <Style x:Key="RadioButtonCheckBox" TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Width="40" Height="40" HorizontalContentAlignment="Center" IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Mode=TwoWay}" VerticalContentAlignment="Center" BorderThickness="2"/>
                            <TextBlock Text="{TemplateBinding Content}" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Column="1" Margin="14,0,0,0" FontSize="22" FontFamily="Segoe UI Semibold"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



    </shared:WindowBase.Resources>
    <Border  Margin="10" CornerRadius="3" Background="{DynamicResource MainContentGrey}" >
        <Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource TransactionBorderHeaderStyle}" >
                    <TextBlock Text="Weigh In" VerticalAlignment="Center" FontSize="34" Margin="20,0" Foreground="{DynamicResource MainNavyBrush}"/>
                </Border>
                <Border Margin="10" Grid.Row="1" BorderBrush="White" BorderThickness="4" >
                    <Grid >
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="540"/>
                            </Grid.ColumnDefinitions>

                            <Grid Margin="20,10"  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="70"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Order Ref:"  Style="{DynamicResource DefaultTextBlockStyle}"/>
                                <TextBlock Text="{Binding CurrentWeighbridgeRecordView.IdRef}"  Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="1"/>
                                <TextBlock Text="Haulier:"  Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="1"/>
                                <TextBlock Text="{Binding CurrentWeighbridgeRecordView.HaulierName}"  Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Row="1" Grid.Column="1"/>
                                <!--<controls:TransactionContentControl x:Name="Haulier" ItemsSource="{Binding HaulierList}" EditValue="{Binding CurrentWeighbridgeRecord.HaulierId, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedHaulier}" DisplayMember="Name" ValueMember="id"  Style="{DynamicResource TransactionComboBoxContentPopupStyleNew}" Grid.Column="1" Margin="0" Grid.ColumnSpan="3" Height="70" Grid.Row="2"/>-->
                                <TextBlock Text="Vehicle Reg:"  Grid.Row="2" Margin="0" Style="{DynamicResource DefaultTextBlockStyle}" />
                                <controls:TransactionContentControl x:Name="VehicleReg"  Text="{Binding CurrentWeighbridgeRecord.VehicleReg, UpdateSourceTrigger=PropertyChanged}"  Style="{DynamicResource TextBlockPopupContentStyle}"  Grid.Column="1" Grid.Row="2" Margin="0" Height="70" HorizontalAlignment="Left" Width="200" />
                                <TextBlock Text="Trailer No:"  Grid.Row="3" Margin="0" Style="{DynamicResource DefaultTextBlockStyle}" />
                                <controls:TransactionContentControl x:Name="SampleBoxWeight"  Text="{Binding CurrentWeighbridgeRecord.TrailerNo, UpdateSourceTrigger=PropertyChanged}"  Style="{DynamicResource TextBlockPopupContentStyle}"  Grid.Column="1" Grid.Row="3" Margin="0" Height="70" HorizontalAlignment="Left" Width="200" />

                                <TextBlock Text="Comments:"  Grid.Row="5" Margin="0" Style="{DynamicResource DefaultTextBlockStyle}" />
                                <controls:TransactionContentControl x:Name="Comments"  Text="{Binding CurrentWeighbridgeRecord.Comments, UpdateSourceTrigger=PropertyChanged}" Padding="16,8,30,0" TextBlockVerticalAlignment="Top" VerticalContentAlignment="Top" Style="{DynamicResource TextBlockPopupContentStyle}"  Grid.Column="1" Grid.Row="5" Margin="0" Grid.RowSpan="2" />
                            </Grid>
                            <Border Margin="0,0,5,0" Grid.Column="2" >
                                <Grid Margin="20,20,0,20">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border BorderBrush="White" BorderThickness="4">
                                        <Grid >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="80"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Border BorderThickness="0,0,0,4" BorderBrush="White">

                                                <TextBlock Text="Weight"  Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="1" HorizontalAlignment="Center" FontSize="40" FontFamily="Segoe UI Semibold"/>

                                            </Border>

                                            <Grid Background="#FF424242" Margin="20"  Visibility="{Binding IsChecked, Converter={StaticResource TrueToVisibilityConverter}, ElementName=rdoManual}" Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border>
                                                    <controls:TransactionContentControl x:Name="ManualWeight"  Style="{DynamicResource TextBlockPopupContentStyle}" Text="{Binding ManualWeight}" TextBlockHorizontalAlignment="Right" Background="White" Margin="20,30,0,30" TextDataFontSize="120" FontSize="60"/>

                                                </Border>
                                                <TextBlock Text="Kg" Grid.Column="1" FontSize="50" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                                            </Grid>

                                        </Grid>
                                    </Border>
                                    <Border BorderThickness="4,0,4,4" BorderBrush="White" Grid.Column="1" Grid.Row="1">
                                        <Grid>
                                            <Button Command="{Binding SaveCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource TrueToFalseConverter}}"  Content="Weigh In" FontSize="36" Margin="0"  BorderThickness="4" Grid.Row="1" Width="350" Height="140" >
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButtonStyleAction}">
                                                        <Setter Property="Content" Value="Weigh Out"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentWeighbridgeRecord.IsOutgoing}" Value="True">
                                                                <Setter Property="Content" Value="Weigh In"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>

                                </Grid>

                            </Border>


                        </Grid>
                    </Grid>

                </Border>

                <Grid Grid.Row="2">
                    <Border Style="{DynamicResource TransactionBorderFooterStyle}" Height="80">
                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding EditSaveCommand}" Visibility="{Binding InEditMode, Converter={StaticResource TrueToVisibilityConverter}}" Width="160" Content="Save" HorizontalAlignment="Left" Margin="0,0,40,0" Style="{DynamicResource PrimaryButtonStyleAction}" Height="60"/>
                            <Button Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource TrueToFalseConverter}}" Width="160" Content="Cancel" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyleCancel}" Height="60"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>

</shared:WindowBase>
