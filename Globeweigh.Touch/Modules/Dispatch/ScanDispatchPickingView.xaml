<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
         xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
         xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
         xmlns:command="http://www.galasoft.ch/mvvmlight"
         x:Class="Globeweigh.Touch.ScanDispatchPickingView" WindowStyle="None" Margin="50"
        AllowsTransparency="True" mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="1024" ResizeMode="NoResize"  
        md:DialogServiceViews.IsRegistered ="True" Background="{DynamicResource MainNavyBrush}" IsOwnerSize="True" >

    <shared:WindowBase.Resources>

        <!-- <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/> -->
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
        <converters:NullToVisibleConverter x:Key="NullToVisibilityConverter"/>

        <Style TargetType="{x:Type dxg:RowControl}">
            <Setter Property="Height" Value="40"></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Row.IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource GlobeweighBlueBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


    </shared:WindowBase.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="PreviewKeyDown">
            <command:EventToCommand Command="{Binding KeyPreviewDownCommand}" PassEventArgsToCommand="True"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Border Margin="10" CornerRadius="3" Background="{DynamicResource MainContentGrey}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            <Grid Grid.Column="1">

                <Grid Margin="0" Background="{DynamicResource MainContentGrey}" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="10,20,20,0" BorderBrush="White" BorderThickness="6">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderThickness="0,0,0,6" BorderBrush="White">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Stock Unit ID:" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding ScannedStockUnit.id}" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="0" Grid.Row="1">

                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="0"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Product:" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="1" Margin="0" />
                                    <TextBlock Text="{Binding ScannedStockUnit.ProductDescription}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Row="1" Grid.Column="1" Margin="0,0,20,0" Grid.ColumnSpan="3" />
                                    <TextBlock Text="Batch:" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="2" Margin="0" />
                                    <TextBlock Text="{Binding ScannedStockUnit.BatchNo, StringFormat=F0}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="1"  Grid.Row="2" />
                                    <TextBlock Text="Pack Size:" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="2" Grid.Column="2" />
                                    <TextBlock Text="{Binding ScannedStockUnit.PackSizeDisplay}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="3" Grid.Row="2" />
                                    <TextBlock Text="Use By Date:" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="3" />
                                    <TextBlock Text="{Binding ScannedStockUnit.BestBeforeDate, StringFormat=dd/MM/yyy}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="1" Grid.Row="3" />
                                    <TextBlock Text="Unit Weight (kg):" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="3" Grid.Column="2" />
                                    <TextBlock Text="{Binding ScannedStockUnit.PackUnitWeightDisplay}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="3" Grid.Row="3" />
                                    <TextBlock Text="Location:" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="4" />
                                    <TextBlock Text="{Binding ScannedStockUnit.LocationDisplay}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="1" Grid.Row="4" />
                                    <TextBlock Text="Quantity Available:" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="5" />
                                    <TextBlock Text="{Binding ScannedStockUnit.QuantityAvailable, StringFormat=N0}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="1" Grid.Row="5" />
                                    <TextBlock Text="Quantity Used:" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="5" Grid.Column="2" />
                                    <TextBlock Text="{Binding ScannedStockUnit.QuantityUsedInDispatch, StringFormat=N0}" Style="{DynamicResource DefaultTextBlockContentStyle}" Grid.Column="3" Grid.Row="5" />
                                </Grid>
                            </Grid>

                        </Grid>
                    </Border>
                    <Border Margin="10,0,20,0" BorderBrush="White" BorderThickness="6,0,6,6" Grid.Row="1">
                        <Grid Margin="0">

                            <Border BorderBrush="White" BorderThickness="0,0,3,0">
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="80"/>
                                        <RowDefinition Height="71*"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderThickness="0,0,0,6" BorderBrush="White" >
                                        <Grid Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Left" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="QUANTITY REQUIRED:" VerticalAlignment="Center" FontSize="36" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                            <TextBlock Text="{Binding SelectedOrderItem.QuantityRequired,StringFormat=F0}" VerticalAlignment="Center" FontSize="36" Style="{DynamicResource DefaultTextBlockStyle}" Grid.Column="1" Margin="20,0,0,0" FontFamily="Segoe UI Semibold"/>

                                        </Grid>
                                    </Border>
                                    <Grid Margin="0" Grid.Row="1">

                                        <Grid Margin="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="2*"/>
                                                <RowDefinition Height="2*"/>
                                                <RowDefinition Height="3*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Quantity to add" VerticalAlignment="Center" FontSize="40" HorizontalAlignment="Center"  />
                                            <controls:TransactionContentControl x:Name="QuantityToAdd"  Text="{Binding QuantityToAdd}" TextBlockHorizontalAlignment="Center"  Style="{DynamicResource TextBlockPopupContentStyle}" Margin="0" Height="100" Width="300" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Top" FontSize="40"/>
                                            <!--<TextBlock Text="{Binding QuantityToAddErrorMessage, FallbackValue=Quantity exceeds target}" Visibility="{Binding QuantityError}" VerticalAlignment="Center" FontSize="26" HorizontalAlignment="Center" Grid.Row="2" Foreground="Red"  />-->
                                            <Button Command="{Binding SaveCommand}" Width="300" Content="Save" HorizontalAlignment="Center" Style="{DynamicResource PrimaryButtonStyleAction}" Height="100" VerticalAlignment="Top" FontSize="36" Grid.Column="1" Margin="0,0,0,20" Grid.Row="2"/>
                                        </Grid>

                                    </Grid>

                                </Grid>
                            </Border>

                        </Grid>

                    </Border>

                </Grid>
                <Border x:Name="ScanMessage"  Visibility="{Binding CurrentPickedItem, Converter={StaticResource NullToVisibilityConverter}}"  d:IsHidden="True"  Background="{DynamicResource MainContentGrey}" >
                    <Grid>
                        <Border Margin="0,0,0,5" BorderBrush="White" BorderThickness="4,0,0,6">
                            <Grid>

                                <TextBlock Text="{Binding ScanMessage, FallbackValue=SCAN STOCK ITEM}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="36" Foreground="{DynamicResource DarkGreyBrush}"/>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Grid>

            <Border Style="{DynamicResource TransactionBorderFooterStyle}" Height="Auto" Grid.Row="2" Background="Transparent">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="809*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding EnterIdManuallyCommand}" Style="{DynamicResource PrimaryButtonStyleAction}" Visibility="{Binding CurrentPickedItem, Converter={StaticResource NullToVisibilityConverter}}"  Content="Enter ID Manually" Margin="0" Height="50" FontSize="16" HorizontalAlignment="Right" Width="160"/>
                    <Button Command="{Binding CancelCommand}" Width="160" Content="Cancel" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyleCancel}" Height="50" Grid.Column="2" Margin="0,5"/>
                </Grid>
            </Border>
        </Grid>
    </Border>

</shared:WindowBase>
