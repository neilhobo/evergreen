<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	         xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
	         xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             xmlns:userControls="clr-namespace:Globeweigh.Touch.UserControls"
	         xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
	         xmlns:internal="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/internal"
	         md:DialogServiceViews.IsRegistered="True" 
	         x:Class="Globeweigh.Touch.DispatchOrderDetailView"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1280" 
             shared:ViewModelBehavior.LoadUnload="True" 
             DataContext="{Binding DispatchOrderDetailView, Source={StaticResource Locator}}" Background="{DynamicResource MainContentGrey}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Globeweigh.Touch;component/Resources/GridControlResources.xaml"/>

            </ResourceDictionary.MergedDictionaries>

            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
            <converters:NullToVisibleConverter x:Key="NullToVisibilityConverter"/>
            <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
            <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>

            <Style x:Key="clearBackgroundCellStyle" TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                <Style.Triggers>
                    <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                        <Setter Property="Background" Value="White" />
                        <!--<Setter Property="Foreground" Value="Black" />-->
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type TextBlock}" x:Key="RadialText">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Foreground" Value="{DynamicResource DarkGreyBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="40" />
            </Style>

            <Style TargetType="{x:Type controls:RadialGauge}">
                <Setter Property="Background" Value="Blue" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource DarkGreyBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls:RadialGauge}">
                            <Grid Width="{TemplateBinding ClientWidth}" Height="{TemplateBinding ClientHeight}">
                                <Canvas x:Name="Root" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <Path x:Name="BackgroundCircleHighlight"
                                          Data="{TemplateBinding BackgroundGeometry}"
                                          Fill="{DynamicResource GlobeweighLightBlueBrush}" Stroke="{TemplateBinding BorderBrush}"
                                          Opacity="0.2" StrokeMiterLimit="1" IsHitTestVisible="False" />
                                    <Path x:Name="Slice" Data="{TemplateBinding Geometry}"
                                          Fill="{DynamicResource GlobeweighBlueBrush}" StrokeMiterLimit="1" />

                                </Canvas>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type controls:RadialGauge}}, Path=Value}" Style="{StaticResource RadialText}" />
                                    <TextBlock Text="%" Style="{StaticResource RadialText}" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="quantityPickedCellStyle" TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                <Setter Property="Foreground" Value="Red"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Data.TargetMet}" Value="True">
                        <Setter Property="Foreground" Value="Green" />
                        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding RowData.IsFocused}" Value="True">
                        <DataTrigger.Setters>
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger.Setters>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style  TargetType="{x:Type dxg:GridColumnHeader}">
                <Setter Property="Height" Value="50"></Setter>
                <Setter Property="FontSize" Value="16" />
                <!--<Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                        <TextBlock Text="{Binding Path=Header}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </ControlTemplate>
                        </Setter.Value>
                </Setter>-->
            </Style>





        </ResourceDictionary>
    </UserControl.Resources>
    <Border  Margin="15" Background="{DynamicResource MainContentGrey}">
        <Grid   >
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource GlobeweighBlueBrush}">
                <Grid Margin="5" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                        <internal:BackButton Margin="0,0,10,0" VerticalAlignment="Center" Command="{Binding HomeCommand}" StrokeThickness="4" Width="66" Height="66"  />
                        <TextBlock Text="{Binding CurrentBatch.BatchNo, StringFormat='Batch No: {0}'}" Margin="10,0,0,0" Style="{DynamicResource HeaderTextBlockStyle}" Foreground="White"/>
                    </StackPanel>
                    <userControls:LoggedInUserControl Grid.Column="1"/>
                </Grid>
            </Border>


            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderThickness="0,0,0,4" BorderBrush="White">


                        <Grid Margin="0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border  BorderThickness="4,4,0,4" BorderBrush="White">
                                <TextBlock Text="Order Details" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" FontSize="18" />
                            </Border>
                            <Border Grid.Row="1" BorderBrush="White" BorderThickness="4,0,0,0" >
                                <Grid Margin="10" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Label Content="Order No" Style="{DynamicResource DefaultLabelStyle}" FontSize="18"/>
                                    <Label Content="{Binding CurrentDispatchOrder.OrderNo}" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Column="1" Margin="20,0,0,0" FontSize="18"/>
                                    <Label Content="Customer" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="2" Margin="0" FontSize="18"/>
                                    <Label Content="{Binding CurrentDispatchOrder.CustomerName}" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Column="1"  Grid.Row="2" Margin="20,0,0,0" FontSize="18"/>
                                    <Label Content="Haulier" Style="{DynamicResource DefaultLabelStyle}" Margin="0" Grid.Row="4" FontSize="18"/>
                                    <Label Content="{Binding CurrentDispatchOrder.HaulierName}" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Column="1" Grid.Row="4" Margin="20,0,0,0" FontSize="18"/>

                                    <Label Content="Delivery Date" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="6" FontSize="18"/>
                                    <Label Content="{Binding CurrentDispatchOrder.DeliveryDate}"  ContentStringFormat="dd/MM/yyyy" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Column="1"  Grid.Row="6" Margin="20,0,0,0" FontSize="18"/>

                                </Grid>
                            </Border>

                        </Grid>

                    </Border>
                    <Border BorderThickness="4,0,4,4" BorderBrush="White" Grid.Column="1">


                        <Grid Margin="0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border  BorderThickness="0,4" BorderBrush="White">
                                <TextBlock Text="Picking Progress" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" FontSize="18" />
                            </Border>
                            <Border BorderThickness="0" BorderBrush="White" Grid.Column="1" Grid.Row="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="5,0,0,10" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="40"/>
                                            <RowDefinition Height="100"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="QUANTITY PICKED" Style="{DynamicResource DefaultTextBlockStyle}" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" FontSize="20" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1">
                                            <TextBlock Text="{Binding CurrentDispatchOrder.PickedQuantity}" Style="{DynamicResource DefaultTextBlockStyle}" FontFamily="Segoe UI Semibold"  FontSize="40" />
                                            <TextBlock Text="/" Style="{DynamicResource DefaultTextBlockStyle}" FontFamily="Segoe UI Semibold"  FontSize="40" />
                                            <TextBlock Text="{Binding CurrentDispatchOrder.TotalQuantityOrdered}" Style="{DynamicResource DefaultTextBlockStyle}" FontFamily="Segoe UI Semibold"  FontSize="40" />
                                        </StackPanel>

                                    </Grid>
                                    <controls:RadialGauge  GapScale="0.82" ClientHeight="140" ClientWidth="140" Value="{Binding CurrentDispatchOrder.PercentagePicked,StringFormat=F0}"   VerticalAlignment="Stretch" Grid.Column="1" />

                                </Grid>
                            </Border>
                        </Grid>

                    </Border>

                </Grid>
                <Grid Margin="0,10,0,0" Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="450"/>
                        </Grid.ColumnDefinitions>
                        <Border Margin="0" BorderThickness="4,4,0,4" BorderBrush="White" >
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="60"/>
                                </Grid.RowDefinitions>
                                <Border BorderThickness="0,0,0,4" BorderBrush="White">
                                    <TextBlock Text="Order Items" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" FontSize="18"/>
                                </Border>
                                <Grid Margin="10" Grid.Row="1">

                                    <dxg:GridControl x:Name="grd"  ItemsSource="{Binding DispatchOrderItemList}" SelectedItem="{Binding SelectedOrderItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0">
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="tvGrid" AllowSorting="False" />
                                        </dxg:GridControl.View>
                                        <dxg:GridColumn FieldName="ProductDescription" Header="Product"  Width="120"  AllowEditing="False">
                                            <dxg:GridColumn.EditSettings>
                                                <dxe:TextEditSettings  HorizontalContentAlignment="Left" />
                                            </dxg:GridColumn.EditSettings>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="Size" Width="60" FixedWidth="True"/>
                                        <dxg:GridColumn FieldName="Upp"  Header="UPP" Width="60" FixedWidth="True"/>
                                        <dxg:GridColumn FieldName="Quantity" Header="Order&#xA;Quantity" FixedWidth="True" Width="100" >
                                            <dxg:GridColumn.DisplayTemplate>
                                                <ControlTemplate>
                                                    <TextBlock Margin="4,0,4,0" x:Name="PART_Editor" FontWeight="Bold" TextAlignment="Right"/>
                                                </ControlTemplate>
                                            </dxg:GridColumn.DisplayTemplate>
                                        </dxg:GridColumn>
                                        <dxg:GridColumn FieldName="PickedQuantity" Header="Quantity&#xA;Picked" FixedWidth="True" Width="100" CellStyle="{StaticResource quantityPickedCellStyle}">
                                            <dxg:GridColumn.DisplayTemplate>
                                                <ControlTemplate>
                                                    <TextBlock Margin="4,0,4,0" x:Name="PART_Editor" FontWeight="Bold" TextAlignment="Right"/>
                                                </ControlTemplate>
                                            </dxg:GridColumn.DisplayTemplate>
                                        </dxg:GridColumn>

                                    </dxg:GridControl>


                                </Grid>
                                <Border  BorderBrush="White" BorderThickness="0,4,0,0" Grid.Row="2">
                                    <Grid  >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!--<Button Command="{Binding CompleteOrderCommand}" Style="{DynamicResource PrimaryButtonStyleAction}" Content="Complete Order" Width="180" Height="50" HorizontalAlignment="Left" Margin="10,0,0,0" />-->
                                        <Button Command="{Binding ManualAddCommand}" Style="{DynamicResource PrimaryButtonStyleBase}" IsEnabled="False"  Grid.Column="1" Content="Manual Pick" Width="180" Height="50"  Margin="0,3" HorizontalAlignment="Right"/>
                                        <!--<Button Command="{Binding ScanCommand}" Style="{DynamicResource PrimaryButtonStyleBase}"  Grid.Column="2" Content="Scan Item" Width="180" Height="50"  Margin="20,3,10,3" HorizontalAlignment="Right"/>-->
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" BorderBrush="White" BorderThickness="4" >
                            <Grid Visibility="{Binding SelectedProductionBatch_Product, Converter={StaticResource NullToCollapsedConverter}}">
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="*"/>

                                    </Grid.RowDefinitions>
                                    <Border BorderThickness="0,0,0,4" BorderBrush="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Picked Items" Style="{DynamicResource GroupHeaderTextBlockStyle}" Margin="10,0,0,0" FontSize="18"/>
                                            <!--<Button Command="{Binding AddStockUnitCommand}" Style="{DynamicResource PrimaryButtonStyleAction}"  Content="+ Stock Unit " Margin="4" Grid.Column="1" Height="Auto" FontSize="14"/>
                                        <Button Command="{Binding AddStockTransferCommand}" Style="{DynamicResource PrimaryButtonStyleAction}"  Content="+ Transfer " Margin="4" Grid.Column="2" Height="Auto" FontSize="14"/>-->

                                        </Grid>

                                    </Border>
                                    <Grid Grid.Row="1" Visibility="{Binding SelectedOrderItem, Converter={StaticResource NullToCollapsedConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="60"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="10" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="668*"/>
                                                <ColumnDefinition Width="0"/>
                                            </Grid.ColumnDefinitions>
                                            <dxg:GridControl x:Name="grdPicked" ItemsSource="{Binding PickedList}" SelectedItem="{Binding SelectedPickedItem}"  Margin="0">
                                                <dxg:GridControl.View>
                                                    <dxg:TableView x:Name="tvPicked" AllowSorting="False"/>
                                                </dxg:GridControl.View>
                                                <dxg:GridColumn  FieldName="PalletNo" FixedWidth="True" Width="100">
                                                    <dxg:GridColumn.EditSettings>
                                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                                    </dxg:GridColumn.EditSettings>
                                                </dxg:GridColumn>
                                                <dxg:GridColumn FieldName="ProductName" />


                                            </dxg:GridControl>

                                        </Grid>
                                        <Border  BorderBrush="White" BorderThickness="0,4,0,0" Grid.Row="2">
                                            <Border  BorderBrush="White" BorderThickness="0" Grid.Row="1">
                                                <StackPanel Orientation="Horizontal" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <!--<Button Command="{Binding EditStockUnitCommand}" Style="{DynamicResource PrimaryButtonStyleBase}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdStockUnits}"  Content="Edit" Width="100" Height="50" Visibility="{Binding SelectedOrder, Converter={StaticResource NullToCollapsedConverter}}" Margin="0,0,10,0"/>-->
                                                    <Button Command="{Binding DeleteCommand}" Style="{DynamicResource PrimaryButtonStyleBase}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdStockUnits}"  Content="Delete" Width="100" Height="50" Visibility="{Binding SelectedOrder, Converter={StaticResource NullToCollapsedConverter}}" Margin="0"/>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <!--<Grid  Background="#FFEFEEF3" Visibility="{Binding SelectedOrderItem, Converter={StaticResource NullToVisibilityConverter}}" d:IsHidden="True" Margin="0">
                                    <Border BorderThickness="0" BorderBrush="White">
                                        <TextBlock Text="Select order Item to display picked data" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="30" Foreground="#FF424F5A" Margin="50,0"/>

                                    </Border>


                                </Grid>-->
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>



        </Grid>
    </Border>

</UserControl>
