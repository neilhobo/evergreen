<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	         xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
	         xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
	         xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             md:DialogServiceViews.IsRegistered="True" 
	         x:Class="Globeweigh.Touch.StockLocationView"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True" Background="{DynamicResource MainContentGrey}"
             DataContext="{Binding StockLocationView, Source={StaticResource Locator}}" 
             >
    <UserControl.Resources>
        <ResourceDictionary>



            <Style x:Key="rowStyle" TargetType="{x:Type dxg:RowControl}">
                <Setter Property="Height" Value="40"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type dxg:GridColumnHeader}">
                <Setter Property="Height" Value="40"></Setter>
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontSize" Value="16" />
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>
    <Grid >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <dxg:GridControl x:Name="grdLocation" ItemsSource="{Binding LocationList}" SelectedItem="{Binding SelectedLocation}" ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI Semibold" >
            <dxg:GridControl.View>
                <dxg:TableView AllowPerPixelScrolling="True" AllowFilterEditor="False" ShowVerticalLines="True" ShowHorizontalLines="True" ShowGroupPanel="False" Margin="4"
                                            AllowSorting="False" ShowIndicator="False"  AutoWidth="True"  NavigationStyle="Row"  RowStyle="{DynamicResource rowStyle}" VerticalScrollbarVisibility="Auto" ShowFilterPanelMode="Never"/>
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="Location" />
            <dxg:GridColumn FieldName="PalletCount" Width="120" FixedWidth="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
        </dxg:GridControl>
        <dxg:GridControl x:Name="grdSummary" ItemsSource="{Binding SummaryList}" SelectedItem="{Binding SelectedSummary}" ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI Semibold" Grid.Column="1" >
            <dxg:GridControl.View>
                <dxg:TableView AllowPerPixelScrolling="True" AllowFilterEditor="False" ShowVerticalLines="True" ShowHorizontalLines="True" ShowGroupPanel="False" Margin="4"
                                            AllowSorting="False" ShowIndicator="False"  AutoWidth="True"  NavigationStyle="Row"  RowStyle="{DynamicResource rowStyle}" VerticalScrollbarVisibility="Auto" ShowFilterPanelMode="Never"/>
            </dxg:GridControl.View>

            
            <dxg:GridColumn FieldName="Code" Width="90" FixedWidth="True"/>

            <dxg:GridColumn FieldName="ProductName"  Header="Product"  />
            <dxg:GridColumn FieldName="LintrackerCode" Width="130" FixedWidth="True"/>
            <dxg:GridColumn FieldName="PalletCount" Width="150" FixedWidth="True">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>

        </dxg:GridControl>
        <!--<dxg:GridControl x:Name="grdPallets" ItemsSource="{Binding PalletList}" SelectedItem="{Binding SelectedPallet}" ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                    Loaded="GrdPallets_OnLoaded" Grid.Column="1" >
            <dxg:GridControl.View>
                <dxg:TableView AllowPerPixelScrolling="True" AllowFilterEditor="False" ShowVerticalLines="True" ShowHorizontalLines="True" ShowGroupPanel="False" Margin="4"
                                            AllowSorting="False" ShowIndicator="False"  AutoWidth="True"  NavigationStyle="Row"  RowStyle="{DynamicResource rowStyle}" VerticalScrollbarVisibility="Auto" ShowFilterPanelMode="Never"/>
            </dxg:GridControl.View>
            <dxg:GridColumn FieldName="PalletNo">
                <dxg:GridColumn.EditSettings>
                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                </dxg:GridColumn.EditSettings>
            </dxg:GridColumn>
            <dxg:GridColumn FieldName="LocationDisplay" Header="Location" />
        </dxg:GridControl>-->
    </Grid>
</UserControl>

