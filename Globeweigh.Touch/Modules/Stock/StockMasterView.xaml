<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	         xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
	         xmlns:internal="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/internal"
             xmlns:userControls="clr-namespace:Globeweigh.Touch.UserControls"
             xmlns:touch="clr-namespace:Globeweigh.Touch"
             md:DialogServiceViews.IsRegistered="True" 
	         x:Class="Globeweigh.Touch.StockMasterView"
             mc:Ignorable="d"
             d:DesignHeight="1024" d:DesignWidth="1280"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding StockMasterView, Source={StaticResource Locator}}" Background="White"
             >
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type touch:StockSummaryViewModel}">
            <touch:StockSummaryView/>
        </DataTemplate>


        <DataTemplate DataType="{x:Type touch:StockLocationViewModel}">
            <touch:StockLocationView/>
        </DataTemplate>


        <Style x:Key="LeftMenuItemContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="{DynamicResource LightGreyBrush}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Height="70" Background="{TemplateBinding Background}" CornerRadius="3" Width="260" Margin="0,0,20,0" >
                            <Grid  >
                                <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="{DynamicResource MainNavyBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="100"/>
            <RowDefinition/>
            </Grid.RowDefinitions>
        <Grid Background="{DynamicResource GlobeweighBlueBrush}" >
            <Grid Margin="5" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0">
                    <!-- <Button Width="60" Height="60" Style="{DynamicResource BackButtonStyle}" Margin="6,0,0,0" Command="{Binding HomeCommand}"/> -->
                    <internal:BackButton Margin="2,2,10,2" VerticalAlignment="Center" Command="{Binding HomeCommand}" StrokeThickness="4" Width="66" Height="66"  />
                    <TextBlock Text="Stock" Margin="10,0,0,0" Style="{DynamicResource HeaderTextBlockStyle}" Foreground="White"/>
                </StackPanel>
                <userControls:LoggedInUserControl Grid.Column="2" HorizontalAlignment="Right"/>
            </Grid>


        </Grid>
        <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" Grid.Row="1" >
            <ListBox x:Name="list" Background="{x:Null}" SelectedItem="{Binding SelectedNavItem}"  ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Grid.Row="1" ItemContainerStyle="{DynamicResource LeftMenuItemContainerStyle}" Margin="0,6" >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem x:Name="Summary" Content="Summary View" IsSelected="True"  />
                <ListBoxItem x:Name="LocationView" Content="Location View" />
                <!--<ListBoxItem x:Name="PalletList" Content="Pallet List" />-->
            </ListBox>
        </Border>
        <ContentControl Content="{Binding CurrentViewModel}" Grid.Row="2" />


    </Grid>

</UserControl>

