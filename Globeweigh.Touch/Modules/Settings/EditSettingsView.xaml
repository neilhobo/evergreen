<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        x:Class="Globeweigh.Touch.EditSettingsView" WindowStyle="None" Margin="0" 
        AllowsTransparency="True" mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="1024" ResizeMode="NoResize"  
        md:DialogServiceViews.IsRegistered ="True" Background="{DynamicResource MainNavyBrush}" Width="1100" Height="1000">

    <shared:WindowBase.Resources>

        <!--        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>-->



    </shared:WindowBase.Resources>
    <Border  Margin="10" CornerRadius="3" Background="{DynamicResource MainContentGrey}" >
        <Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{DynamicResource TransactionBorderHeaderStyle}" >
                    <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="34" Margin="20,0" Foreground="{DynamicResource MainNavyBrush}"/>
                </Border>
                <Border Margin="10" Grid.Row="1" BorderBrush="White" BorderThickness="4" >
                    <Grid >
                        <Grid Margin="0,0,10,0">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="60"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!--<Border BorderBrush="White" BorderThickness="0,0,0,4">
                                        <TextBlock Text="General settings" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBlockContentStyle}" FontSize="32" Padding="0"/>
                                    </Border>-->
                                    <Grid Grid.Row="1"   >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!--<TextBlock Text="Ignore Lock rule:"  Style="{DynamicResource DefaultTextBlockStyle}" FontSize="26"/>
                                        <CheckBox Grid.Column="1"  IsChecked="{Binding CurrentSetting.IgnoreLockRule, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="50" Height="50" />-->
                                        <TextBlock Text="Pallet Labels to Print:"  Style="{DynamicResource DefaultTextBlockStyle}" Grid.Row="0" FontSize="26"/>
                                        <controls:TransactionContentControl x:Name="PrintCount" Grid.Column="1" Text="{Binding PalletLabelPrintCount}"   Style="{DynamicResource TextBlockPopupContentStyle}" Margin="20,0,0,0" HorizontalAlignment="Left" Width="180" Height="70" />

                                    </Grid>


                                </Grid>


                            </Grid>


                        </Grid>
                    </Grid>

                </Border>

                <Grid Grid.Row="2">
                    <Border Style="{DynamicResource TransactionBorderFooterStyle}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,30,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Command="{Binding SaveCommand}"  Width="160" Content="Save" HorizontalAlignment="Left" Margin="0,0,40,0" Style="{DynamicResource PrimaryButtonStyleAction}" Height="60"/>
                            <Button Command="{Binding CancelCommand}" Width="160" Content="Cancel" HorizontalAlignment="Right" Style="{DynamicResource PrimaryButtonStyleCancel}" Height="60"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>

</shared:WindowBase>
