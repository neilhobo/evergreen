<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Globeweigh.Touch.UserControls"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             x:Name="UserControl" x:Class="Globeweigh.Touch.UserControls.LoggedInUserControl"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="500">

    <UserControl.Resources>

        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyleBase}">
            <Setter Property="Foreground" Value="{DynamicResource GlobeweighLightBlueBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" UseLayoutRounding="True" CornerRadius="3" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image  VerticalAlignment="Center" HorizontalAlignment="Center" Width="45" Height="44" Margin="0" Source="/Globeweigh.Touch;component/Images/Logout-96.png" Grid.ColumnSpan="1"/>
                                <TextBlock Text="Logout"  Grid.Column="1" FontSize="22" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Margin="0,15,-0.2,15"/>
                            </Grid>

                        </Border>
                        <ControlTemplate.Triggers>
                            <!--<Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GlobeweighLightBlueBrush}"/>
                            </Trigger>-->


                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>


    </UserControl.Resources>

    <Grid  Visibility="{Binding LoggedInUser, Converter={StaticResource NullToCollapsedConverter}}">
        <StackPanel Orientation="Horizontal" Margin="10,0,30,0" Grid.Column="1" HorizontalAlignment="Right">
            <Image  VerticalAlignment="Center" HorizontalAlignment="Center" Width="45" Height="45" Margin="0,0,10,0" Source="/Globeweigh.Touch;component/Images/Circled User Male-32.png"/>
            <TextBlock Text="{Binding LoggedInUser, FallbackValue=Neil Hobson}"  Grid.Column="3" FontSize="28" Style="{DynamicResource HeaderTextBlockStyle}"  VerticalAlignment="Center" Foreground="White"/>
            <Button Margin="40,0,0,0" Command="{Binding GlobalLogoutCommand}" Foreground="White" Height="Auto"/>

        </StackPanel>
    </Grid>
</UserControl>
