<UserControl x:Name="UserControl" x:Class="Globeweigh.Touch.UserControls.DateFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:internal="http://schemas.devexpress.com/winfx/2008/xaml/windowsui/internal"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="400">
    
    <UserControl.Resources>

        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>

