    </UserControl.Resources>
    <Grid Height="50" Width="350">
        <Grid HorizontalAlignment="Center" Width="320" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>
            <internal:BackButton Command="{Binding FilterDateBackCommand, Mode=OneWay}" />
            <TextBlock Text="{Binding FilterDate, FallbackValue=Monday 21st December, StringFormat='{}{0:dd/MM/yyyy}'}" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{Binding FontSize, ElementName=UserControl}" Visibility="{Binding ElementName=UserControl, Path=MonthMode, Converter={StaticResource TrueToCollapsedConverter}}"/>
            <TextBlock Text="{Binding FilterDate, FallbackValue=Monday 21st December, StringFormat='{}{0:MMMM yyyy}'}" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{Binding FontSize, ElementName=UserControl}" Visibility="{Binding ElementName=UserControl, Path=MonthMode, Converter={StaticResource TrueToVisibilityConverter}}"/>
            <internal:ForwardButton Command="{Binding FilterDateForwardCommand, Mode=OneWay}" Grid.Column="2" />
            <!--<controls:NavigationButton Command="{Binding FilterDateForwardCommand}" Style="{DynamicResource DateNavigateButtonStyle}"  Grid.Column="2" ImageSource="/Globeweigh.Touch;component/Images/Right Squared-64.png"/>-->

        </Grid>
    </Grid>
</UserControl>
