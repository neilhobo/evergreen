<?xml version="1.0" encoding="utf-8"?>
<configuration >
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <add name="GlobeweighEntities"
         connectionString="metadata=res://*/Model1.csdl|res://*/Model1.ssdl|res://*/Model1.msl;provider=System.Data.SqlClient;provider connection string=&quot;Server=localhost\NTPRO;Database=GbEvergreen;User Id=globeweigh;Password=ButternutSquash09;MultipleActiveResultSets=True;&quot;"
         providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <add key="WeighbridgeListenPort" value="8765" />
    <!-- Second weighbridge Moxa (ip[:port], port defaults to 4001). Served at /weighbridge2/weight. -->
    <add key="Weighbridge2" value="192.168.250.148:4001" />
    <!-- Allow-list for the WebSocket→VNC bridge (/vnc?target=NAME). NAME=host:port, ';'-separated. -->
    <add key="VncTargets" value="TOUCH-IN=192.168.250.212:5900;TOUCH-OUT=192.168.250.198:5900" />
    <!-- Auto-printed delivery notes (PrintWorker). The queue is dbo.PrintJob, filled by the
         API when a picker completes a load; the copy count and printer name come from the
         Setting row, not from here. Chrome 109 is the newest Chromium Server 2012 R2 runs
         and there is no Edge on the box, so ChromePath must stay pointed at Chrome. -->
    <add key="PrintEnabled" value="true" />
    <add key="ChromePath" value="C:\Program Files\Google\Chrome\Application\chrome.exe" />
    <add key="SumatraPath" value="C:\Globeweigh\PrintTools\SumatraPDF.exe" />
    <add key="PrintWorkDir" value="C:\Globeweigh\PrintTmp" />
    <add key="PrintApiBaseUrl" value="http://localhost:5099" />
  </appSettings>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>