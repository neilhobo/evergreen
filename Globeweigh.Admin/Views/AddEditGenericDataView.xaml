<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.AddEditGenericDataView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="300" Width="500" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White">

    <Border Margin="4">
        <Border.Effect>
            <DropShadowEffect Direction="360" ShadowDepth="0" BlurRadius="10"/>
        </Border.Effect>
        <Grid Margin="0" Background="White" dx:ThemeManager.ThemeName="MetropolisLight">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" Background="{DynamicResource LightGreyBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="{Binding HeaderText, FallbackValue=Header Text}" Style="{DynamicResource GreyHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <Grid Margin="0">
                    <Grid x:Name="ControlsGrid" Margin="20" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding LabelText, FallbackValue=[LabelText]}" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,10,20"  />
                        <TextBox x:Name="name" Text="{Binding TransactionText, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" CharacterCasing="{Binding CharacterCasing, FallbackValue=Normal}" Style="{DynamicResource TransactionTextBoxStyle}" Margin="0,0,0,20" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Grid>

            </Border>

            <Border Background="{DynamicResource LightGreyBrush}" Padding="0" Margin="0" Grid.Row="2" BorderBrush="{DynamicResource MainBorderBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save" Width="100" Command="{Binding SaveCommand}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Margin="20,0,6,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>
