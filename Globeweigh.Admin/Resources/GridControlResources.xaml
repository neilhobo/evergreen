<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
                    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">




    <SolidColorBrush x:Key="{dxgt:GridRowThemeKey ResourceKey=BorderFocusedBrush, IsThemeIndependent=true}" Color="{StaticResource GlobeweighBlueColor}"/>
    <SolidColorBrush x:Key="{dxgt:GridRowThemeKey ResourceKey=BorderSelectedBrush, IsThemeIndependent=true}" Color="{StaticResource GlobeweighBlueColor}"/>



    <Style TargetType="{x:Type dxg:GridControl}">
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="dx:ThemeManager.ThemeName" Value="VS2017Light"/>
        <Setter Property="ShowBorder" Value="False" />
        
    </Style>

    <Style TargetType="{x:Type dxg:TableView}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="SearchPanelHorizontalAlignment" Value="Left" />
        <Setter Property="ShowVerticalLines" Value="True" />
        <Setter Property="ShowIndicator" Value="False" />
        <Setter Property="ShowGroupPanel" Value="False" />
        <Setter Property="ShowAutoFilterRow" Value="True" />
        <Setter Property="ShowSearchPanelMode" Value="Never" />
        <Setter Property="AllowPerPixelScrolling" Value="True" />
        <Setter Property="FadeSelectionOnLostFocus" Value="False" />
        <Setter Property="AutoWidth" Value="True" />
        <Setter Property="NavigationStyle" Value="Row" />
        <Setter Property="VerticalScrollbarVisibility" Value="Auto" />
    </Style>


    <DataTemplate x:Key="MultiLineHeader">
        <Grid MaxHeight="54">
            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
        </Grid>
    </DataTemplate>



</ResourceDictionary>