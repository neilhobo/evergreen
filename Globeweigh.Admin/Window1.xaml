<controls:MetroWindow x:Class="Globeweigh.Admin.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Globeweigh.Admin"
        xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:converters="clr-namespace:Globeweigh.UI.Shared.Converters;assembly=Globeweigh.UI.Shared"
        xmlns:controls1="clr-namespace:Globeweigh.Admin.Controls"
        mc:Ignorable="d" WindowTitleBrush="#FF3F3F46" WindowState="Maximized"
        Title="Window1" Height="300" Width="300">
    <controls:MetroWindow.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/MetroResources.xaml" />
                <ResourceDictionary Source="Resources/ElementStyles.xaml"/>
                <ResourceDictionary Source="Resources/GridControlResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>

            <DataTemplate DataType="{x:Type local:StockMasterViewModel}">
                <local:StockMasterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:EntitiesViewModel}">
                <local:EntitiesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ReferenceDataViewModel}">
                <local:ReferenceDataView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:DispatchMasterViewModel}">
                <local:DispatchMasterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type local:ProductListViewModel}">
                <local:ProductListView/>
            </DataTemplate>
            <!--<DataTemplate DataType="{x:Type local:LabelDesignerViewModel}">
                <local:LabelDesignerView/>
            </DataTemplate>-->

            <DataTemplate DataType="{x:Type local:CustomerSupplierListViewModel}">
                <local:CustomerSupplierListView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type local:WeighbridgeMasterViewModel}">
                <local:WeighbridgeMasterView/>
            </DataTemplate>


            <Style x:Key="MainMenuItemStyle" TargetType="{x:Type controls1:MenuListBoxItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type controls1:MenuListBoxItem}">
                            <Grid Height="60" d:DesignWidth="200" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding ImageSource, RelativeSource={RelativeSource TemplatedParent}}" Margin="8"/>
                                <Border x:Name="Bd" SnapsToDevicePixels="true" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="1" >
                                    <TextBlock Text="{TemplateBinding Content}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Left"  VerticalAlignment="Center" Foreground="White" FontSize="13" Margin="8,0,0,0" FontFamily="Whitney HTF Medium"  />
                                </Border>
                                <ContentPresenter Grid.RowSpan="2" Content="" Grid.ColumnSpan="2"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"/>
                                <Trigger Property="Selector.IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource IsSelectedGreyBrush}"/>
                                </Trigger>

                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </controls:MetroWindow.Resources>
    <Grid>
        
    </Grid>
</controls:MetroWindow>



