<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             xmlns:model="clr-namespace:Globeweigh.Model;assembly=Globeweigh.Model"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.ReportStockSummaryView"
             mc:Ignorable="d"  dx:ThemeManager.ThemeName="MetropolisLight"
             d:DesignHeight="400" d:DesignWidth="1000"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding ReportStockSummaryView, Source={StaticResource Locator}}" Background="White">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid>
        <Grid Margin="0" Grid.Row="1" >
            <Border Background="White" BorderThickness="0" Grid.Row="1" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="17*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0" Margin="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="37*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,1">
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dispatch/Stock Report" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="18,0,0,0" FontSize="20" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="20,10,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="439*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Customer:" Margin="0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainNavyBrush}"/>
                                <dxe:ComboBoxEdit Grid.Column="1" ItemsSource="{Binding CustomerList}" SelectedItem="{Binding SelectedCustomer}" Foreground="Black" IsTextEditable="False" DisplayMember="Name" ValueMember="id" VerticalAlignment="Center" HorizontalAlignment="Left" Width="150" />
                                <Button Content="Search" Width="100" Command="{Binding SearchCommand}" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,0" Grid.ColumnSpan="2"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1"  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="453*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1" Grid.Row="0">
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="3" >
                                    <controls:ImageButton Content="Print / Export" Margin="0" ImageSource="/Images\Print-32.png"  Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvItems}" IsEnabled="{Binding VisibleRowCount, ElementName=grdPallets}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <dxg:GridControl x:Name="grdItems" ItemsSource="{Binding SummaryList}"  ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Margin="2">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvItems" AllowPerPixelScrolling="True" EnableImmediatePosting="True" BestFitMode="Smart" AllowSorting="True" ShowAutoFilterRow="True" ShowGroupPanel="False" ShowIndicator="True" AutoWidth="True"  NavigationStyle="None"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="CustomerName" Header="Customer" />
                            <dxg:GridColumn FieldName="Code" Header="Product Code" />
                            <dxg:GridColumn FieldName="Description" Header="Product Description" />
                            <dxg:GridColumn FieldName="PalletCount" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalUnits">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalWeight">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn  FieldName="PalletDeliveryCondition" Header="Pallet Delivery Condition" FixedWidth="True" Width="150">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ComboBoxEditSettings AutoComplete="True" ItemsSource="{Binding Source={model:Enum {x:Type model:ePalletDeliveryCondition}}}" DisplayMember="Description" ValueMember="Value" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="OnHoldCount" Header="Pallets On Hold">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="OnHoldUnitCount" Header="Units On Hold">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!--<dxg:GridColumn  Header=" " />-->

                        </dxg:GridControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
