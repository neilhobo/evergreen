<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.ReportDispatchInStockView"
             mc:Ignorable="d"  dx:ThemeManager.ThemeName="MetropolisLight"
             d:DesignHeight="400" d:DesignWidth="1100"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding ReportDispatchInStockView, Source={StaticResource Locator}}" Background="White">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid>
        <Grid Margin="0" Grid.Row="1" >
            <Border Background="White" BorderThickness="0" Grid.Row="1" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200"/>
                        <RowDefinition Height="17*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0" Margin="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="37*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,1">
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dispatch/Stock Report" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="18,0,0,0" FontSize="20" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="20,10,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="439*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Customer:" Margin="0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource MainNavyBrush}"/>
                                <dxe:ComboBoxEdit Grid.Column="1" ItemsSource="{Binding CustomerList}" SelectedItem="{Binding SelectedCustomer}" Foreground="Black" IsTextEditable="False" DisplayMember="Name" ValueMember="id" VerticalAlignment="Center" HorizontalAlignment="Left" Width="150" />
                                <TextBlock Text="Dispatch Date From:" VerticalAlignment="Center" Margin="0" FontSize="14" Grid.Row="1"/>
                                <dxe:DateEdit EditValue="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="110" Margin="0" Grid.Column="1" Grid.Row="1"/>
                                <TextBlock Text="Dispatch Date To:" VerticalAlignment="Center" Margin="0" FontSize="14" Grid.Row="2"/>
                                <dxe:DateEdit EditValue="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="110" Margin="0" Grid.Row="2" Grid.Column="1"/>
                                <Button Content="Search" Width="100" Command="{Binding SearchCommand}" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,0" Grid.ColumnSpan="2"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1"  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="453*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1" Grid.Row="0">
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="3" >
                                    <controls:ImageButton Content="Print / Export" Margin="0" ImageSource="/Images\Print-32.png"  Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvItems}" IsEnabled="{Binding VisibleRowCount, ElementName=grdPallets}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <dxg:GridControl x:Name="grdItems" ItemsSource="{Binding DispatchStockList}"  ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Margin="2">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvItems" AllowPerPixelScrolling="True" EnableImmediatePosting="True" ShowFixedTotalSummary="True" ShowTotalSummary="True" BestFitMode="Smart" AllowSorting="True" ShowAutoFilterRow="True" ShowGroupPanel="False" ShowIndicator="True" AutoWidth="True"  NavigationStyle="None"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="CustomerName" Header="Customer" />
                            <dxg:GridColumn FieldName="PalletNo" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="CustomerPalletNo">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="ProductCode" Header="Product Code" />
                            <dxg:GridColumn FieldName="ProductDescription" Header="Product" />
                            <dxg:GridColumn FieldName="NoOfUnits" Header="Units" />
                            <dxg:GridColumn FieldName="Weight" Header="Weight (Kg)" />
                            <dxg:GridColumn FieldName="OrderRef"  Header="ECM Ref" AutoFilterCondition="Contains" Width="80" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="DateOfIntake" Header="Date Of Intake">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="UseByDate" Header="Best Before Date">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="DateDispatched">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="OrderNo" Header="Dispatch Order No" />
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem FieldName="OriginalNoOfUnits" SummaryType="Sum" ShowInColumn="OriginalNoOfUnits" DisplayFormat="{}{0:n0}"/>
                                <dxg:GridSummaryItem FieldName="Weight" SummaryType="Sum" ShowInColumn="Weight" DisplayFormat="{}{0:n0}"/>
                                <dxg:GridSummaryItem SummaryType="Count" Alignment="Right" />
                            </dxg:GridControl.TotalSummary>

                        </dxg:GridControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
