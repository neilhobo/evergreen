<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.ReportDispatchRecordsView"
             mc:Ignorable="d"  dx:ThemeManager.ThemeName="MetropolisLight"
             d:DesignHeight="400" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding ReportDispatchRecordsView, Source={StaticResource Locator}}" Background="White">
    <UserControl.Resources>

    </UserControl.Resources>
    <Grid>
        <Grid Margin="0" Grid.Row="1" >
            <Border Background="White" BorderThickness="0" Grid.Row="1" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="17*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0" Margin="0">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="37*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,1">
                                <Grid Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Dispatch Records" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="18,0,0,0" FontSize="20" />
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="20,10,10,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="439*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Dispatch Date From:" VerticalAlignment="Center" Margin="0" FontSize="14" Grid.Row="1"/>
                                <dxe:DateEdit EditValue="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="110" Margin="0" Grid.Column="1" Grid.Row="1"/>
                                <TextBlock Text="Dispatch Date To:" VerticalAlignment="Center" Margin="0" FontSize="14" Grid.Row="2"/>
                                <dxe:DateEdit EditValue="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="110" Margin="0" Grid.Row="2" Grid.Column="1"/>
                                <Button Content="Search" Width="100" Command="{Binding SearchCommand}" Grid.Row="4" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,10,0,0" Grid.ColumnSpan="2"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1"  >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="453*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1" Grid.Row="0">
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="3" >
                                    <controls:ImageButton Content="Generate Report" Margin="0" ImageSource="/Images\Report-32.png"  Command="{Binding GenerateReportCommand}" CommandParameter="{Binding ElementName=tvItems}" IsEnabled="{Binding VisibleRowCount, ElementName=grdDispatchOrders}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                    <controls:ImageButton Content="Print / Export" Margin="0" ImageSource="/Images\Print-32.png"  Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvItems}" IsEnabled="{Binding VisibleRowCount, ElementName=grdDispatchOrders}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                
                                </StackPanel>
                            </Grid>
                        </Border>
                        <dxg:GridControl x:Name="grdDispatchOrders" ItemsSource="{Binding DispatchRecordList}" ShowLoadingPanel="{Binding IsBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"   Margin="2" Grid.Row="1" SelectionMode="None">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvItems" AllowPerPixelScrolling="True" ShowColumnHeaders="True" ShowAutoFilterRow="True" AutoWidth="True" ShowGroupPanel="False" ShowIndicator="True" Margin="0" NavigationStyle="None">
                                </dxg:TableView>
                            </dxg:GridControl.View>
                            <dxg:GridControl.Columns>
                                <dxg:GridColumn FieldName="DateDispatched" Width="70" Visible="{Binding ElementName=rdoComplete, Path=IsChecked}">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="CustomerName" Header="Customer" />
                                <dxg:GridColumn FieldName="CustomerOrderNo" Header="Po Number" />
                                
                                <dxg:GridColumn FieldName="DamagedPassed" Width="80" FixedWidth="True"/>
                                <dxg:GridColumn FieldName="CleanPassed" Width="80" FixedWidth="True"/>
                                <dxg:GridColumn FieldName="OdourFreePassed" Width="80" FixedWidth="True"/>
                                <dxg:GridColumn FieldName="PestFreePassed" Width="80" FixedWidth="True"/>
                                <dxg:GridColumn FieldName="PackagingDamagedPassed" Width="80" FixedWidth="True"/>
                                <dxg:GridColumn FieldName="AveragePalletTempActual" Header="Avg. Product Temp" Width="100" FixedWidth="True"/>
                            </dxg:GridControl.Columns>


                        </dxg:GridControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
