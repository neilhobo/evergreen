<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges" xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
    xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared" xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys" xmlns:system="clr-namespace:System;assembly=mscorlib" md:DialogServiceViews.IsRegistered="True" x:Class="Globeweigh.Admin.WeighbridgeRecordsView" mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="1500" shared:ViewModelBehavior.LoadUnload="True"
    DataContext="{Binding WeighbridgeRecordsView, Source={StaticResource Locator}}"
    Background="{DynamicResource LightGreyBrush}">
    <UserControl.Resources>
        <ResourceDictionary>

            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter" />
            <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter" />
            <converters:NullToFalseConverter x:Key="NullToFalseConverter" />

            <!-- <Style x:Key="clearBackgroundCellStyle" TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}"> -->
            <!--     <Style.Triggers> -->
            <!--         <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True"> -->
            <!--             <Setter Property="Background" Value="White" /> -->
            <!--         </Trigger> -->
            <!--     </Style.Triggers> -->
            <!-- </Style> -->
            <!--    -->
            <!-- <Style  TargetType="{x:Type dxg:RowControl}" > -->
            <!--     <Setter Property="Height" Value="24"></Setter> -->
            <!-- </Style> -->
            <!--    -->
            <!-- <Style x:Key="FocusedCellStyle" TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}"> -->
            <!--     <Setter Property="Background" Value="White" /> -->
            <!--     <Style.Triggers> -->
            <!--         <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True"> -->
            <!--             <Setter Property="Background" Value="White" /> -->
            <!--         </Trigger> -->
            <!--     </Style.Triggers> -->
            <!-- </Style> -->

            <DataTemplate x:Key="WeightTypeShortCellTemplate">
                <Grid>
                    <Border x:Name="bdIncoming" Background="#FFE2F6F2" Margin="2" CornerRadius="3" Grid.Column="1">
                        <TextBlock Text="IN" Foreground="#FF58AD63" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontFamily="Segoe UI Semibold" />
                    </Border>
                    <Border x:Name="bd" Background="#FFFADFED" Margin="2" CornerRadius="3" Grid.Column="1" Visibility="Collapsed">
                        <TextBlock Text="OUT" Foreground="#FFE76884" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontFamily="Segoe UI Semibold" />
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RowData.Row.IsOutgoing}" Value="true">
                        <Setter TargetName="bd" Property="Visibility" Value="Visible" />
                        <Setter TargetName="bdIncoming" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>


        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="300" />
            <RowDefinition Height="30*" />
        </Grid.RowDefinitions>

        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="White" BorderThickness="3,3,0,3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="White" BorderThickness="0,0,0,3">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Weighbridge Scale/Gate/Barrier" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" />
                        </Grid>
                    </Border>
                    <Grid Margin="2" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="150" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Margin="10" Background="#FF424242" CornerRadius="3">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <dxga:DigitalGaugeControl Text="{Binding LiveWeight}" Margin="0,10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <dxga:SevenSegmentsView>
                                        <dxga:SevenSegmentsView.Presentation>
                                            <dxga:DefaultSevenSegmentsPresentation FillActive="#FF43E64A" FillInactive="#0F555555" />
                                        </dxga:SevenSegmentsView.Presentation>
                                    </dxga:SevenSegmentsView>
                                </dxga:DigitalGaugeControl>
                                <TextBlock Text="Kg" Grid.Column="1" FontSize="50" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right" />
                            </Grid>

                        </Border>
                        <Border Grid.Row="1" BorderBrush="White" BorderThickness="0,3,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid Visibility="{Binding RelayTcpConnection, Converter={StaticResource NullToCollapsedConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Gate:" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBlockContentStyle}" FontSize="14" Margin="0" />
                                        <Button Grid.Column="1" Command="{Binding GateCommand}" Width="80" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyleAction}">
                                                    <Setter Property="Content" Value="Open" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GateOpen}" Value="True">
                                                            <Setter Property="Content" Value="Close" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Fill="#FF00E000" Visibility="{Binding GateOpen, Converter={StaticResource TrueToVisibilityConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Stroke="White" StrokeThickness="3" />
                                            <Ellipse Fill="Red" Visibility="{Binding GateOpen, Converter={StaticResource TrueToCollapsedConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Grid.Column="1" Stroke="White" StrokeThickness="3" />
                                        </Grid>
                                    </Grid>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Barrier:" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBlockContentStyle}" FontSize="14" Margin="0" />
                                        <Button Grid.Column="1" Command="{Binding BarrierCommand}" Width="80" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyleAction}">
                                                    <Setter Property="Content" Value="Open" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BarrierOpen}" Value="True">
                                                            <Setter Property="Content" Value="Close" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Fill="#FF00E000" Visibility="{Binding BarrierOpen, Converter={StaticResource TrueToVisibilityConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Stroke="White" StrokeThickness="3" />
                                            <Ellipse Fill="Red" Visibility="{Binding BarrierOpen, Converter={StaticResource TrueToCollapsedConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Grid.Column="1" Stroke="White" StrokeThickness="3" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <Border Grid.Column="1" BorderBrush="White" BorderThickness="3,0,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border BorderBrush="White" BorderThickness="0,0,0,3">
                                            <Label Content="Remote Connect" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="Black" Margin="4,0,0,0" HorizontalAlignment="Center" />
                                        </Border>
                                        <dxe:HyperlinkEdit Text="TOUCH-IN" Command="{Binding VncTouchInCommand}" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="16" FontFamily="Segoe UI Semibold" Grid.Row="1" Margin="20,0,0,0" />
                                        <dxe:HyperlinkEdit Text="TOUCH-OUT" Command="{Binding VncTouchOutCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16" FontFamily="Segoe UI Semibold" Grid.Row="2" Margin="20,0,0,0" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>



                    </Grid>
                </Grid>
            </Border>
            <Border BorderBrush="White" BorderThickness="3" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="White" BorderThickness="0,0,0,3">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="Pending:" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right" Grid.Column="1">
                                <!--<Button Content="Add Outgoing" Command="{Binding AddOutgoingCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>-->
                                <!--<Button Content="Add Incoming" Command="{Binding AddIncomingCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>-->
                                <Button Content="Edit" Command="{Binding EditPendingCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdPending}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                                <Button Content="Delete" Command="{Binding DeletePendingCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdPending}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <Button Content="Refresh" Margin="2,0,0,0" Command="{Binding RefreshPendingCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Margin="2" Grid.Row="1">
                        <dxg:GridControl x:Name="grdPending" ItemsSource="{Binding PendingList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedPending}" ShowBorder="False" Margin="4">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvPending" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FixedWidth="True" Width="40" Header=" " CellTemplate="{DynamicResource WeightTypeShortCellTemplate}" HorizontalHeaderContentAlignment="Center" />
                            <dxg:GridColumn FieldName="PendingWeighDate" Width="110" Header="Weigh Date" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="HaulierName" Header="Haulier" />
                            <dxg:GridColumn FieldName="DocketNumber" Header="Docket No" FixedWidth="True" Width="70" />
                            <dxg:GridColumn FieldName="VehicleReg" FixedWidth="True" Width="100" />
                            <dxg:GridColumn FieldName="Product" FixedWidth="True" Width="100" />
                            <dxg:GridColumn FieldName="Supplier" FixedWidth="True" Width="140" />
                            <dxg:GridColumn FieldName="BogName" FixedWidth="True" Width="140" />
                            <dxg:GridColumn FieldName="PendingWeight" Header="Weight" FixedWidth="True" Width="100" />
                            <!--<dxg:GridColumn FieldName="OrderCount" Header="Orders" FixedWidth="True" Width="70" />-->

                        </dxg:GridControl>
                    </Grid>
                </Grid>
            </Border>



        </Grid>
        <Border Margin="0,4,0,0" BorderBrush="White" BorderThickness="3" Grid.RowSpan="2" Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,3" BorderBrush="White">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label Content="Completed" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="3">
                            <Button Content="Add Manual" Command="{Binding AddManualCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                            <Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdOrdersHaulierAssigned}" Style="{DynamicResource ToolbarButtonStyle}" />
                            <Button Content="Delete" Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdCompletedOrders}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                            <Button Content="Export for Supplier" Margin="2,0,0,0" Command="{Binding ExportCompletedOrdersQuickExcelCommand}" CommandParameter="{Binding ElementName=grdCompletedOrders}" IsEnabled="{Binding VisibleRowCount, ElementName=grdCompletedOrders}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                            <Button Content="Print / Export" Margin="2,0,0,0" Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvCompletedOrders}" IsEnabled="{Binding VisibleRowCount, ElementName=grdCompletedOrders}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0,0,0">
                            <Label Content="Date From:" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" />
                            <dxe:DateEdit EditValue="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}" Width="90" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <Label Content="Date To:" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Margin="10,0,0,0" />
                            <dxe:DateEdit EditValue="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}" Width="90" VerticalAlignment="Center" Margin="10,0,0,0" />
                            <Button Content="Refresh" Command="{Binding RefreshCompletedCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" Margin="10,0,0,0" />

                        </StackPanel>
                    </Grid>
                </Border>


                <dxg:GridControl x:Name="grdCompletedOrders" ItemsSource="{Binding CompletedWeighbridgeRecordList}" ShowBorder="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding SelectedCompletedWeighbridgeRecord}" Margin="4,10,4,4" Grid.Row="1">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tvCompletedOrders" />
                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="HaulierName" Header="Haulier" />
                    <dxg:GridColumn FieldName="DocketNumber" Header="Docket No" FixedWidth="True" Width="70" />
                    <dxg:GridColumn FieldName="VehicleReg" Header="Vehicle Reg" FixedWidth="True" Width="80" />
                    <dxg:GridColumn FieldName="Product" FixedWidth="True" Width="100" />
                    <dxg:GridColumn FieldName="Supplier" FixedWidth="True" Width="120" />
                    <dxg:GridColumn FieldName="BogName" FixedWidth="True" Width="100" />
                    <dxg:GridColumn FieldName="DateWeightIn" Header="Weighed In Date" FixedWidth="True" Width="120">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="WeightIn" Header="Weight In (Kg)" FixedWidth="True" Width="100">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="DateWeightOut" Header="Weigh Out Date" FixedWidth="True" Width="120">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="WeightOut" Header="Weight Out (Kg)" FixedWidth="True" Width="100">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="NetWeight" Header="Net Weight (Kg)" FixedWidth="True" Width="100">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="SampleBoxWeight" Header="Sample Weight (Kg)" FixedWidth="True" Width="120">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>
                    <dxg:GridColumn FieldName="CubicM3" Header="Cubic M3" FixedWidth="True" Width="100">
                        <dxg:GridColumn.EditSettings>
                            <dxe:TextEditSettings HorizontalContentAlignment="Left" MaskType="Numeric" Mask="F2" MaskUseAsDisplayFormat="True" />
                        </dxg:GridColumn.EditSettings>
                    </dxg:GridColumn>


                </dxg:GridControl>
            </Grid>
        </Border>




    </Grid>
</UserControl>
