<admin:MetroWindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:admin="clr-namespace:Globeweigh.Admin"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.AddEditHaulierView" Title="{Binding HeaderText, FallbackValue=Add/Edit Haulier}"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="SingleBorderWindow" WindowTitleBrush="#FF3F3F46"
        Height="400" Width="650" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" 
        >

    <admin:MetroWindowBase.Resources>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>


    </admin:MetroWindowBase.Resources>

    <Border Margin="0" CornerRadius="3" Background="{DynamicResource LightGreyBrush}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Border >
                <TabControl Margin="10"  Background="Transparent">
                    <TabItem Header="General" IsSelected="True">
                        <Grid Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Content="Code" Style="{DynamicResource DefaultLabelStyle}" />
                                <TextBox Text="{Binding CurrentHaulier.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" Grid.Column="1" Margin="0" HorizontalAlignment="Left" Width="100" />
                                <Label Content="Name" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="1" />
                                <TextBox Text="{Binding CurrentHaulier.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="2" Grid.Column="1" Margin="0" Grid.ColumnSpan="2" Grid.Row="1" />
                                <Label Content="Intake Haulier" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="2" />
                                <CheckBox IsChecked="{Binding CurrentHaulier.IntakeHaulier,UpdateSourceTrigger=PropertyChanged}"  TabIndex="3" Grid.Column="1" Margin="0" Grid.ColumnSpan="2" Grid.Row="2" />

                            </Grid>

                        </Grid>
                    </TabItem>
                    <TabItem Header="Address">
                        <Grid Margin="0,10,0,0">

                            <Grid Grid.Row="1" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Content="Address Line 1" Style="{DynamicResource DefaultLabelStyle}" />
                                <TextBox
                                        Text="{Binding CurrentHaulier.AddressLine1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" Grid.Column="1" />
                                <Label Content="Address Line 2" Style="{DynamicResource DefaultLabelStyle}"
                                           Grid.Row="1" />
                                <TextBox
                                        Text="{Binding CurrentHaulier.AddressLine2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" Grid.Column="1" Grid.Row="1" />
                                <Label Content="Address Line 3" Style="{DynamicResource DefaultLabelStyle}"
                                           Grid.Row="2" />
                                <TextBox
                                        Text="{Binding CurrentHaulier.AddressLine3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" Grid.Column="1" Grid.Row="2" />
                                <Label Content="Address Line 4" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="3"
                                           Margin="0" />
                                <TextBox
                                        Text="{Binding CurrentHaulier.AddressLine4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" Grid.Column="1"
                                        Grid.Row="3" />
                                <Label Content="Address Line 5" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="4"
                                           Margin="0" />
                                <TextBox
                                        Text="{Binding CurrentHaulier.AddressLine5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" Grid.Column="1"
                                        Grid.Row="4" />
                            </Grid>


                        </Grid>
                    </TabItem>
                </TabControl>

            </Border>

            <Border Grid.Row="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Save" Width="100" Command="{Binding SaveCommand}"
                                Style="{DynamicResource TransactionButtonStyleAction}" />
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}"
                                Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</admin:MetroWindowBase>
