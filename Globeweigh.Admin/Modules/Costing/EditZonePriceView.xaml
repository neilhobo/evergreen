<admin:MetroWindowBase  
    	xmlns:admin="clr-namespace:Globeweigh.Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.EditZonePriceView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="SingleBorderWindow" WindowTitleBrush="#FF3F3F46"
        Height="350" Width="500" WindowStartupLocation="CenterScreen" WindowState="Normal" Title="{Binding HeaderText, FallbackValue=Edit Zone Price}"
        md:DialogServiceViews.IsRegistered="True" Background="{DynamicResource LightGreyBrush}">

    <admin:MetroWindowBase.Resources>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
    </admin:MetroWindowBase.Resources>

    <Border BorderThickness="3" CornerRadius="3" BorderBrush="White" Margin="6">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="Product" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="1" Margin="0,5"/>
                <Label Content="{Binding SelectedProduct.Description}" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Row="1" Margin="0,5" Grid.Column="1"/>
                <Label Content="Zone" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="2" Margin="0,5"/>
                <Label Content="{Binding SelectedZonePrice.Description}" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Row="2" Margin="0,5" Grid.Column="1"/>
                <Label Content="Price" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="3" Margin="0,5"/>
                <dxe:TextEdit EditValue="{Binding CurrentCostingZonePrice.Price, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextEditStyleWhite}" MaskType="Numeric"
              Mask="n2" TabIndex="1" HorizontalAlignment="Left" Width="70" Margin="0,5" Grid.Column="1" Grid.Row="3"/>
            </Grid>

            <Border Grid.Row="1" BorderThickness="0,3,0,0" BorderBrush="White">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save"  Width="100" Command="{Binding SaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</admin:MetroWindowBase>
