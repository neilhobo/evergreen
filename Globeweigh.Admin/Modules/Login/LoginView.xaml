<admin:MetroWindowBase  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
	xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
	xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
	xmlns:admin="clr-namespace:Globeweigh.Admin"
	x:Class="Globeweigh.Admin.LoginView" WindowStartupLocation="CenterScreen" 
    Title="Globeweigh Manager Login" Height="530" Width="700" WindowTitleBrush="#FF3F3F46"
    md:DialogServiceViews.IsRegistered="True" dx:ThemeManager.ThemeName="MetropolisLight">
    
    
    <Grid x:Name="ParentGrid" Margin="2" Background="#FFCDCDCD">
        <Grid x:Name="LayoutRoot" Background="White" Margin="3">
			<Border BorderThickness="1" Margin="0" Background="White">
				<StackPanel Margin="0,0,0,46" HorizontalAlignment="Center" VerticalAlignment="Center" Width="340" >
                    <!--<Image Width="160" Height="100" Source="/Globeweigh.Admin;component/Images/ClonakiltyLogo.png" Margin="0,0,0,20"/>-->
					<TextBlock Text="Sign in" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" Margin="0,0,0,14" FontSize="29.333" FontWeight="Light"/>
					<TextBlock Text="email address" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" Margin="0,0,0,4" FontSize="13.333" FontWeight="Light"/>
                    <dxe:TextEdit x:Name="txtEmail" EditValue="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FontSize="13.333" Margin="0,0,0,6" Height="32" VerticalContentAlignment="Center"/>
                    <TextBlock Text="password" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" Margin="0,0,0,4" FontSize="13.333" FontWeight="Light"/>
                    <dxe:PasswordBoxEdit x:Name="txtPassword" EditValue="{Binding Password, UpdateSourceTrigger=PropertyChanged}" FontSize="13.333" Margin="0,0,0,10" Height="32" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="chkSaveDetails" IsChecked="{Binding SaveDetailsChecked}" Margin="0,0,0,20" Content="save details" Foreground="#FF6C6C6C" FontSize="13.333" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
					<Button Content="Sign in" HorizontalAlignment="Left" Height="30" Width="70" Style="{DynamicResource TransactionButtonStyleAction}" Command="{Binding LoginCommand}" Background="#FF5A94F1" Foreground="White" BorderThickness="0" BorderBrush="{x:Null}"/>
				</StackPanel>
			</Border>
<!--            <dx:WaitIndicator x:Name="busyIndicator" dx:ThemeManager.ThemeName="MetropolisLight"/>-->
            
			
		</Grid>
	</Grid>
</admin:MetroWindowBase>
