<admin:MetroWindowBase  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
	xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
	xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
	xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
	xmlns:admin="clr-namespace:Globeweigh.Admin"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
	x:Class="Globeweigh.Admin.AboutView" WindowStartupLocation="CenterScreen" 
    Title="About" Height="460" Width="600" WindowTitleBrush="#FF3F3F46"
    md:DialogServiceViews.IsRegistered="True" dx:ThemeManager.ThemeName="MetropolisLight">


    <Grid x:Name="ParentGrid" Margin="2">
        <Grid x:Name="LayoutRoot" Background="{DynamicResource LightGreyBrush}" Margin="3">
            <Border BorderThickness="3" Margin="6" BorderBrush="White">
                <Grid>
                    <Border Margin="10" Background="White">
                        <Grid Margin="10">


                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border HorizontalAlignment="Left" Background="White" >
                                <Image x:Name="Image" Source="/Globeweigh.Admin;component/Images/GlobeweighLogo.png" Stretch="Uniform" Width="217.344" />

                            </Border>
                            <StackPanel Grid.Row="2" Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="Version: " HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" FontSize="13.333" FontWeight="Light"  Margin="0"/>
                                <TextBlock Text="{Binding CurrentVersion, FallbackValue=1.1}" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" FontSize="13.333" FontWeight="Light"  Margin="0"/>

                            </StackPanel>
                            <TextBlock Text="Globeweigh Factory Manager" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" FontSize="29.333" FontWeight="Light" Grid.Row="1" Margin="8,0,0,0"/>
                            <TextBlock Text="Copyright © Globeweigh UK Ltd" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" FontSize="13.333" FontWeight="Light" Grid.Row="3" Margin="8,0,0,0"/>
                            <TextBlock Text="Licenced to: Evergreen Horticulture" HorizontalAlignment="Left" Foreground="#FF6C6C6C" VerticalAlignment="Center" FontSize="13.333" FontWeight="Light" Grid.Row="4" Margin="8,0,0,0"/>
                            <Button Content="Close" HorizontalAlignment="Right" Height="30" Width="70" Style="{DynamicResource TransactionButtonStyleAction}" Command="{Binding CancelCommand}" Background="#FF5A94F1" Foreground="White" BorderThickness="0" BorderBrush="{x:Null}" VerticalAlignment="Bottom" Grid.Row="6" Margin="0,0,10,10" d:LayoutOverrides="Height"/>

                        </Grid>

                    </Border>

                    <!--<Image Width="160" Height="100" Source="/Globeweigh.Admin;component/Images/ClonakiltyLogo.png" Margin="0,0,0,20"/>-->

                </Grid>

            </Border>
            <!--            <dx:WaitIndicator x:Name="busyIndicator" dx:ThemeManager.ThemeName="MetropolisLight"/>-->


        </Grid>
    </Grid>
</admin:MetroWindowBase>
