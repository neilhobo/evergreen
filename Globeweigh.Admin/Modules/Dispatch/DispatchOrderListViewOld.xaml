<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.DispatchOrderListViewOld"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="1400"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding DispatchOrderListView, Source={StaticResource Locator}}" Background="{DynamicResource LightGreyBrush}">
    <UserControl.Resources>
        <ResourceDictionary>

            <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
            <converters:NullToVisibleConverter x:Key="NullToVisibilityConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
            <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
            <system:Boolean x:Key="True">True</system:Boolean>
            <system:Boolean x:Key="False">False</system:Boolean>

            <Style  TargetType="{x:Type dxg:RowControl}" >
                <Setter Property="Height" Value="24"></Setter>
            </Style>
            
            <DataTemplate x:Key="OrderAssignedCellTemplate">
                <Grid Visibility="{Binding RowData.Row.AssignedCount, Converter={StaticResource ZeroToCollapsedConverter}}">
                    <Image Source="/Globeweigh.Admin;component/Images/green-tick-square-48.png" Margin="0,1" Width="20"/>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="orderTypeCellTemplate">
                <Grid d:DesignWidth="90" d:DesignHeight="24">
                    <Border x:Name="bd" Background="#FF68AE76" Margin="4,2" CornerRadius="3">
                        <TextBlock x:Name="txt" Text="SALES" Foreground="White" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" FontFamily="Segoe UI Semibold"/>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding RowData.Row.OrderTypeId}" Value="1">
                        <Setter TargetName="bd" Property="Background" Value="#FFE79D00"/>
                        <Setter TargetName="txt" Property="Text" Value="TRANSFER"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="ViewCellTemplate">
                <TextBlock x:Name="txt" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" >
                    <Hyperlink Command="{Binding Path=Column.DataContext.ViewCommand}" CommandParameter="{Binding Path=Value}" TextDecorations="{x:Null}">
                        <TextBlock Text="View Order"/>
                    </Hyperlink>
                </TextBlock>
            </DataTemplate>



            <Style x:Key="FocusedCellStyle" TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                <Setter Property="Background" Value="White" />
                <Style.Triggers>
                    <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                        <Setter Property="Background" Value="White" />
                        <!--<Setter Property="Foreground" Value="Black" />-->
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="PrintTemplate">
                <TextBlock x:Name="txt" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" >
                    <Hyperlink Command="{Binding Path=Column.DataContext.PrintDeliveryDocketCommand}" TextDecorations="{x:Null}">
                        <TextBlock Text="Delivery Note"/>
                    </Hyperlink>
                </TextBlock>
            </DataTemplate>






        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid Margin="0" Grid.Row="1" >
            <Border BorderThickness="0" Grid.Row="1" Grid.ColumnSpan="3">
                <Grid  >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="453*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="0,0,14,0" >
                                <RadioButton x:Name="rdoOpen" Content="Open Orders" IsChecked="{Binding IsCompletedSelected, Converter={StaticResource RadioButtonCheckedConverter},ConverterParameter={StaticResource False}}" VerticalAlignment="Center" GroupName="x" Margin="0,0,10,0"/>
                                <RadioButton x:Name="rdoComplete" Content="Completed Orders" IsChecked="{Binding IsCompletedSelected, Converter={StaticResource RadioButtonCheckedConverter},ConverterParameter={StaticResource True}}" VerticalAlignment="Center" GroupName="x" Margin="10,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="{Binding ElementName=rdoComplete, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}" HorizontalAlignment="Right">
                                <Label Content="Date From:" VerticalAlignment="Center" Style="{DynamicResource DefaultLabelStyle}"/>
                                <dxe:DateEdit EditValue="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="90" Margin="14,0,0,0"/>
                                <Label Content="Date To:" VerticalAlignment="Center" Grid.Column="2" Margin="20,0,0,0" Style="{DynamicResource DefaultLabelStyle}"/>
                                <dxe:DateEdit EditValue="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}" VerticalAlignment="Center" HorizontalAlignment="Left" Width="90" Margin="14,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="3" >
                                <controls:ImageButton Content="Add Sales Order"  Command="{Binding CreateDispatchOrderCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <controls:ImageButton Content="Add Transfer"  Command="{Binding AddTransferOrderCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <!--<controls:ImageButton Content="Auto Pick"  Command="{Binding AutoPickCommand}"  IsEnabled="{Binding SelectedItems.Count, ElementName=grdDispatchOrders}" Style="{DynamicResource ToolbarButtonStyle}"/>-->
                                <controls:ImageButton Content="Edit"  Command="{Binding EditDispatchOrderCommand}"  IsEnabled="{Binding SelectedItems.Count, ElementName=grdDispatchOrders}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                <controls:ImageButton Content="Delete"  Command="{Binding DeleteDispatchOrderCommand}"  Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <controls:ImageButton Content="Complete"  Visibility="{Binding ElementName=rdoOpen, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}" Command="{Binding CompleteDispatchOrderCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdDispatchOrders}"  Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <controls:ImageButton Content="Un-Complete"  Visibility="{Binding ElementName=rdoComplete, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}" Command="{Binding UnCompleteDispatchOrderCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdDispatchOrders}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <controls:ImageButton Content="Refresh" Margin="2,0,0,0"  Command="{Binding RefreshCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>

                            </StackPanel>
                        </Grid>
                    </Border>
                    <dxg:GridControl x:Name="grdDispatchOrders" ItemsSource="{Binding DispatchOrderList}" SelectedItems="{Binding SelectedDispatchOrders}" ShowLoadingPanel="{Binding IsBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"  SelectedItem="{Binding SelectedDispatchOrder}" Margin="0,10,0,0" Grid.Row="1" SelectionMode="Row">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvDispatchOrders">
                                <dxmvvm:Interaction.Behaviors>
                                    <dxmvvm:EventToCommand PassEventArgsToCommand="False" Command="{Binding EditDispatchOrderCommand}" EventName="RowDoubleClick"/>
                                </dxmvvm:Interaction.Behaviors>
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="OrderTypeId" Header="Order Type" Width="76" FixedWidth="True" CellTemplate="{StaticResource orderTypeCellTemplate}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Center"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="OrderNoDisplay" Header="Order No" FixedWidth="True"  Width="90">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                            <dxg:GridColumn FieldName="CustomerName"  Header="Customer" FixedWidth="True"  Width="200"/>
                            <dxg:GridColumn FieldName="CustomerRef"  Header="Customer Ref" FixedWidth="True"  Width="90"/>
                            <dxg:GridColumn FieldName="HaulierName"  Header="Haulier" FixedWidth="True"  Width="130"/>
                            <!--<dxg:GridColumn FieldName="VehicleReg"  FixedWidth="True"  Width="80"/>-->
                            <dxg:GridColumn FieldName="AddressFull" Header="Address" />
                            <dxg:GridColumn FieldName="DeliveryDate" FixedWidth="True"  Width="100">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="PercentagePickedDecimal" Header="Picking Progress" FixedWidth="True" Width="100" Visible="{Binding ElementName=rdoOpen, Path=IsChecked}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:ProgressBarEditSettings Maximum="1" Minimum="0" ContentDisplayMode="Value" DisplayFormat="p0" HorizontalContentAlignment="Center"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn Header="Assigned" HorizontalHeaderContentAlignment="Center" FixedWidth="True" Width="70" CellTemplate="{DynamicResource OrderAssignedCellTemplate}" />
                            <dxg:GridColumn FieldName="Comments"  Header="Comments" />

                            <dxg:GridColumn FieldName="DateDispatched" Width="70" Visible="{Binding ElementName=rdoComplete, Path=IsChecked}">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="id" Width="90" Header=" " FixedWidth="True" AllowEditing="False" CellTemplate="{StaticResource PrintTemplate}" CellStyle="{DynamicResource FocusedCellStyle}"/>
                            <dxg:GridColumn FieldName="id" Width="90" Header=" " FixedWidth="True" AllowEditing="False" CellTemplate="{StaticResource ViewCellTemplate}" CellStyle="{DynamicResource FocusedCellStyle}"/>

                        </dxg:GridControl.Columns>


                    </dxg:GridControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
