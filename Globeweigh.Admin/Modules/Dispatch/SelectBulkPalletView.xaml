<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.SelectBulkPalletView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="790" Width="1200" WindowStartupLocation="CenterOwner" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White"
        dx:ThemeManager.ThemeName="MetropolisLight">

    <shared:WindowBase.Resources>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        


        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>
        <converters:NullToFalseConverter x:Key="NullToFalseConverter"/>

        <Style TargetType="{x:Type dxg:RowControl}" >
            <Setter Property="Height" Value="24"></Setter>
        </Style>
        
        <Style x:Key="rowStyle" TargetType="{x:Type dxg:RowControl}" >
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Row.IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="Green" />
                </DataTrigger>
                <!--<DataTrigger Binding="{Binding Row.OnHold}" Value="True" >
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>-->
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="selectCellTemplate">
            <dxe:CheckEdit IsChecked="{Binding Path=RowData.Row.IsSelected}" IsReadOnly="{Binding Path=RowData.Row.OnHold}" HorizontalAlignment="Center" VerticalAlignment="Center"></dxe:CheckEdit>
        </DataTemplate>




    </shared:WindowBase.Resources>
    <Border Margin="0" CornerRadius="3" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" >
                <Grid Margin="0">
                    <TextBlock Text="{Binding HeaderText}" Style="{DynamicResource TransactionHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" >

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <Grid Margin="0,10,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="227*"/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0" BorderBrush="#FFB9B9B9" Background="{DynamicResource MainContentGrey}" Margin="0,0,0,4">
                        <TextBlock Text="Product List" Style="{DynamicResource HeaderTextBlockStyle}" Margin="6,0,0,0" Foreground="{DynamicResource GlobeweighBlueBrush}" FontSize="14" FontFamily="Segoe UI Semibold"/>
                    </Border>
                    <Border BorderThickness="0" BorderBrush="{DynamicResource MainBorderBrush}" Grid.Row="1" >
                        <dxg:GridControl x:Name="grdProducts" ItemsSource="{Binding SummaryList}" SelectedItem="{Binding SelectedSummary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0" Grid.Row="1" >
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvProducts"  ShowSearchPanelMode="Never"  ShowGroupPanel="False" 
                                                   ShowAutoFilterRow="True" NavigationStyle="Row" ShowFixedTotalSummary="True" BestFitMode="Smart" AutoWidth="True" AllowBestFit="True"/>
                            </dxg:GridControl.View>
                            <!--<dxg:GridColumn FieldName="Code" Width="100" FixedWidth="True"/>-->
                            <dxg:GridColumn FieldName="ProductName"  Header="Product"  />
                            <dxg:GridColumn FieldName="Size" Width="60" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="Upp"  Header="UPP" Width="60" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="PalletCount" Width="90" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TotalUnits" Width="90" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>

                        </dxg:GridControl>
                    </Border>
                </Grid>

                <Border Background="White" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" Grid.Column="1" Visibility="{Binding SelectedLocation, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid Margin="0,10,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0" BorderBrush="#FFB9B9B9" Margin="0,0,0,4" Background="{DynamicResource MainContentGrey}">
                            <TextBlock Text="Pallet List" Style="{DynamicResource HeaderTextBlockStyle}" Margin="6,0,0,0" Foreground="{DynamicResource GlobeweighBlueBrush}" FontSize="14" FontFamily="Segoe UI Semibold"/>
                        </Border>
                        <dxg:GridControl x:Name="grdPallets" ItemsSource="{Binding PalletList}" SelectedItem="{Binding SelectedPallet}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0" Grid.Row="1" >
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvPallets"  ShowSearchPanelMode="Never" RowStyle="{DynamicResource rowStyle}" ShowGroupPanel="False" 
                                                   ShowAutoFilterRow="True" NavigationStyle="Row" ShowFixedTotalSummary="True" BestFitMode="Smart" AutoWidth="True" AllowBestFit="True"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="IsSelected" Width="60"  Header="Selected" FixedWidth="True" AllowEditing="True" CellTemplate="{DynamicResource selectCellTemplate}"/>
                            <dxg:GridColumn FieldName="PalletNo">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="LocationDisplay" Header="Location" />
                            <dxg:GridColumn FieldName="DateOfProduction" Header="Production Date" Width="140" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridControl.TotalSummary>
                                <dxg:GridSummaryItem SummaryType="Count" Alignment="Right" />
                            </dxg:GridControl.TotalSummary>

                        </dxg:GridControl>
                    </Grid>
                </Border>

                <Grid Margin="0,10,10,10" Grid.Column="2" Visibility="{Binding SelectedLocation, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="227*"/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0" BorderBrush="#FFB9B9B9" Background="{DynamicResource MainContentGrey}" Margin="0,0,0,4">
                        <!--<TextBlock Text="Enter Quantity" Style="{DynamicResource HeaderTextBlockStyle}" Margin="6,0,0,0" Foreground="{DynamicResource GlobeweighBlueBrush}" FontSize="14" FontFamily="Segoe UI Semibold"/>-->
                    </Border>
                    <Border BorderThickness="0" Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" Grid.Row="1" >
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Label Content="Quantity to Add:" Style="{DynamicResource DefaultLabelStyle}"/>
                            <dxe:TextEdit x:Name="txtQuantity" Grid.Row="1" EditValue="{Binding QuantityToAdd, UpdateSourceTrigger=PropertyChanged}" AllowNullInput="True" VerticalAlignment="Center" Style="{DynamicResource DefaultTextEditStyle}" Background="White"/>
                            <Button Grid.Row="2"  Style="{DynamicResource ToolbarButtonStyleAction}" Command="{Binding SelectPalletsCommand}" IsEnabled="{Binding ElementName=txtQuantity, Path=Text, Converter={StaticResource NullToFalseConverter}}" Content="Select Pallets" Margin="0,0,10,0" HorizontalAlignment="Left" Width="120"/>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>

            <Border Grid.Row="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Select"  Width="100" Command="{Binding SelectCommand}" Style="{DynamicResource TransactionButtonStyleAction}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>

