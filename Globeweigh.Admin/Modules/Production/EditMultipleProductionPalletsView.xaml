<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:model="clr-namespace:Globeweigh.Model;assembly=Globeweigh.Model"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:helpers="clr-namespace:Globeweigh.Model.Helpers;assembly=Globeweigh.Model"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        xmlns:helpers1="clr-namespace:Globeweigh.Shared.Helpers;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.EditMultipleProductionPalletsView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="400" Width="600" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White"
        >

    <Window.Resources>

        <converters:IsFactoryUserToCollapsedConverter x:Key="IsFactoryUserToCollapsedConverter"/>


    </Window.Resources>

    <Border Margin="0" CornerRadius="3" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="{Binding HeaderText, FallbackValue=Edit Multiple Pallets}" Style="{DynamicResource TransactionHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <Grid x:Name="ControlsGrid" Grid.RowSpan="2" Grid.Row="1" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!--<TextBlock Text="Pallet No" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,0,20"/>
                        <TextBlock Text="{Binding CurrentPallet.PalletNo}" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,0,20" Grid.Column="1"/>-->
                    <Label Content="Production Date" Style="{DynamicResource DefaultLabelStyle}" Margin="0,5" Grid.Row="1"/>
                    <dxe:DateEdit EditValue="{Binding DateOfProduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyle}" Margin="0,5" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Width="150"/>
                </Grid>

            </Border>

            <Border Grid.Row="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save"  Width="100" Command="{Binding SaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>
