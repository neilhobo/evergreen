<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.ProductionSummaryView"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1500"
             shared:ViewModelBehavior.LoadUnload="True" Background="{DynamicResource LightGreyBrush}"
             DataContext="{Binding ProductionSummaryView, Source={StaticResource Locator}}">
    <UserControl.Resources>

            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            
    </UserControl.Resources>
    <Grid Margin="10,5,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="650"/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border>
            <Grid  >
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MainBorderBrush}">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="0">
                            <Label Content="Date From:" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13"/>
                            <dxe:DateEdit  EditValue="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}"  Width="90" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Label Content="Date To:" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Margin="10,0,0,0"/>
                            <dxe:DateEdit  EditValue="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}"  Width="90" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button Content="Search"  Command="{Binding RefreshCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"  Margin="10,0,0,0" />
                            <CheckBox x:Name="chkGroupByLine" Content="Group by Line"  IsChecked="{Binding GroupByLine, UpdateSourceTrigger=PropertyChanged}" Margin="20,0,0,0" />
                        </StackPanel>
               
                    </Grid>
                </Border>
                <dxg:GridControl x:Name="grdSummary" ItemsSource="{Binding ProductList}" SelectedItem="{Binding SelectedProduct}" ShowLoadingPanel="{Binding IsBusy}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"   Margin="0,20,0,0" Grid.Row="1" >
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tvItems" NavigationStyle="Row" ShowTotalSummary="True">
                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="LineNumber" Header="Line No" Width="50" FixedWidth="True" Visible="{Binding ElementName=chkGroupByLine, Path=IsChecked}">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Gtin" Width="120" FixedWidth="True" Header="Evergreen Code" />
                        <dxg:GridColumn FieldName="Description"  Header="Product" />
                        <dxg:GridColumn FieldName="Size" Width="60" FixedWidth="True" />
                        <dxg:GridColumn FieldName="Upp" Width="60" FixedWidth="True" Header="UPP" />
                        <dxg:GridColumn FieldName="RecordCount" Header="No. Of Pallets" Width="90" FixedWidth="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="BagCount" Width="90" FixedWidth="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.TotalSummary>
                        <!-- Total Pallets -->
                        <dxg:GridSummaryItem FieldName="RecordCount"
                         SummaryType="Sum"
                         ShowInColumn="RecordCount"
                         DisplayFormat="{}{0:n0}" />

                        <!-- Total Bags -->
                        <dxg:GridSummaryItem FieldName="BagCount"
                         SummaryType="Sum"
                         ShowInColumn="BagCount"
                         DisplayFormat="{}{0:n0}" />

                        <!-- Optional row count -->
                        <dxg:GridSummaryItem SummaryType="Count"
                         Alignment="Right" />

                    </dxg:GridControl.TotalSummary>

                </dxg:GridControl>
                <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0,1,1" Grid.Row="2" Margin="0" Height="40"/>
            </Grid>
        </Border>
        <!--<Grid Margin="6,0,0,0" Grid.Column="1" Visibility="{Binding SelectedProduct, Converter={StaticResource NullToCollapsedConverter}}">
            <Border>
                <Grid  >
                    <Grid.RowDefinitions>
