                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="0">
                                <Label Content="Stock History" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13"/>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"  HorizontalAlignment="Right" Grid.Column="3" >
                                --><!--<Button Content="Add Pallets"  Command="{Binding AddPalletsCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <Button Content="Edit"  Command="{Binding EditCommand}" IsEnabled="{Binding ElementName=grdIntakes, Path=SelectedItems.Count}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <Button Content="Delete"  Command="{Binding DeleteCommand}" IsEnabled="{Binding ElementName=grdIntakes, Path=SelectedItems.Count}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <Button Content="Print / Export" Margin="2,0,0,0"  Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvItems}" IsEnabled="{Binding VisibleRowCount, ElementName=grdIntakes}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>--><!--

                            </StackPanel>
                        </Grid>
                    </Border>
                    <dxg:GridControl x:Name="grdHistory" ItemsSource="{Binding HistoryList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"  Margin="0,20,0,0" Grid.Row="1" >
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvHistory" NavigationStyle="None">
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="Quantity" Width="90" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="TransactionType" Header="Type" Width="120" FixedWidth="True" />
                            <dxg:GridColumn FieldName="DateCreated" Header="Date of Transaction" >
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                        </dxg:GridControl.Columns>


                    </dxg:GridControl>
                    <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0,1,1" Grid.Row="2" Margin="0" Height="40"/>
                </Grid>
            </Border>
        </Grid>-->
    </Grid>
</UserControl>
