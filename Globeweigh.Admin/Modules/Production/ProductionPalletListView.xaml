<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.ProductionPalletListView"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1500"
             shared:ViewModelBehavior.LoadUnload="True" Background="{DynamicResource LightGreyBrush}"
             DataContext="{Binding ProductionPalletListView, Source={StaticResource Locator}}">
    <UserControl.Resources>
        <ResourceDictionary>

            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>

            <Style  TargetType="{x:Type dxg:RowControl}" >
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Row.IsDuplicate}" Value="True" >
                        <Setter Property="Background" Value="#FFFFDF68"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10,5,10,10">
        <Grid Margin="0"  >

            <Border>
                <Grid  >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MainBorderBrush}">
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="0">
                                <Label Content="Date From:" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13"/>
                                <dxe:DateEdit  EditValue="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}"  Width="90" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <Label Content="Date To:" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Margin="10,0,0,0"/>
                                <dxe:DateEdit  EditValue="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultDateEditStyleWhite}"  Width="90" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <Button Content="Search"  Command="{Binding RefreshCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"  Margin="10,0,0,0" />

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"  HorizontalAlignment="Right" Grid.Column="3" >
            
                            </StackPanel>
                        </Grid>
                    </Border>
                    <dxg:GridControl x:Name="grdIntakes" ItemsSource="{Binding PalletList}" ShowLoadingPanel="{Binding IsBusy}" SelectedItems="{Binding SelectedPallets}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedPallet}" Margin="0,20,0,0" Grid.Row="1" >
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvItems" >
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridControl.Columns>
                            <dxg:GridColumn FieldName="UniqueCode" Width="90" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="LineNumber" Header="Line No" Width="50" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="CodicoCode" Width="120" FixedWidth="True" Header="Codico Code" />
                            <dxg:GridColumn FieldName="Gtin" Width="120" FixedWidth="True" Header="Evergreen Code" />
                            <dxg:GridColumn FieldName="Description"  Header="Product" Width="250" FixedWidth="True"/>
                            <dxg:GridColumn FieldName="Size" Width="60" FixedWidth="True" />
                            <dxg:GridColumn FieldName="Upp" Width="60" FixedWidth="True" Header="UPP" />
                            <dxg:GridColumn FieldName="Weight" Width="80" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="DateCreated" Header="Production Date" Width="140" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="IsScanned" Width="60" FixedWidth="True" Header="Scanned" />
                            <!--<dxg:GridColumn FieldName="LocationName" Header="Location" Width="80" FixedWidth="True"  />-->
                            <dxg:GridColumn Header=" "/>

                            <!--<dxg:GridColumn FieldName="DispatchOrderNo" Width="120" FixedWidth="True"/>-->
                        </dxg:GridControl.Columns>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem SummaryType="Count" Alignment="Right" />
                            </dxg:GridControl.TotalSummary>

                    </dxg:GridControl>
                    <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0,1,1" Grid.Row="2" Margin="0" Height="40">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <!--<Border Width="16" Height="16" Background="Green" VerticalAlignment="Center" CornerRadius="5" Margin="0,0,10,0">
                                </Border>
                                <TextBlock Text="Dispatched"  VerticalAlignment="Center" Margin="0" Foreground="{DynamicResource IsSelectedGreyBrush}"/>-->
                                <Border Width="16" Height="16" Background="#FFFFDF68" VerticalAlignment="Center" CornerRadius="5" Margin="20,0,10,0">
                                </Border>
                                <TextBlock Text="Duplicate"  VerticalAlignment="Center" Margin="0" Foreground="{DynamicResource IsSelectedGreyBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="Count="  VerticalAlignment="Center" Margin="0" Foreground="{DynamicResource IsSelectedGreyBrush}"/>
                                <TextBlock Text="{Binding ElementName=grdIntakes, Path=VisibleRowCount}"  VerticalAlignment="Center" Margin="0" Foreground="{DynamicResource IsSelectedGreyBrush}"/>
                            </StackPanel>
                    
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
