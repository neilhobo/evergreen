<admin:MetroWindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:admin="clr-namespace:Globeweigh.Admin"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.EditWeighbrideRecordView" Title="{Binding HeaderText, FallbackValue=Edit}"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="SingleBorderWindow" WindowTitleBrush="#FF3F3F46"
        Height="500" Width="500" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White">

    <admin:MetroWindowBase.Resources>


        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>
        <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <system:Boolean x:Key="True">True</system:Boolean>
        <system:Boolean x:Key="False">False</system:Boolean>


    </admin:MetroWindowBase.Resources>


    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid Margin="0" Grid.Row="1" Background="{DynamicResource MainContentGrey}">
            <Border Margin="4,4,4,0" BorderThickness="3" BorderBrush="White">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="10,10,10,0" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!--<StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0" Grid.ColumnSpan="2" >
                                <RadioButton x:Name="rdoIncoming" Content="Incoming" IsChecked="{Binding CurrentWeighbridgeRecord.IsOutgoing, ConverterParameter={StaticResource False}, Converter={StaticResource RadioButtonCheckedConverter}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="rdoOutgoing" Content="Outgoing" IsChecked="{Binding CurrentWeighbridgeRecord.IsOutgoing, ConverterParameter={StaticResource True}, Converter={StaticResource RadioButtonCheckedConverter},UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </StackPanel>-->
                        <TextBlock Text="Haulier:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="1" />
                        <dxe:ComboBoxEdit x:Name="cboHauliers" Grid.Row="1" ItemsSource="{Binding HaulierList}" Background="White" EditValue="{Binding CurrentWeighbridgeRecord.HaulierId, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" ShowError="False" AutoComplete="True" SelectedItem="{Binding SelectedHaulier}" DisplayMember="Name" IsEnabled="{Binding IsOutgoing, Converter={StaticResource TrueToFalseConverter}}" Foreground="Black" ValueMember="id" Grid.Column="1" VerticalAlignment="Center" Height="Auto" Margin="0,4" />
                        <TextBlock Text="Vehicle Reg:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="2" />
                        <TextBox Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBoxStyle}" Background="White"  Text="{Binding CurrentWeighbridgeRecord.VehicleReg, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120" Margin="0,4"/>
                        <TextBlock Text="Docket Number:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="3" />
                        <TextBox Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBoxStyle}" Background="White"  Text="{Binding CurrentWeighbridgeRecord.DocketNumber, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120" Margin="0,4"/>
                        <TextBlock Text="Product:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="5" />
                        <dxe:ComboBoxEdit  Grid.Row="5" ItemsSource="{Binding ProductList}" Background="White" EditValue="{Binding CurrentWeighbridgeRecord.Product, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" 
                                           ShowError="False" AutoComplete="True" DisplayMember="Description"  SelectedItem="{Binding SelectedProduct}"
                                           ValueMember="Description" Grid.Column="1" VerticalAlignment="Center" Height="Auto" Margin="0,4" />
                        <TextBlock Text="Supplier:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="6" />
                        <dxe:ComboBoxEdit  Grid.Row="6" ItemsSource="{Binding ProductSupplierList}" Background="White" EditValue="{Binding CurrentWeighbridgeRecord.Supplier, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" 
                                           ShowError="False" AutoComplete="True" DisplayMember="Name"  SelectedItem="{Binding SelectedProductSupplier}"
                                           ValueMember="Name" Grid.Column="1" VerticalAlignment="Center" Height="Auto" Margin="0,4" />
                        <TextBlock Text="Bog:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="7" />
                        <dxe:ComboBoxEdit  Grid.Row="7" ItemsSource="{Binding BogList}" Background="White" EditValue="{Binding CurrentWeighbridgeRecord.BogName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" 
                                           ShowError="False" AutoComplete="True" DisplayMember="Name" 
                                           ValueMember="Name" Grid.Column="1" VerticalAlignment="Center" Height="Auto" Margin="0,4" />
                        <TextBlock Text="Incoming Weight:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="8" Visibility="{Binding CurrentWeighbridgeRecord.DateWeightIn, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <dxe:TextEdit EditValue="{Binding CurrentWeighbridgeRecord.WeightIn, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextEditStyle}"  Background="White"  Grid.Column="2" HorizontalAlignment="Left" Width="80" VerticalAlignment="Center" Margin="0,4" Grid.Row="8"/>
                        <TextBlock Text="Outgoing Weight:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="9" />
                        <dxe:TextEdit EditValue="{Binding CurrentWeighbridgeRecord.WeightOut, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextEditStyle}" Background="White"  Grid.Column="2" HorizontalAlignment="Left" Width="80" VerticalAlignment="Center" Margin="0,4" Grid.Row="9"/>

                        <dxe:TextEdit EditValue="{Binding CurrentWeighbridgeRecord.SampleBoxWeight, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextEditStyleWhite}" MaskType="Numeric"
              Mask="n2" TabIndex="1" HorizontalAlignment="Left" Width="70" Margin="0,5" Grid.Column="1" Grid.Row="10"/>
                        <TextBlock Text="Sample Weight:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0,4"  Grid.Row="10" />
                        <TextBlock Text="Comments:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0,4"  Grid.Row="11" />
                        <TextBox Margin="0,0,0,18" Text="{Binding CurrentWeighbridgeRecord.Comments}" Style="{DynamicResource DefaultMultilineTextBoxStyle}" Background="White" AcceptsReturn="True" HorizontalAlignment="Stretch" VerticalContentAlignment="Top" VerticalAlignment="Stretch" Grid.Row="12" Grid.ColumnSpan="2"/>
                    </Grid>

                </Grid>

            </Border>

        </Grid>

        <Border Grid.Row="2">
            <Grid>
                <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Save"  Width="100" Command="{Binding EditSaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}" Visibility="{Binding InEditMode, Converter={StaticResource TrueToVisibilityConverter}}" />
                    <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</admin:MetroWindowBase>



