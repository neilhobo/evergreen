                                            </Grid.ColumnDefinitions>
                                            <Ellipse Fill="#FF00E000" Visibility="{Binding GateOpen, Converter={StaticResource TrueToVisibilityConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Stroke="White" StrokeThickness="3"/>
