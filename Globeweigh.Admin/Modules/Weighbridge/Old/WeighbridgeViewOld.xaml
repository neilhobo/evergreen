                                        <Button Grid.Column="1" Command="{Binding BarrierCommand}" Width="80" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButtonStyleAction}">
                                                    <Setter Property="Content" Value="Open"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BarrierOpen}" Value="True">
                                                            <Setter Property="Content" Value="Close"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
