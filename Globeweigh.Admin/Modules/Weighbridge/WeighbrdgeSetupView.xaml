<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.WeighbridgeSetupView"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True"
             dx:ThemeManager.ThemeName="MetropolisLight"
             Background="{DynamicResource MainContentGrey}"
    DataContext="{Binding WeighbridgeSetupView, Source={StaticResource Locator}}">
    <UserControl.Resources>
        <ResourceDictionary>

            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:NullToVisibleConverter x:Key="NullToVisibleConverter"/>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Width="800" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="37*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0" Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderThickness="0" Grid.Row="1">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="453*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,1">
                        <Grid Margin="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Hauliers" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="18,0,0,0" FontSize="20"  />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1" >
                                <Button Content="Add" Command="{Binding AddHaulierCommand}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                <Button Content="Delete"  Command="{Binding DeleteHaulierCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdHauliers}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                <Button Content="Edit"  Command="{Binding EditHaulierCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdHauliers}" Style="{DynamicResource ToolbarButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <dxg:GridControl x:Name="grdHauliers" ItemsSource="{Binding HaulierList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                     SelectedItem="{Binding SelectedHaulier}" Grid.Row="1" Margin="2" ShowBorder="False">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvHauliers" AllowPerPixelScrolling="True" ShowColumnHeaders="True"  AutoWidth="True" AllowSorting="False" ShowGroupPanel="False" ShowIndicator="True" Margin="0" NavigationStyle="Row"/>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="DisplayName" Header="Haulier Name"/>

                    </dxg:GridControl>
                </Grid>
            </Border>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0,0,0" Margin="0" Grid.Column="1"/>
            <Grid Visibility="{Binding SelectedHaulier, Converter={StaticResource NullToCollapsedConverter}}" Margin="0" Grid.Column="2">
                <Border BorderThickness="0" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="453*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,1">
                            <Grid Margin="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vehicles" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="18,0,0,0" FontSize="20"  />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1" >
                                    <Button Content="Add"  Command="{Binding AddVehicleCommand}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                    <Button Content="Delete"  Command="{Binding DeleteVehicleCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdVehicles}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                    <Button Content="Edit"  Command="{Binding EditVehicleCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdVehicles}" Style="{DynamicResource ToolbarButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <dxg:GridControl x:Name="grdVehicles" ItemsSource="{Binding VehicleList}" ShowBorder="False"  
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding SelectedVehicle}" Margin="2" Grid.Row="1">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvVehicles" AllowPerPixelScrolling="True" AllowSorting="False" ShowColumnHeaders="True" ShowGroupPanel="False" ShowIndicator="True" AutoWidth="True" NavigationStyle="Row" />
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="DisplayName" Header="Vehicle Name" Width="80"/>
                        </dxg:GridControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
