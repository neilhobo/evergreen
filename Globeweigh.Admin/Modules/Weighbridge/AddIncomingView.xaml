<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.AddIncomingView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="560" Width="800" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White">

    <shared:WindowBase.Resources>


        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>
        <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <system:Boolean x:Key="True">True</system:Boolean>
        <system:Boolean x:Key="False">False</system:Boolean>


    </shared:WindowBase.Resources>

    <Border Margin="0" CornerRadius="3" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="{Binding HeaderText, FallbackValue=Header Text}" Style="{DynamicResource TransactionHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1" BorderThickness="0,0,0,4" Background="{DynamicResource LightGreyBrush}">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Margin="4,4,0,4" BorderThickness="3" BorderBrush="White">
                        <Grid Margin="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="White" BorderThickness="0,0,0,4">
                                <Grid Margin="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weigh Record" Style="{DynamicResource DefaultTextBlockContentStyle}" FontFamily="Segoe UI Semibold" Margin="5,0,0,0"  />
                                </Grid>
                            </Border>
                            <Grid Margin="10,10,10,0" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Weight Date:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  />
                                <TextBlock Text="{Binding CurrentWeighbridgeRecord.PendingWeighDate, StringFormat=dd/MM/yy HH:mm}" Padding="0" Style="{DynamicResource DefaultTextBlockContentStyle}" Margin="0"  Grid.Column="1" />
                                <TextBlock Text="Haulier:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="1" />
                                <dxe:ComboBoxEdit x:Name="cboHauliers" Grid.Row="1" ItemsSource="{Binding HaulierList}" EditValue="{Binding CurrentWeighbridgeRecord.HaulierId, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" Background="White" ShowError="False" AutoComplete="True" SelectedItem="{Binding SelectedHaulier}" DisplayMember="Name" Foreground="Black" ValueMember="id" Grid.Column="1" VerticalAlignment="Center" Height="28" />
                                <TextBlock Text="Vehicle Reg:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="2" />
                                <TextBox Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBoxStyle}" Background="White" Text="{Binding CurrentWeighbridgeRecord.VehicleReg, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120"/>
                                <TextBlock Text="Trailer No:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="3" />
                                <dxe:TextEdit EditValue="{Binding CurrentWeighbridgeRecord.TrailerNo, UpdateSourceTrigger=PropertyChanged}" Background="White" Style="{DynamicResource DefaultTextEditStyle}"  
                                                       Grid.Column="2" HorizontalAlignment="Left" Width="120" VerticalAlignment="Center" Margin="0" Grid.Row="3"/>
                                <!--<TextBlock Text="Sample Box Weight:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="3" />
                                <dxe:TextEdit EditValue="{Binding CurrentWeighbridgeRecord.SampleBoxWeight, UpdateSourceTrigger=PropertyChanged}" Background="White" Style="{DynamicResource DefaultTextEditStyle}" dxe:NumericMaskOptions.AlwaysShowDecimalSeparator="False"  EditValueType="{x:Type system:Decimal}" Mask="N2"
                                                      MaskType="Numeric" AllowNullInput="True" Grid.Column="2" HorizontalAlignment="Left" Width="80" VerticalAlignment="Center" Margin="0" Grid.Row="3"/>-->

                                <TextBlock Text="Comments:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="4" />
                                <TextBox Margin="0,0,0,18" Text="{Binding CurrentWeighbridgeRecord.Comments}" Style="{DynamicResource DefaultMultilineTextBoxStyle}" Background="White"  AcceptsReturn="True" HorizontalAlignment="Stretch" VerticalContentAlignment="Top" VerticalAlignment="Stretch" Grid.Row="5" Grid.ColumnSpan="2"/>
                            </Grid>

                        </Grid>

                    </Border>
                    <Border Grid.Column="2" BorderBrush="White" BorderThickness="3" Margin="4">

                        <Grid x:Name="BoxLabelGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="160"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="White" BorderThickness="0,0,0,3">
                                <Grid Margin="0,4,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Weight" Style="{DynamicResource DefaultTextBlockContentStyle}" Margin="5,0,0,0" HorizontalAlignment="Left"  />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Grid.Column="1" Margin="0,0,14,0" >
                                        <RadioButton x:Name="rdoAuto" Content="Auto" IsChecked="{Binding IsManual, ConverterParameter={StaticResource False}, Converter={StaticResource RadioButtonCheckedConverter}}" VerticalAlignment="Center" GroupName="x" Margin="0,0,10,0"/>
                                        <RadioButton x:Name="rdoManual" Content="Manual" IsChecked="{Binding IsManual, ConverterParameter={StaticResource True}, Converter={StaticResource RadioButtonCheckedConverter}}" VerticalAlignment="Center" GroupName="x" Margin="0,0,10,0"/>
                                    </StackPanel>


                                </Grid>

                            </Border>
                            <Grid Grid.Row="1" >
                                <Grid Background="#FF424242" Margin="20" d:IsHidden="True" Visibility="{Binding IsChecked, Converter={StaticResource TrueToVisibilityConverter}, ElementName=rdoAuto}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <dxga:DigitalGaugeControl Text="{Binding LiveWeight}" Margin="0,10" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <dxga:SevenSegmentsView>
                                            <dxga:SevenSegmentsView.Presentation>
                                                <dxga:DefaultSevenSegmentsPresentation FillActive="#FF43E64A" FillInactive="#0F555555" />
                                            </dxga:SevenSegmentsView.Presentation>
                                        </dxga:SevenSegmentsView>
                                    </dxga:DigitalGaugeControl>
                                    <TextBlock Text="Kg" Grid.Column="1" FontSize="50" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Background="#FF424242" Margin="20" Visibility="{Binding IsChecked, Converter={StaticResource TrueToVisibilityConverter}, ElementName=rdoManual}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Margin="20" Text="{Binding ManualWeight, UpdateSourceTrigger=PropertyChanged}"  VerticalContentAlignment="Center" FontSize="48" TextAlignment="Right" PreviewTextInput="NumberValidationTextBox"/>
                                    <TextBlock Text="Kg" Grid.Column="1" FontSize="50" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="White" FontFamily="Segoe UI Semibold" HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                            <Border Grid.Row="2" BorderBrush="White" BorderThickness="0,3,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <!--<Grid Visibility="{Binding RelayTcpConnection, Converter={StaticResource NullToCollapsedConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Gate:" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBlockContentStyle}" FontSize="16" Margin="50,0,0,0"/>
                                            <Button Grid.Column="1" Command="{Binding GateCommand}" Width="80">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TransactionButtonStyleAction}">
                                                        <Setter Property="Content" Value="Open"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GateOpen}" Value="True">
                                                                <Setter Property="Content" Value="Close"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Fill="#FF00E000" Visibility="{Binding GateOpen, Converter={StaticResource TrueToVisibilityConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Stroke="White" StrokeThickness="3"/>
                                                <Ellipse Fill="Red" Visibility="{Binding GateOpen, Converter={StaticResource TrueToCollapsedConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Grid.Column="1" Stroke="White" StrokeThickness="3"/>
                                            </Grid>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Barrier:" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBlockContentStyle}" FontSize="16" Margin="50,0,0,0"/>
                                            <Button Grid.Column="1" Command="{Binding BarrierCommand}" Width="80">
                                                <Button.Style>
                                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TransactionButtonStyleAction}">
                                                        <Setter Property="Content" Value="Open"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BarrierOpen}" Value="True">
                                                                <Setter Property="Content" Value="Close"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Fill="#FF00E000" Visibility="{Binding BarrierOpen, Converter={StaticResource TrueToVisibilityConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Stroke="White" StrokeThickness="3"/>
                                                <Ellipse Fill="Red" Visibility="{Binding BarrierOpen, Converter={StaticResource TrueToCollapsedConverter}}" HorizontalAlignment="Center" Height="30" Margin="0" VerticalAlignment="Center" Width="30" Grid.Column="1" Stroke="White" StrokeThickness="3"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>-->
                                    
                                    <Grid Grid.RowSpan="2" >
                                        <Button Command="{Binding SaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}" Content="Weigh" FontSize="32" Height="90" Grid.Row="2" Width="300">
                                            <!--<Button.Style>
                                                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource TransactionButtonStyleAction}">
                                                    <Setter Property="Content" Value="Weigh Out"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="Content" Value="Weigh In"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>-->
                                        </Button>
                                    </Grid>
                                </Grid>

                            </Border>
                        </Grid>

                    </Border>

                </Grid>

            </Border>

            <Border Grid.Row="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save"  Width="100" Command="{Binding EditSaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}" Visibility="{Binding InEditMode, Converter={StaticResource TrueToVisibilityConverter}}" />
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>



