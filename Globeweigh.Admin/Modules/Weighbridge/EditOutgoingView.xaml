<admin:MetroWindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:admin="clr-namespace:Globeweigh.Admin"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.EditOutgoingView" Title="Edit Outgoing"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="SingleBorderWindow"  WindowTitleBrush="#FF3F3F46"
        Height="640" Width="600" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White">

    <admin:MetroWindowBase.Resources>


        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>
        <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <system:Boolean x:Key="True">True</system:Boolean>
        <system:Boolean x:Key="False">False</system:Boolean>

        <DataTemplate x:Key="selectCellTemplate">
            <dxe:CheckEdit IsChecked="{Binding Path=RowData.Row.IsSelected}" IsReadOnly="{Binding Path=RowData.Row.OnHold}" HorizontalAlignment="Center"></dxe:CheckEdit>
        </DataTemplate>

        <Style TargetType="{x:Type dxg:RowControl}" >
            <Setter Property="Height" Value="24"></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Row.IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="Green" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </admin:MetroWindowBase.Resources>

    <Border Background="White">
        <Grid Margin="6" >
            <Grid Background="{DynamicResource LightGreyBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
   
                <Border Grid.Row="0" BorderThickness="0,0,0,4" Background="{DynamicResource LightGreyBrush}">
                    <Grid Margin="0">
                        <Grid Margin="4,4,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderThickness="3" BorderBrush="White">
                                <Grid Margin="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="White" BorderThickness="0,0,0,4">
                                        <Grid Margin="0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Weigh Record" Style="{DynamicResource DefaultTextBlockContentStyle}" Foreground="{DynamicResource GlobeweighBlueBrush}" FontFamily="Segoe UI Semibold" Margin="5,0,0,0"  />
                                        </Grid>
                                    </Border>
                                    <Grid Margin="10,10,10,0" Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Weight Date:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  />
                                        <TextBlock Text="{Binding CurrentWeighbridgeRecord.PendingWeighDate, StringFormat=dd/MM/yy HH:mm}" Padding="0" Style="{DynamicResource DefaultTextBlockContentStyle}" Margin="0"  Grid.Column="1" />
                                        <TextBlock Text="Haulier:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="1" />
                                        <dxe:ComboBoxEdit x:Name="cboHauliers" Grid.Row="1" ItemsSource="{Binding HaulierList}" EditValue="{Binding CurrentWeighbridgeRecord.HaulierId, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" Background="White" ShowError="False" AutoComplete="True" SelectedItem="{Binding SelectedHaulier}" DisplayMember="Name" Foreground="Black" ValueMember="id" Grid.Column="1" VerticalAlignment="Center" Height="28" HorizontalAlignment="Left" Width="250" />
                                        <TextBlock Text="Vehicle Reg:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="2" />
                                        <TextBox Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" Style="{DynamicResource DefaultTextBoxStyle}" Background="White" Text="{Binding CurrentWeighbridgeRecord.VehicleReg, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" Width="120"/>
                                        <TextBlock Text="Trailer No:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="3" />
                                        <dxe:TextEdit EditValue="{Binding CurrentWeighbridgeRecord.TrailerNo, UpdateSourceTrigger=PropertyChanged}" Background="White" Style="{DynamicResource DefaultTextEditStyle}"  
                                            Grid.Column="2" HorizontalAlignment="Left" Width="120" VerticalAlignment="Center" Margin="0" Grid.Row="3"/>
                                        <!--<TextBlock Text="Sample Box Weight:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="3" />
                                <dxe:TextEdit EditValue="{Binding CurrentWeighbridgeRecord.SampleBoxWeight, UpdateSourceTrigger=PropertyChanged}" Background="White" Style="{DynamicResource DefaultTextEditStyle}" dxe:NumericMaskOptions.AlwaysShowDecimalSeparator="False"  EditValueType="{x:Type system:Decimal}" Mask="N2"
                                                      MaskType="Numeric" AllowNullInput="True" Grid.Column="2" HorizontalAlignment="Left" Width="80" VerticalAlignment="Center" Margin="0" Grid.Row="3"/>-->

                                        <TextBlock Text="Comments:" Style="{DynamicResource DefaultTextBlockStyle}" Margin="0"  Grid.Row="4" />
                                        <TextBox Margin="0,0,0,18" Text="{Binding CurrentWeighbridgeRecord.Comments}" Style="{DynamicResource DefaultMultilineTextBoxStyle}" Background="White"  AcceptsReturn="True" HorizontalAlignment="Stretch" VerticalContentAlignment="Top" VerticalAlignment="Stretch" Grid.Row="5" Grid.ColumnSpan="2" Grid.RowSpan="2" Height="50"/>
                                    </Grid>

                                </Grid>

                            </Border>
                            <Border Grid.Column="1" Margin="0" BorderBrush="White" BorderThickness="3,0,3,3" Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToCollapsedConverter}}" Grid.Row="1">
                                <Grid  >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border BorderThickness="0,0,0,3" BorderBrush="White">
                                        <Grid Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Label Content="Open Orders (Haulier Assigned)" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}"/>
                                            <!--<Button Content="Edit PPT" Margin="4,0,0,0" Command="{Binding EditPptCommand}" Grid.Column="2"  IsEnabled="{Binding ElementName=grdProducts, Path=SelectedItems.Count}" Style="{DynamicResource ToolbarButtonStyle}"/>-->
                                        </Grid>
                                    </Border>
                                    <dxg:GridControl x:Name="grdOrdersHaulierAssigned" ItemsSource="{Binding DispatchOrderList}" ShowLoadingPanel="{Binding IsBusy}" Margin="4" Grid.Row="1" SelectionMode="None">
                                        <dxg:GridControl.View>
                                            <dxg:TableView x:Name="tvOrders" NavigationStyle="Cell" ShowAutoFilterRow="False"/>
                                        </dxg:GridControl.View>
                                        <dxg:GridControl.Columns>
                                            <dxg:GridColumn FieldName="IsSelected" Width="32"  Header=" " FixedWidth="True" AllowEditing="True" CellTemplate="{DynamicResource selectCellTemplate}"/>
                                            <dxg:GridColumn FieldName="OrderNoDisplay" Header="Order No" FixedWidth="True"  Width="70">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <dxg:GridColumn FieldName="CustomerName"  Header="Customer"/>
                                            <dxg:GridColumn FieldName="HaulierName"  Header="Haulier" FixedWidth="True"  Width="130"/>
                                            <dxg:GridColumn FieldName="DeliveryDate" Header="Week Commencing" FixedWidth="True"  Width="116">
                                                <dxg:GridColumn.EditSettings>
                                                    <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                                </dxg:GridColumn.EditSettings>
                                            </dxg:GridColumn>
                                            <!--<dxg:GridColumn Header="Assigned" HorizontalHeaderContentAlignment="Center" FixedWidth="True" Width="70" CellTemplate="{DynamicResource OrderAssignedCellTemplate}" />-->
                                        </dxg:GridControl.Columns>


                                    </dxg:GridControl>


                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>

                </Border>

                <Border Background="{DynamicResource LightGreyBrush}" Padding="0" Margin="0" Grid.Row="2" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="3" Margin="0,3.5">
                            <Button Content="Save" Width="100" Command="{Binding SaveCommand}" Style="{DynamicResource ToolbarButtonStyleAction}" Visibility="{Binding IsChecked, Converter={StaticResource TrueToVisibilityConverter}, ElementName=chkEdit}"/>
                            <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource ToolbarButtonStyleBase}" IsCancel="True" Margin="20,0,6,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</admin:MetroWindowBase>



