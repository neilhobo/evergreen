<admin:MetroWindowBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
    xmlns:admin="clr-namespace:Globeweigh.Admin"
    xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
    x:Class="Globeweigh.Admin.AddEditCustomerSupplierView" WindowTitleBrush="#FF3F3F46"
    mc:Ignorable="d" ResizeMode="NoResize" WindowStyle="SingleBorderWindow" Title="Add/Edit Customer"
    Height="450" Width="600" WindowStartupLocation="CenterScreen" WindowState="Normal"
    md:DialogServiceViews.IsRegistered="True" Background="{DynamicResource LightGreyBrush}">
    <admin:MetroWindowBase.Resources>

        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>

    </admin:MetroWindowBase.Resources>
    <Border Margin="4" BorderBrush="White" BorderThickness="3" >
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Border>
                <TabControl Margin="10"  Background="Transparent">
                    <TabItem Header="General" IsSelected="True">
                        <Grid Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Label Content="Code" Style="{DynamicResource DefaultLabelStyle}" />
                                <TextBox Text="{Binding CurrentCustomerSupplier.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" Visibility="{Binding IsSupplier, Converter={StaticResource TrueToCollapsedConverter}}" TabIndex="1" Grid.Column="1" Margin="0" HorizontalAlignment="Left" Width="100" />
                                <Label Content="{Binding CurrentCustomerSupplier.Code}" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Column="1" Visibility="{Binding IsSupplier, Converter={StaticResource TrueToVisibilityConverter}}"/>
                                <Label Content="Name" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="1" />
                                <TextBox Text="{Binding CurrentCustomerSupplier.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" Visibility="{Binding CostingZoneMandatory, Converter={StaticResource TrueToCollapsedConverter}}" TabIndex="2" Grid.Column="1" Margin="0,0,20,0" Grid.ColumnSpan="2" Grid.Row="1" />
                                <Label Content="{Binding CurrentCustomerSupplier.Name}" Style="{DynamicResource DefaultLabelContentStyle}" Grid.Column="1" Visibility="{Binding CostingZoneMandatory, Converter={StaticResource TrueToVisibilityConverter}}" Grid.Row="1"/>
                                <Label Content="Costing Zone" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="2" Margin="0,5" Visibility="{Binding IsSupplier, Converter={StaticResource TrueToCollapsedConverter}}"/>
                                <dxe:ComboBoxEdit ItemsSource="{Binding CostingZoneList}"  Style="{DynamicResource DefaultComboBoxEditStyle}" DisplayMember="Description" ValueMember="id" ShowBorder="False" Visibility="{Binding IsSupplier, Converter={StaticResource TrueToCollapsedConverter}}" EditValue="{Binding CurrentCustomerSupplier.CostingZoneId, UpdateSourceTrigger=PropertyChanged}"  Grid.Row="2" TabIndex="3" Grid.Column="1"/>
                            </Grid>

                        </Grid>
                    </TabItem>
                    <TabItem Header="Addresses" Visibility="{Binding CostingZoneMandatory, Converter={StaticResource TrueToCollapsedConverter}}">
                        <Border Grid.Column="1" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!--<Label Content="Contacts" Style="{DynamicResource DefaultLabelStyle}"  Foreground="{DynamicResource GlobeweighBlueBrush}" FontFamily="Segoe UI Semibold"/>-->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0"
                                                    HorizontalAlignment="Right" Grid.Column="1">
                                            <Button Content="Add" 
                                                                  Command="{Binding AddAddressCommand}"
                                                                  Style="{DynamicResource ToolbarButtonStyle}"
                                                                  VerticalAlignment="Center" />
                                            <Button Content="Delete" 
                                                                  Command="{Binding DeleteAddressCommand}"
                                                                  IsEnabled="{Binding SelectedItems.Count, ElementName=grdAddress}"
                                                                  Style="{DynamicResource ToolbarButtonStyle}"
                                                                  VerticalAlignment="Center" />
                                            <Button Content="Edit" 
                                                                  Command="{Binding EditAddressCommand}"
                                                                  IsEnabled="{Binding SelectedItems.Count, ElementName=grdAddress}"
                                                                  Style="{DynamicResource ToolbarButtonStyle}"
                                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                </Border>
                                <dxg:GridControl x:Name="grdAddress" ItemsSource="{Binding CurrentCustomerSupplier.CustomerSupplier_Address}" SelectedItem="{Binding SelectedAddress}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="0,10,0,0">
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="tvAddress" >
                                        </dxg:TableView>
                                    </dxg:GridControl.View>
                                    <dxg:GridColumn FieldName="AddressName" Header="Address Name" Width="160" FixedWidth="True"/>
                                    <dxg:GridColumn FieldName="AddressDisplayOneLine" Header="Address" />
                                </dxg:GridControl>


                            </Grid>
                        </Border>
                    </TabItem>
                    <!--<TabItem Header="Contacts">
                        <Border Grid.Column="1" Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                    <Label Content="Contacts" Style="{DynamicResource DefaultLabelStyle}"  Foreground="{DynamicResource GlobeweighBlueBrush}" FontFamily="Segoe UI Semibold"/>
                    
