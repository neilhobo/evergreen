                                                                  Command="{Binding EditContactCommand}"
                                                                  IsEnabled="{Binding SelectedItems.Count, ElementName=grdContacts}"
                                                                  Style="{DynamicResource ToolbarButtonStyle}"
                                                                  VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                </Border>
                                <dxg:GridControl x:Name="grdContacts"
                                                 ItemsSource="{Binding CurrentCustomerSupplier.CustomerSupplier_Person}"
                                                 SelectedItem="{Binding SelectedPerson}" FontSize="12"
                                                 ShowBorder="False"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1"
                                                 Margin="0,4,0,0" VerticalAlignment="Stretch">
                                    <dxg:GridControl.View>
                                        <dxg:TableView x:Name="tvContacts" AllowPerPixelScrolling="True" ShowColumnHeaders="True" ShowAutoFilterRow="False" ShowGroupPanel="False" ShowSearchPanelMode="Never" ShowIndicator="False" BestFitMode="Smart" AutoWidth="True" NavigationStyle="Row" VerticalScrollbarVisibility="Auto">
