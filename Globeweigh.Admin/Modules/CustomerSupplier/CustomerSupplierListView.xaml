<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.CustomerSupplierListView"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True"
            Background="{DynamicResource LightGreyBrush}">
    <UserControl.Resources>

        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>

        <Style x:Key="RefDataCustomItemContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource MainNavyBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="{TemplateBinding Background}" Height="22">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Semibold"  />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"/>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Background" Value="{DynamicResource DefaultBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </UserControl.Resources>
    <UserControl.DataContext>
        <Binding Path="CustomerSupplierListView" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>
    <Grid Margin="5">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="3" BorderBrush="White"  Margin="0">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="White" BorderThickness="0,0,0,3">
                        <Label Content="Data Type" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" Margin="8,0,0,0"/>
                    </Border>

                    <Grid Margin="0,10" Grid.Row="1">
                        <ListBox x:Name="lstRefData" SelectedItem="{Binding SelectedEntityType}" Style="{DynamicResource LeftMenuListBoxStyle}" ItemContainerStyle="{DynamicResource RefDataCustomItemContainerStyle}" Grid.Row="1" Margin="2,0,0,0">
                            <ListBoxItem x:Name="customers" Content="Customers"  Margin="0,6,0,0" />
                            <ListBoxItem x:Name="suppliers" Content="Suppliers" />
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Grid Margin="0" Grid.Column="1">
                <Border Margin="0,0,2,0" BorderBrush="White" BorderThickness="0,3,3,3" >
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border BorderThickness="0,0,0,3" BorderBrush="White">
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"   HorizontalAlignment="Right" >
                                    <!--<Label Content="Customers" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" Margin="4,0,0,0"/>-->
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="4" Margin="10,0,0,0"  VerticalAlignment="Center">
                                    <Button Content="Add"  Command="{Binding AddCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                    <Button Content="Edit"  Command="{Binding EditCommand}" IsEnabled="{Binding ElementName=grd, Path=SelectedItems.Count}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <dxg:GridControl x:Name="grd" ItemsSource="{Binding EntityList}" SelectedItem="{Binding SelectedEntity}" SelectedItems="{Binding SelectedEntities}" SelectionMode="Row"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="4">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvGrid">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand PassEventArgsToCommand="False" Command="{Binding EditCommand}" EventName="RowDoubleClick"/>
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>

                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="Code" Header="Sage Code" FixedWidth="True" Width="100" Visible="{Binding ElementName=customers, Path=IsSelected}"/>
                            <dxg:GridColumn FieldName="Name" Header="Name" FixedWidth="True" Width="300" AutoFilterCriteria="Contains"/>
                            <dxg:GridColumn FieldName="CostingZone" FixedWidth="True" Width="200" AutoFilterCriteria="Contains" Visible="{Binding ElementName=customers, Path=IsSelected}"/>
                            <dxg:GridColumn Header=" "/>
                        </dxg:GridControl>
                    </Grid>
                </Border>



            </Grid>
        </Grid>
    </Grid>
</UserControl>
