<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        x:Class="Globeweigh.Admin.AddEditAddressView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="SingleBorderWindow"
        Height="460" Width="500" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="{DynamicResource LightGreyBrush}"
        >

    <Border Margin="4" CornerRadius="3" BorderBrush="White" BorderThickness="3" >
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="{Binding HeaderText, FallbackValue=Add Address}" Style="{DynamicResource TransactionHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <Grid x:Name="ControlsGrid" Grid.RowSpan="1" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Content="Address Name" Style="{DynamicResource DefaultLabelStyle}" Margin="0" VerticalAlignment="Center"  />
                    <TextBox x:Name="name" Text="{Binding CurrentAddress.AddressName, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    <Label Content="Address 1" Margin="0" VerticalAlignment="Center"  Grid.Row="1"/>
                    <TextBox Text="{Binding CurrentAddress.Address1, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Row="1"/>
                    <Label Content="Address 2" Margin="0" VerticalAlignment="Center"  Grid.Row="2"/>
                    <TextBox Text="{Binding CurrentAddress.Address2, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Row="2"/>
                    <Label Content="Address 3" Margin="0" VerticalAlignment="Center"  Grid.Row="3"/>
                    <TextBox Text="{Binding CurrentAddress.Address3, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Row="3"/>
                    <Label Content="Address 4" Margin="0" VerticalAlignment="Center"  Grid.Row="4"/>
                    <TextBox Text="{Binding CurrentAddress.Address4, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Row="4"/>
                    <Label Content="Address 5" Margin="0" VerticalAlignment="Center"  Grid.Row="5"/>
                    <TextBox Text="{Binding CurrentAddress.Address5, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Row="5"/>






                </Grid>

            </Border>

            <Border Grid.Row="2" BorderThickness="0,3,0,0" BorderBrush="White">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save"  Width="100" Command="{Binding SaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>
