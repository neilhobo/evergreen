<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:admin="clr-namespace:Globeweigh.Admin"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.ProductsMasterView"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding ProductsMasterView, Source={StaticResource Locator}}" Background="{DynamicResource LightGreyBrush}">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type admin:ProductListViewModel}">
            <admin:ProductListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type admin:PosProductListViewModel}">
            <admin:PosProductListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type admin:RawProductListViewModel}">
            <admin:RawProductListView/>
        </DataTemplate>



        <Style x:Key="RefDataCustomItemContainerStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{DynamicResource MainNavyBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid Background="{TemplateBinding Background}" Height="22">
                            <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Margin="6,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Semibold"  />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"/>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Background" Value="{DynamicResource DefaultBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid Margin="5">
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderThickness="3" BorderBrush="White"  Margin="0">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="White" BorderThickness="0,0,0,3">
                        <Label Content="Product Type" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" Margin="8,0,0,0"/>
                    </Border>

                    <Grid Margin="0,10" Grid.Row="1">
                        <ListBox x:Name="lstRefData" SelectedItem="{Binding SelectedEntity}" Style="{DynamicResource LeftMenuListBoxStyle}" ItemContainerStyle="{DynamicResource RefDataCustomItemContainerStyle}" Grid.Row="1" Margin="2,0,0,0">
                            <ListBoxItem x:Name="finishedProducts" Content="Finished Products"  Margin="0,6,0,0" />
                            <ListBoxItem x:Name="pointOfSale" Content="Point Of Sale" />
                            <ListBoxItem x:Name="rawMaterials" Content="Raw Materials" />
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Grid Margin="0" Grid.Column="1">
                <ContentControl Content="{Binding CurrentViewModel}" Grid.Row="1" Background="{DynamicResource MainContentGrey}" Grid.Column="1"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
