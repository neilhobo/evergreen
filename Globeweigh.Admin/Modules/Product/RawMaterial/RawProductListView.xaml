<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.RawProductListView"
             mc:Ignorable="d"  
             d:DesignHeight="500" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True" Background="{DynamicResource LightGreyBrush}"
             DataContext="{Binding RawProductListView, Source={StaticResource Locator}}" SnapsToDevicePixels="True">
    <UserControl.Resources>

        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>



    </UserControl.Resources>
    <Grid Margin="0,0,2,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border BorderBrush="White" BorderThickness="0,3,3,3">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,3" BorderBrush="White">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Product" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" Margin="4,0,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"  HorizontalAlignment="Right" Grid.Column="1" >
                            <Button Content="Add" Command="{Binding AddProductCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                            <Button Content="Delete"  Command="{Binding DeleteProductCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" Visibility="{Binding IsChecked, Converter={StaticResource TrueToCollapsedConverter}, ElementName=chkShowDeletes}" />
                            <!--<Button Content="Restore" Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" Visibility="{Binding IsChecked, Converter={StaticResource TrueToVisibilityConverter}, ElementName=chkShowDeletes}" />-->
                            <Button Content="Edit" Command="{Binding EditProductCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>


                </Border>
                <dxg:GridControl x:Name="grd" ItemsSource="{Binding ProductList}" SelectedItem="{Binding SelectedProduct}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1"  AllowLiveDataShaping="True" Margin="4">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tvGrid" ShowSearchPanelMode="Never" NavigationStyle="Row"/>

                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="Description" AutoFilterCriteria="Contains" />
                </dxg:GridControl>
            </Grid>
        </Border>
        <Border BorderBrush="White" BorderThickness="0,3,3,3" Grid.Column="1" Visibility="{Binding SelectedProduct, Converter={StaticResource NullToCollapsedConverter}}">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,3" BorderBrush="White">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Supplier" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" Margin="4,0,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"  HorizontalAlignment="Right" Grid.Column="1" >
                            <Button Content="Add" Command="{Binding AddProductSupplierCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                            <Button Content="Delete"  Command="{Binding DeleteProductSupplierCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd1}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>


                </Border>
                <dxg:GridControl x:Name="grd1" ItemsSource="{Binding ProductSupplierList}" SelectedItem="{Binding SelectedProductSupplier}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1"  AllowLiveDataShaping="True" Margin="4">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tvGrid1" ShowSearchPanelMode="Never" NavigationStyle="Row" />

                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="Name" AutoFilterCriteria="Contains" />
                </dxg:GridControl>
            </Grid>
        </Border>
        <Border BorderBrush="White" BorderThickness="0,3,3,3" Grid.Column="2" Visibility="{Binding SelectedProductSupplier, Converter={StaticResource NullToCollapsedConverter}}">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,3" BorderBrush="White">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="Bog List" Style="{DynamicResource DefaultLabelStyle}" FontFamily="Segoe UI Semibold" FontSize="13" Foreground="{DynamicResource GlobeweighBlueBrush}" Margin="4,0,0,0"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"  HorizontalAlignment="Right" Grid.Column="1" >
                            <Button Content="Add" Command="{Binding AddBogCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                            <Button Content="Edit"  Command="{Binding EditBogCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd2}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                            <Button Content="Delete"  Command="{Binding DeleteBogCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd2}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>


                </Border>
                <dxg:GridControl x:Name="grd2" ItemsSource="{Binding BogList}" SelectedItem="{Binding SelectedBog}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1"  AllowLiveDataShaping="True" Margin="4">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tvGrid2" ShowSearchPanelMode="Never" NavigationStyle="Row" />

                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="Name" AutoFilterCriteria="Contains" />
                </dxg:GridControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
