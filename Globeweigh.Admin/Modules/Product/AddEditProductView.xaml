<admin:MetroWindowBase  
    	xmlns:admin="clr-namespace:Globeweigh.Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.AddEditProductView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="SingleBorderWindow" WindowTitleBrush="#FF3F3F46"
        Height="500" Width="600" WindowStartupLocation="CenterScreen" WindowState="Normal" Title="{Binding HeaderText, FallbackValue=Add/Edit Product}"
        md:DialogServiceViews.IsRegistered="True" Background="{DynamicResource LightGreyBrush}">

    <admin:MetroWindowBase.Resources>

        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
    </admin:MetroWindowBase.Resources>

    <Border BorderThickness="3" CornerRadius="3" BorderBrush="White" Margin="6">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border >
                <TabControl Margin="10,0,10,10">
                    <TabItem Header="General" IsSelected="True">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Label Content="Product Description" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="1" Margin="0,5"/>
                                <TextBox Text="{Binding CurrentProduct.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" Grid.Row="1" Grid.ColumnSpan="3" TabIndex="1" Grid.Column="1"/>
                                <Label Content="Code" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="2" Margin="0,5"/>
                                <Grid Grid.Column="1" Margin="0" Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CurrentProduct.SkuCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" HorizontalAlignment="Left" Width="100" Margin="0,5"/>
                                    <TextBlock Text="Code already exists"  Visibility="{Binding CodeAlreadyExists, Converter={StaticResource TrueToVisibilityConverter}}" Margin="10,0,0,0" FontFamily="Segoe UI" Grid.Column="1" Foreground="Red" VerticalAlignment="Center"  />

                                </Grid>
                                <Label Content="GTIN" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="3" Margin="0,5"/>
                                <TextBox Text="{Binding CurrentProduct.Gtin, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" TabIndex="1" HorizontalAlignment="Left" Width="100" Margin="0,5" Grid.Column="1" Grid.Row="3"/>
                                <!--<Label Content="Product Type" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="4" Margin="0,5"/>
                                <dxe:ComboBoxEdit ItemsSource="{Binding ProductTypeList}"  Style="{DynamicResource DefaultComboBoxEditStyle}" SelectedItem="{Binding SelectedProductType}" DisplayMember="TypeDescription" ValueMember="id" ShowBorder="False"  EditValue="{Binding CurrentProduct.ProductTypeId, UpdateSourceTrigger=PropertyChanged}"  Grid.Row="4" TabIndex="3" Grid.Column="1" HorizontalAlignment="Left" Width="200"/>-->
                       
                            </Grid>
                            <Grid Grid.Row="1" Visibility="{Binding CurrentProduct.ProductTypeId, Converter={StaticResource ZeroToCollapsedConverter}}">
                                <Grid Margin="0" Visibility="{Binding CurrentProduct.IsFinishedProduct, Converter={StaticResource TrueToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Label Content="Category Type" Style="{DynamicResource DefaultLabelStyle}" Margin="0,5"/>
                                    <dxe:ComboBoxEdit ItemsSource="{Binding CategoryList}"  SelectedItem="{Binding SelectedProductType, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" DisplayMember="DisplayName" ValueMember="id" ShowBorder="False"  EditValue="{Binding CurrentProduct.CategoryId, UpdateSourceTrigger=PropertyChanged}" TabIndex="3" Grid.Column="1" HorizontalAlignment="Left" Width="200"/>
                                    <Label Content="Size" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="1" Margin="0,5"/>
                                    <dxe:TextEdit Text="{Binding CurrentProduct.Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextEditStyle}"  MaskType="Numeric" AllowNullInput="True" HorizontalAlignment="Left" Width="100" Margin="0,5" Grid.Column="1" Grid.Row="1"/>
                                    <Label Content="UPP" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="2" Margin="0,5"/>
                                    <dxe:TextEdit Text="{Binding CurrentProduct.Upp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextEditStyle}"  MaskType="Numeric" AllowNullInput="True" HorizontalAlignment="Left" Width="100" Margin="0,5" Grid.Column="1" Grid.Row="2"/>
                                    <!--<Label Content="Point Of Sale" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="3" Margin="0,5"/>
                                    <CheckBox IsChecked="{Binding CurrentProduct.Pos, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"/>-->
                                    <Label Content="Pos Product:" Margin="0" VerticalAlignment="Center"  Foreground="{DynamicResource MainNavyBrush}" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="4"/>
                                    <dxe:ComboBoxEdit Grid.Column="1" Grid.Row="4" ItemsSource="{Binding PosProductList}" ShowCustomItems="True" AllowNullInput="True" EditValue="{Binding CurrentProduct.PosId, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultComboBoxEditStyle}" Foreground="Black" IsTextEditable="False" DisplayMember="Description" ValueMember="id" VerticalAlignment="Center" Margin="0,5" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <!--<TabItem Header="Allergens">
               
                    </TabItem>-->
                </TabControl>

            </Border>

            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DefaultBorderBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save"  Width="100" Command="{Binding SaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</admin:MetroWindowBase>
