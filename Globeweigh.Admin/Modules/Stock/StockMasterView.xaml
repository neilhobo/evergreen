<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:admin="clr-namespace:Globeweigh.Admin"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.StockMasterView"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="700"
             shared:ViewModelBehavior.LoadUnload="True"
             Background="White">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type admin:FinishedProductStockMasterViewModel}">
            <admin:FinishedProductStockMasterView/>
        </DataTemplate>


    </UserControl.Resources>
    <UserControl.DataContext>
        <Binding Path="StockMasterView" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>
    <Grid Margin="10,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1">
                <TextBlock Text="Product Type" Foreground="Black" VerticalAlignment="Center" Margin="0,0,0,2" FontSize="16" FontFamily="Segoe UI Semilight"/>
            </Border>

            <Grid Margin="0,20,0,10" Grid.Row="1">
                <ListBox x:Name="lstRefData" ItemsSource="{Binding ProductTypeList}" SelectedItem="{Binding SelectedProductType}" Style="{DynamicResource LeftMenuListBoxStyle}" ItemContainerStyle="{DynamicResource RefDataEntityItemContainerStyle}" Grid.Row="1"/>
            </Grid>



        </Grid>
        <ContentControl Content="{Binding CurrentViewModel}" Grid.Row="1"/>
    </Grid>
</UserControl>
