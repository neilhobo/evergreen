<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.StockTakeView"
             mc:Ignorable="d"  dx:ThemeManager.ThemeName="MetropolisLight"
             d:DesignHeight="500" d:DesignWidth="1400"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding StockTakeView, Source={StaticResource Locator}}" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
            <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>
            <converters:NullToTrueConverter x:Key="NullToTrueConverter"/>

            <Style x:Key="boldCellStyle" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=CellStyle}}" TargetType="dxg:CellContentPresenter">
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="rowStyle" TargetType="{x:Type dxg:GridRowContent}" BasedOn="{StaticResource defaultGridRowContent}">
                <Setter Property="Height" Value="24"></Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Row.HasDifference}" Value="True">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="UseByCellTemplate">
                <TextBlock x:Name="txt" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" >
                    <Hyperlink Command="{Binding Path=Column.DataContext.ViewUseByCommand}" CommandParameter="{Binding Path=Data.ProductId}" TextDecorations="{x:Null}">
                        <TextBlock Text="{Binding Data.UseByDisplay}"/>
                    </Hyperlink>
                </TextBlock>
            </DataTemplate>

            <Style x:Key="FocusedCellStyle" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=CellStyle}}" TargetType="dxg:CellContentPresenter">
                <Setter Property="Background" Value="White" />
                <Style.Triggers>
                    <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                        <Setter Property="Background" Value="White" />
                        <!--<Setter Property="Foreground" Value="Black" />-->
                    </Trigger>
                </Style.Triggers>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="StockTakeGrid" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="453*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" Margin="0">
                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Stock Takes" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="10,0,0,0" FontSize="18"  />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Grid.Column="2" >
                            <controls:ImageButton Content="Refresh" Margin="0" ImageSource="/Images\Refresh-32.png" Command="{Binding RefreshStockTakeListCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                            <controls:ImageButton Content="Add New" Margin="0" ImageSource="/Images\Add-Square-32.png" Command="{Binding AddNewStockTakeCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="White" BorderThickness="1" Grid.Row="1">
                    <Grid>
                        <dxg:GridControl x:Name="grdStockTakes" ItemsSource="{Binding StockTakeList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItem="{Binding SelectedStockTake}" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" >
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvStockTakes" AllowPerPixelScrolling="True" ShowColumnHeaders="True" UseLightweightTemplates="None" RowStyle="{DynamicResource rowStyle}" AutoWidth="True" ShowGroupPanel="False" ShowIndicator="True" ShowAutoFilterRow="True" NavigationStyle="Row"/>
                            </dxg:GridControl.View>
                            <dxg:GridColumn FieldName="id" Header="Stock ID" Width="60" FixedWidth="True">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="DateCreated" Header="Date of Stock Take">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <!--<dxg:GridColumn FieldName="Completed" Header="Completed"/>-->
                            <dxg:GridColumn FieldName="DateCompleted">
                                <dxg:GridColumn.EditSettings>
                                    <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                </dxg:GridColumn.EditSettings>
                            </dxg:GridColumn>
                            <dxg:GridColumn FieldName="MadeCurrentStock"  Width="120" FixedWidth="True"/>
                        </dxg:GridControl>
                    </Grid>
                </Border>
            </Grid>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="1,0,0,0" Margin="0" Grid.Column="1"  HorizontalAlignment="Center"/>
            <Grid Grid.Column="2" Background="{DynamicResource LightGreyBrush}">
                <Grid x:Name="StockGrid"  d:IsHidden="False" Visibility="{Binding SelectedStockTake, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="453*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" Margin="0">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Summary" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="10,0,0,0" FontSize="18"  />
                            <CheckBox x:Name="chkDiscrepancies" IsChecked="{Binding ShowDiscrepancies}" VerticalContentAlignment="Center" Margin="20,2,0,0" Content="Show discrepancies only" VerticalAlignment="Center" Visibility="Visible" Grid.Column="1" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Grid.ColumnSpan="2" Grid.Column="2" >
                                <controls:ImageButton Content="Make Current Stock" Margin="0" ImageSource="/Images\BlueTick-32.png" Command="{Binding MakeCurrentStockCommand}" IsEnabled="{Binding SelectedStockTake.DateMadeCurrentStock, Converter={StaticResource NullToTrueConverter}}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>

                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="White" BorderThickness="1" Grid.Row="1" >
                        <Grid>
                            <dxg:GridControl x:Name="grdStock" ItemsSource="{Binding StockTakeSummaryList}" ShowLoadingPanel="{Binding IsBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0" >
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tvStock" AllowPerPixelScrolling="True" ShowColumnHeaders="True" UseLightweightTemplates="None" RowStyle="{DynamicResource rowStyle}" AutoWidth="True" ShowGroupPanel="False" ShowIndicator="True" ShowAutoFilterRow="True" NavigationStyle="None"/>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="StockTakeLocationDisplay" Header="Location"  AutoFilterCondition="Contains" Width="100" FixedWidth="True" CellStyle="{DynamicResource boldCellStyle}"/>
                                <dxg:GridColumn Header=" "  Width="0" />
                                <dxg:GridColumn FieldName="ExistingPalletNo" Header="Current Pallet" Width="100" FixedWidth="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="ExistingUnits" Header=" CurrentUnits" Width="100" FixedWidth="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn Header=" "  Width="0" />
                                <dxg:GridColumn FieldName="StockTakePalletNo" Header="Stock Take Pallet" Width="100" FixedWidth="True" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="StockTakePalletUnits" Header="Stock Take Units" Width="110" FixedWidth="True" >
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName=""  Header=" " Visible="{Binding IsChecked, ElementName=chkShowAllUBD}"/>



                            </dxg:GridControl>
                        </Grid>
                    </Border>
                </Grid>
                <Grid  Grid.Column="2" Background="{DynamicResource LightGreyBrush}" Visibility="{Binding SelectedStockTake.DateCompleted, Converter={StaticResource NullToVisibleConverter}, FallbackValue=Collapsed}" d:IsHidden="False">
                    <Border Margin="50" BorderThickness="5" CornerRadius="5" BorderBrush="White"  >
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="Complete stock take to view results" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" FontSize="36" Foreground="{DynamicResource LightNavyBrush}" Margin="0"/>
                            <Button Content="Complete Stock Take" Style="{DynamicResource PrimaryAdminButtonStyle}"  Command="{Binding CompleteStockTakeCommand}" Margin="0,50,0,0" Width="200" Height="34" FontSize="16" />
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
