<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:admin="clr-namespace:Globeweigh.Admin"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.FinishedProductStockMasterView"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="700"
             shared:ViewModelBehavior.LoadUnload="True"
             Background="White">
    <UserControl.Resources>

        <DataTemplate DataType="{x:Type admin:CurrentStockListViewModel}">
            <admin:CurrentStockListView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type admin:CurrentStockLocationViewModel}">
            <admin:CurrentStockLocationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type admin:CurrentStockSummaryViewModel}">
            <admin:CurrentStockSummaryView/>
        </DataTemplate>

        




    </UserControl.Resources>
    <UserControl.DataContext>
        <Binding Path="FinishedProductStockMasterView" Source="{StaticResource Locator}"/>
    </UserControl.DataContext>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" >
            <ListBox Background="{x:Null}" SelectedItem="{Binding SelectedNavItem}"  ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Grid.Row="1" ItemContainerStyle="{DynamicResource HorizontalTabMasterViewItemContainerStyle}" Margin="0,2,0,6" >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBoxItem x:Name="SummaryView" Content="Summary View" IsSelected="True"  />
                 <ListBoxItem x:Name="LocationView" Content="Location View" Margin="10,0,0,0"  />
                <ListBoxItem x:Name="CurrentStockList" Content="Pallet View" Margin="10,0,0,0"  />
                <!--<ListBoxItem x:Name="CurrentStockList" Content="Stock Takes" Margin="10,0,0,0"  />-->
            </ListBox>
        </Border>
        <ContentControl Content="{Binding CurrentViewModel}" Grid.Row="1" Background="{DynamicResource MainContentGrey}"/>
    </Grid>
</UserControl>
