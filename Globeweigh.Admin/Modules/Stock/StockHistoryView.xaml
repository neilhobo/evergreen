<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.StockHistoryView"
             mc:Ignorable="d"  dx:ThemeManager.ThemeName="MetropolisLight"
             d:DesignHeight="500" d:DesignWidth="1100"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding StockHistoryView, Source={StaticResource Locator}}" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="boldCellStyle" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=CellStyle}}" TargetType="dxg:CellContentPresenter">
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="rowStyle" TargetType="{x:Type dxg:GridRowContent}">
                <Setter Property="Height" Value="24"></Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border  Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="451*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1"/>
                </Grid>

            </Border>
            <Grid Grid.Column="1">
                <Grid x:Name="StockHistoryGrid" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="453*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" Margin="0">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stock History" Style="{DynamicResource TransactionLabelTextBlockStyle}" FontFamily="Segoe UI" Margin="10,0,0,0" FontSize="18"  />
                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="20,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="Date From:" VerticalAlignment="Center"/>
                                <dxe:DateEdit EditValue="{Binding DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120" Margin="14,0,0,0"/>
                                <TextBlock Text="Date To:" VerticalAlignment="Center" Grid.Column="2" Margin="20,0,0,0"/>
                                <dxe:DateEdit EditValue="{Binding DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120" Margin="14,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Grid.ColumnSpan="2" Grid.Column="2" >
                                <controls:ImageButton Content="Refresh" Margin="0" ImageSource="/Images\Refresh-32.png" Command="{Binding RefreshCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <controls:ImageButton Content="Print / Export" Margin="0" ImageSource="/Images\Print-32.png" Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvStockHistory}" IsEnabled="{Binding VisibleRowCount, ElementName=grdPallets}" Style="{DynamicResource ToolbarButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="White" BorderThickness="1" Grid.Row="1">
                        <Grid>
                            <dxg:GridControl x:Name="grdStockHistory" ItemsSource="{Binding StockHistoryList}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0" >
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tvStockHistory" AllowPerPixelScrolling="True" ShowColumnHeaders="True"  UseLightweightTemplates="None" BestFitMode="Smart"  RowStyle="{StaticResource rowStyle}" AutoWidth="True" ShowGroupPanel="False" ShowIndicator="True" ShowAutoFilterRow="True" NavigationStyle="None"/>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="TransactionType" Width="120" Header=" " FixedWidth="True"/>
                                <dxg:GridColumn FieldName="DateCreated" Header="Date" Width="150" Visible="{Binding IsChecked, ElementName=chkGroupedUbd}" FixedWidth="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="BoxId" Width="100" FixedWidth="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName="Description" Width="250" Header="Product" FixedWidth="True"/>
                                <dxg:GridColumn FieldName="MachineName" Width="100"  FixedWidth="True">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                                <dxg:GridColumn FieldName=""  Header=" "/>

                            </dxg:GridControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
