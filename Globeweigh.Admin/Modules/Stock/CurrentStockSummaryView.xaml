<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.CurrentStockSummaryView"
             mc:Ignorable="d"  dx:ThemeManager.ThemeName="MetropolisLight"
             d:DesignHeight="500" d:DesignWidth="1400"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding CurrentStockSummaryView, Source={StaticResource Locator}}" Background="{DynamicResource LightGreyBrush}">
    <UserControl.Resources>
        <ResourceDictionary>

            <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>



            <Style x:Key="rowStyle" TargetType="{x:Type dxg:RowControl}">
                <!--<Setter Property="Height" Value="24"></Setter>-->
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Row.OnHold}" Value="True" >
                        <Setter Property="Foreground" Value="Red"/>
                    </DataTrigger>
                    <!--<MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Row.Highlighted}" Value="True" />
                            <Condition Binding="{Binding IsSelected}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource GlobeweighBlueBrush}" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </MultiDataTrigger>-->
                </Style.Triggers>
            </Style>

            <Style x:Key="FocusedCellStyle" TargetType="dxg:LightweightCellEditor" BasedOn="{StaticResource {dxgt:GridRowThemeKey ResourceKey=LightweightCellStyle}}">
                <Setter Property="Background" Value="White" />
                <Style.Triggers>
                    <Trigger Property="dxg:DataViewBase.IsFocusedRow" Value="True">
                        <Setter Property="Background" Value="White" />
                        <!--<Setter Property="Foreground" Value="Black" />-->
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="PalletHistoryCellTemplate">
                <TextBlock x:Name="txt" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" >
                    <Hyperlink Command="{Binding Path=Column.DataContext.ViewPalletHistoryCommand}" CommandParameter="{Binding Path=Value}" TextDecorations="{x:Null}">
                        <TextBlock Text="History"/>
                    </Hyperlink>
                </TextBlock>
            </DataTemplate>


        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="StockGrid"  >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="453*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" Margin="0">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Product List" Style="{DynamicResource DefaultTextBlockContentStyle}"/>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="10,0,0,0">
                                <Border Margin="10,0" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="2,0,0,0"/>

                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Grid.ColumnSpan="2" Grid.Column="2" >
                                <controls:ImageButton Content="Refresh" Margin="0" ImageSource="/Images\Refresh-32.png" Command="{Binding RefreshCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <controls:ImageButton Content="Print / Export" Margin="2,0,0,0" ImageSource="/Images\Print-32.png" Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvStock}" IsEnabled="{Binding VisibleRowCount, ElementName=grdStock}" Style="{DynamicResource ToolbarButtonStyle}"/>

                            </StackPanel>
                        </Grid>
                    </Border>
                    <dxg:GridControl x:Name="grdStock" ItemsSource="{Binding SummaryList}" SelectedItem="{Binding SelectedSummary}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Grid.Row="1" >
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvStock"  ShowSearchPanelMode="Never" RowStyle="{DynamicResource rowStyle}" ShowGroupPanel="False" 
                                                   ShowAutoFilterRow="True" NavigationStyle="Row" ShowFixedTotalSummary="True" BestFitMode="Smart" AutoWidth="True" AllowBestFit="True"/>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="Code" Width="100" FixedWidth="True"/>
                        <dxg:GridColumn FieldName="ProductName"  Header="Product"  />
                        <dxg:GridColumn FieldName="Size" Width="60" FixedWidth="True"/>
                        <dxg:GridColumn FieldName="Upp"  Header="UPP" Width="60" FixedWidth="True"/>
                        <dxg:GridColumn FieldName="PalletCount" Width="90" FixedWidth="True"/>
                        <dxg:GridColumn FieldName="TotalUnits" Width="90" FixedWidth="True"/>

                    </dxg:GridControl>
                </Grid>

                <Grid x:Name="PalletGrid" Grid.Column="2"  Visibility="{Binding SelectedSummary, Converter={StaticResource NullToCollapsedConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="453*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1" Margin="0">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Pallet List" Style="{DynamicResource DefaultTextBlockContentStyle}"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Grid.ColumnSpan="2" Grid.Column="2" >
                                <controls:ImageButton Content="Refresh" Margin="0" ImageSource="/Images\Refresh-32.png" Command="{Binding RefreshCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                <controls:ImageButton Content="Print / Export" Margin="2,0,0,0" ImageSource="/Images\Print-32.png" Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvPallets}" IsEnabled="{Binding VisibleRowCount, ElementName=grdPallets}" Style="{DynamicResource ToolbarButtonStyle}"/>

                            </StackPanel>
                        </Grid>
                    </Border>
                    <dxg:GridControl x:Name="grdPallets" ItemsSource="{Binding PalletList}" SelectedItem="{Binding SelectedPallet}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Grid.Row="1" >
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvPallets"  ShowSearchPanelMode="Never" RowStyle="{DynamicResource rowStyle}" ShowGroupPanel="False" 
                                                   ShowAutoFilterRow="True" NavigationStyle="Row" ShowFixedTotalSummary="True" BestFitMode="Smart" AutoWidth="True" AllowBestFit="True"/>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="PalletNo">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Location" Header="Location" />
                        <dxg:GridColumn FieldName="DateOfProduction" Header="Production Date" Width="140" FixedWidth="True">
                            <dxg:GridColumn.EditSettings>
                                <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                            </dxg:GridColumn.EditSettings>
                        </dxg:GridColumn>
                        <dxg:GridControl.TotalSummary>
                            <dxg:GridSummaryItem SummaryType="Count" Alignment="Right" />
                        </dxg:GridControl.TotalSummary>

                    </dxg:GridControl>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</UserControl>
