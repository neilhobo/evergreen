<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.PalletHistoryView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="600" Width="800" WindowStartupLocation="CenterOwner" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White"
        dx:ThemeManager.ThemeName="MetropolisLight">

    <shared:WindowBase.Resources>

    </shared:WindowBase.Resources>
    <Border Margin="0" CornerRadius="3" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="{Binding HeaderText, FallbackValue=Edit Intake Record}" Style="{DynamicResource TransactionHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <dxg:GridControl x:Name="grdStock" ItemsSource="{Binding HistoryList}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="None" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Grid.Row="1" >
                <dxg:GridControl.View>
                    <dxg:TableView x:Name="tvStock" AllowPerPixelScrolling="True" ShowColumnHeaders="True"  AutoWidth="True" ShowGroupPanel="False" ShowIndicator="True" 
                                                   ShowSearchPanelMode="Never" NavigationStyle="None" ShowFixedTotalSummary="False" />
                </dxg:GridControl.View>
                <dxg:GridColumn FieldName="OldLocationDisplay"  Header="Location From" AllowEditing="False"/>
                <dxg:GridColumn FieldName="NewLocationDisplay"  Header="Location To" AllowEditing="False"/>
                <dxg:GridColumn FieldName="DateOfLocationChange" Header="Date Of Location Change" Width="140">
                    <dxg:GridColumn.EditSettings>
                        <dxe:TextEditSettings MaskType="DateTime" Mask="dd/MM/yyyy HH:mm" MaskUseAsDisplayFormat="True" HorizontalContentAlignment="Left"/>
                    </dxg:GridColumn.EditSettings>
                </dxg:GridColumn>
                <dxg:GridControl.TotalSummary>
                    <dxg:GridSummaryItem SummaryType="Count" Alignment="Right" />
                </dxg:GridControl.TotalSummary>

            </dxg:GridControl>

            <Border Grid.Row="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Close" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>

