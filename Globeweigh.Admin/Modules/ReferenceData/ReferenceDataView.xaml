<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
               xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
             x:Class="Globeweigh.Admin.ReferenceDataView"
             mc:Ignorable="d"  
             d:DesignHeight="500" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding ReferenceDataView, Source={StaticResource Locator}}" Background="White">
    <UserControl.Resources>
        <ResourceDictionary>

            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>
            <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
            

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid Grid.Row="1" >
            <Grid Margin="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right" Grid.Column="1" >
                            <Button Content="Add" Command="{Binding AddNewCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                            <Button Content="Delete"  Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdRefData}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" Visibility="{Binding ElementName=chkShowDeletes, Path=IsChecked, Converter={StaticResource TrueToCollapsedConverter}}"/>
                            <Button Content="Restore" Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center" Visibility="{Binding ElementName=chkShowDeletes, Path=IsChecked, Converter={StaticResource TrueToVisibilityConverter}}"/>
                            <Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grdRefData}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                            <!--<Button Content="Compare with Opera" ImageSource="/Images\Compare-32.png" Command="{Binding CompareWithOperaCommand}" IsEnabled="{Binding ElementName=chkGroupCodes, Path=IsChecked, Converter={StaticResource TrueToFalseConverter}}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>-->
                            <Button Content="Print / Export" Margin="2,0,0,0" Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvGrid}" IsEnabled="{Binding VisibleRowCount, ElementName=grdPallets}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border BorderThickness="1" Grid.Row="1">
                    <Grid x:Name="RefDataParentGrid">
                        <dxg:GridControl x:Name="grdRefData" ItemsSource="{Binding GenericRefDataList}"  ColumnsSource="{Binding VisibleColumnList}" SelectedItem="{Binding SelectedRefData}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="0">
                            <dxg:GridControl.View>
                                <dxg:TableView x:Name="tvGrid" AllowPerPixelScrolling="True" ShowGroupPanel="False"  ShowIndicator="True"  AutoWidth="True" BestFitMode="Smart"  NavigationStyle="Row"  VerticalScrollbarVisibility="Auto">
                                    <dxmvvm:Interaction.Behaviors>
                                        <dxmvvm:EventToCommand PassEventArgsToCommand="False" Command="{Binding EditCommand}" EventName="RowDoubleClick"/>
                                    </dxmvvm:Interaction.Behaviors>
                                </dxg:TableView>
                            </dxg:GridControl.View>
                        </dxg:GridControl>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" Visibility="{Binding IsAdmin, Converter={StaticResource TrueToVisibilityConverter}}" BorderThickness="0,1,0,0" Grid.Row="2" Height="40">
                    <Grid Margin="4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <dxe:CheckEdit x:Name="chkShowDeletes" IsChecked="{Binding ShowDeletes}" Content="Show Deleted Records" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
