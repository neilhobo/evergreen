<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
           xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
           xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
           x:Class="Globeweigh.Admin.CostingZoneListView"
             mc:Ignorable="d"  
             d:DesignHeight="500" d:DesignWidth="1200"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding CostingZoneListView, Source={StaticResource Locator}}" Background="{DynamicResource LightGreyBrush}">
    <UserControl.Resources>
        <ResourceDictionary>


        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0,0,10,10" >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="453*"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right" Grid.Column="1" >
                    <Button Content="Add" Command="{Binding AddCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                    <Button Content="Delete"  Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                    <Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                    <Button Content="Print / Export" Margin="2,0,0,0" Command="{Binding GlobalPrintExportCommand}" CommandParameter="{Binding ElementName=tvGrid}" IsEnabled="{Binding VisibleRowCount, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>

                </StackPanel>
            </Grid>
        </Border>
        <Border BorderThickness="1" Grid.Row="1">
            <Grid>
                <dxg:GridControl x:Name="grd" ItemsSource="{Binding CostingZoneList}" SelectedItem="{Binding SelectedCostingZone}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <dxg:GridControl.View>
                        <dxg:TableView x:Name="tvGrid" AllowPerPixelScrolling="True" ShowGroupPanel="False"  ShowIndicator="True"  AutoWidth="True"  NavigationStyle="Row"  VerticalScrollbarVisibility="Auto">
                            <dxmvvm:Interaction.Behaviors>
                                <dxmvvm:EventToCommand PassEventArgsToCommand="False" Command="{Binding EditCommand}" EventName="RowDoubleClick"/>
                            </dxmvvm:Interaction.Behaviors>
                        </dxg:TableView>
                    </dxg:GridControl.View>
                    <dxg:GridColumn FieldName="Description" Header="Zone Description" FixedWidth="True" Width="200"/>
                    <dxg:GridColumn FieldName="SecondaryDescription" Header="Extra Info" FixedWidth="True" Width="200"/>
                    <dxg:GridColumn FieldName="CurrencyDisplay" Header="Currency" FixedWidth="True" Width="90"/>
                    <dxg:GridColumn Header=" "/>
                </dxg:GridControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
