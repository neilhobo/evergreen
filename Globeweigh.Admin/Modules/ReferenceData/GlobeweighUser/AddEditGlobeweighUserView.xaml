<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:model="clr-namespace:Globeweigh.Model;assembly=Globeweigh.Model"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.AddEditGlobeweighUserView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="400" Width="700" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White"
        >

    <Window.Resources>

        <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
        <converters:UserTypeEnumBooleanConverter x:Key="UserTypeEnumBooleanConverter"/>
        <converters:BooleanOrConverter x:Key="BooleanOrConverter"/>
        <converters:TrueOrTrueToVisibilityConverter x:Key="TrueOrTrueToVisibilityConverter"/>
        <converters:TrueToFalseConverter x:Key="TrueToFalseConverter"/>
        

    </Window.Resources>

    <Border Margin="0" CornerRadius="3" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="{Binding HeaderText, FallbackValue=Header Text}" Style="{DynamicResource TransactionHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>

                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Label Content="User Type" Style="{DynamicResource DefaultLabelStyle}" Margin="0,5"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <RadioButton x:Name="chkOffice" IsChecked="{Binding CurrentGlobeweighUser.UserTypeId, ConverterParameter={x:Static model:eUserType.Office}, Converter={StaticResource UserTypeEnumBooleanConverter}}" Content="Office" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Foreground="{DynamicResource DarkGreyBrush}" />
                            <RadioButton x:Name="chkTouch" IsChecked="{Binding CurrentGlobeweighUser.UserTypeId, ConverterParameter={x:Static model:eUserType.Touch}, Converter={StaticResource UserTypeEnumBooleanConverter}}" Content="Touch" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Margin="10,0,0,0" Foreground="{DynamicResource DarkGreyBrush}" />
                            <RadioButton x:Name="chkBoth" IsChecked="{Binding CurrentGlobeweighUser.UserTypeId, ConverterParameter={x:Static model:eUserType.Both}, Converter={StaticResource UserTypeEnumBooleanConverter}, FallbackValue=True}" Content="Both" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" Margin="10,0,0,0" Foreground="{DynamicResource DarkGreyBrush}" />
                        </StackPanel>

                        <Label Content="First Name*" Style="{DynamicResource DefaultLabelStyle}" Margin="0,5" Grid.Row="1"/>
                        <TextBox Text="{Binding CurrentGlobeweighUser.FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0"  TabIndex="2" Grid.Column="1" HorizontalAlignment="Left" Width="150" Grid.Row="1"/>
                        <Label Content="Surname*" Style="{DynamicResource DefaultLabelStyle}" Margin="0,5" Grid.Row="2"/>
                        <TextBox Text="{Binding CurrentGlobeweighUser.Surname, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" Grid.Row="2" Margin="0"  TabIndex="2" Grid.Column="1" Width="150" HorizontalAlignment="Left"/>
                        <Label Content="Username (Login)*" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="3" Margin="0,5">
                            <Label.Visibility>
                                <MultiBinding Converter="{StaticResource TrueOrTrueToVisibilityConverter}">
                                    <Binding ElementName="chkOffice" Path="IsChecked"/>
                                    <Binding ElementName="chkBoth" Path="IsChecked"/>
                                </MultiBinding>
                            </Label.Visibility>
                        </Label>
                        <TextBox Text="{Binding CurrentGlobeweighUser.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" Grid.Row="3" TabIndex="1" Grid.Column="1" Margin="0,0,10,0">
                            <TextBox.Visibility>
                                <MultiBinding Converter="{StaticResource TrueOrTrueToVisibilityConverter}">
                                    <Binding ElementName="chkOffice" Path="IsChecked"/>
                                    <Binding ElementName="chkBoth" Path="IsChecked"/>
                                </MultiBinding>
                            </TextBox.Visibility>
                        </TextBox>
                            <Label Content="Password*" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="6" Margin="0,5">
                            <Label.Visibility>
                                <MultiBinding Converter="{StaticResource TrueOrTrueToVisibilityConverter}">
                                    <Binding ElementName="chkOffice" Path="IsChecked"/>
                                    <Binding ElementName="chkBoth" Path="IsChecked"/>
                                </MultiBinding>
                            </Label.Visibility>
                        </Label>
                        <TextBox Text="{Binding CurrentGlobeweighUser.Password, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}" Grid.Row="6" Margin="0"  TabIndex="2" Grid.Column="1" HorizontalAlignment="Left" Width="150">
                            <TextBox.Visibility>
                                <MultiBinding Converter="{StaticResource TrueOrTrueToVisibilityConverter}">
                                    <Binding ElementName="chkOffice" Path="IsChecked"/>
                                    <Binding ElementName="chkBoth" Path="IsChecked"/>
                                </MultiBinding>
                            </TextBox.Visibility>
                        </TextBox>
                        <Label Content="Passcode (Touch)" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="7" Margin="0,5">
                            <Label.Visibility>
                                <MultiBinding Converter="{StaticResource TrueOrTrueToVisibilityConverter}">
                                    <Binding ElementName="chkTouch" Path="IsChecked"/>
                                    <Binding ElementName="chkBoth" Path="IsChecked"/>
                                </MultiBinding>
                            </Label.Visibility>
                        </Label>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="7">
                            <StackPanel.Visibility>
                                <MultiBinding Converter="{StaticResource TrueOrTrueToVisibilityConverter}">
                                    <Binding ElementName="chkTouch" Path="IsChecked"/>
                                    <Binding ElementName="chkBoth" Path="IsChecked"/>
                                </MultiBinding>
                            </StackPanel.Visibility>
                            <!--<TextBox Text="{Binding CurrentGlobeweighUser.Passcode, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextBoxStyle}"  InputScope="Number" Grid.Row="6" Margin="0"  TabIndex="2" Grid.Column="1" HorizontalAlignment="Left" Width="150"/>-->
                            <dxe:TextEdit Text="{Binding CurrentGlobeweighUser.Passcode, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource DefaultTextEditStyle}" InputScope="Digits" MaxLength="4" Margin="0"  TabIndex="2" Grid.Column="1" HorizontalAlignment="Left" Width="150">
                                <dxe:TextEdit.Visibility>
                                    <MultiBinding Converter="{StaticResource TrueOrTrueToVisibilityConverter}">
                                        <Binding ElementName="chkTouch" Path="IsChecked"/>
                                        <Binding ElementName="chkBoth" Path="IsChecked"/>
                                    </MultiBinding>
                                </dxe:TextEdit.Visibility>
                            </dxe:TextEdit>
                                <Label Content="(4 digits)" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="6" Margin="10,5,0,5"/>
                        </StackPanel>
                        <Label Content="Account Disabled" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="8" Margin="0,5"/>

                        <CheckBox IsChecked="{Binding CurrentGlobeweighUser.Disabled}" Height="36" HorizontalAlignment="Left" Grid.Row="8" Grid.Column="1"/>
                    </Grid>
                    <Border Grid.Column="3" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DefaultBorderBrush}" Margin="20,0,0,0">
                        <Grid Margin="20,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource GlobeweighBlueBrush}" BorderThickness="0" IsEnabled="{Binding ElementName=chkTouch,Path=IsChecked, Converter={StaticResource TrueToFalseConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Roles" Style="{DynamicResource DefaultLabelStyle}"  Foreground="{DynamicResource GlobeweighBlueBrush}" FontFamily="Segoe UI Semibold" Margin="2,0,0,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right" Grid.Column="1" >
                                        <Button Content="Add" Command="{Binding AddRoleCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                        <Button Content="Delete"  Command="{Binding DeleteRoleCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd1}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                                        <!--<Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>-->
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <dxg:GridControl x:Name="grd1" ItemsSource="{Binding CurrentGlobeweighUser.Globeweigh_Role}" SelectedItem="{Binding SelectedRole}" FontSize="12" MaxHeight="500" ShowBorder="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="0,5,0,0">
                                <dxg:GridControl.View>
                                    <dxg:TableView x:Name="tvGrid1" AllowPerPixelScrolling="True"  ShowColumnHeaders="False"  ShowAutoFilterRow="False"  ShowGroupPanel="False" ShowSearchPanelMode="Never" ShowIndicator="False"  AutoWidth="True"  NavigationStyle="Row"  VerticalScrollbarVisibility="Auto"/>
                                </dxg:GridControl.View>
                                <dxg:GridColumn FieldName="RoleId" Header="Role" AllowEditing="true">
                                    <dxg:GridColumn.EditSettings>
                                        <dxe:ComboBoxEditSettings ImmediatePopup="True" ItemsSource="{Binding Source={model:Enum {x:Type model:eUserRole}}}" DisplayMember="Description" ValueMember="Value" IsTextEditable="False" />
                                    </dxg:GridColumn.EditSettings>
                                </dxg:GridColumn>
                            </dxg:GridControl>



                        </Grid>
                    </Border>

                </Grid>

            </Border>

            <Border Grid.Row="2">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save"  Width="100" Command="{Binding SaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>
