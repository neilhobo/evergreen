<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.SelectRolesView"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="500" Width="400" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White">


    <shared:WindowBase.Resources>

        <ResourceDictionary>

            <converters:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:TrueToCollapsedConverter x:Key="TrueToCollapsedConverter"/>
            <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter"/>

            <!--<converters:ZeroToCollapsedConverter x:Key="ZeroToCollapsedConverter"/>
            <converters:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter"/>-->

            <DataTemplate x:Key="selectCellTemplate">
                <dxe:CheckEdit IsChecked="{Binding Path=RowData.Row.IsSelected}" HorizontalAlignment="Center"></dxe:CheckEdit>
            </DataTemplate>

            <Style x:Key="rowStyle" TargetType="{x:Type dxg:RowControl}">
                <Setter Property="Height" Value="30"></Setter>
            </Style>

        </ResourceDictionary>

    </shared:WindowBase.Resources>

    <Border Margin="0" CornerRadius="3" Background="White">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="Add Role" Style="{DynamicResource TransactionHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Roles" Style="{DynamicResource DefaultLabelStyle}"  Foreground="{DynamicResource GlobeweighBlueBrush}" FontFamily="Segoe UI Semibold"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right" Grid.Column="1" >
                                <!--<Button Content="Edit" Command="{Binding EditCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>-->
                            </StackPanel>
                        </Grid>

                    </Border>
                    <dxg:GridControl x:Name="grd1" ItemsSource="{Binding RoleList}" SelectedItem="{Binding SelectedRole}"  FontSize="12" MaxHeight="500" ShowBorder="False"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="0,4,0,0">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvGrid1" AllowPerPixelScrolling="True"  ShowColumnHeaders="False"  ShowAutoFilterRow="False" ShowGroupPanel="False" ShowSearchPanelMode="Never" ShowIndicator="False"  AutoWidth="True"  NavigationStyle="Row"  VerticalScrollbarVisibility="Auto"/>
                        </dxg:GridControl.View>
                        <!--<dxg:GridColumn FieldName="IsSelected" Width="50" Header=" " FixedWidth="True" AllowEditing="True" CellTemplate="{DynamicResource selectCellTemplate}"/>-->
                        <dxg:GridColumn FieldName="DisplayName"  />
                    </dxg:GridControl>



                </Grid>
            </Border>

            <Border Grid.Row="2">
                <Grid Margin="10,0">
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Select"  Width="100" Command="{Binding SaveCommand}" Style="{DynamicResource TransactionButtonStyleAction}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Style="{DynamicResource TransactionButtonStyleCancel}" Margin="20,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>
