<shared:WindowBase
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
        xmlns:model="clr-namespace:Globeweigh.Model;assembly=Globeweigh.Model"
        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
        xmlns:helpers="clr-namespace:Globeweigh.Model.Helpers;assembly=Globeweigh.Model"
        xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
        xmlns:helpers1="clr-namespace:Globeweigh.Shared.Helpers;assembly=Globeweigh.Shared"
        x:Class="Globeweigh.Admin.AddEditGlobeweighUserViewOld"
        mc:Ignorable="d" ResizeMode="NoResize"  WindowStyle="None"
        Height="400" Width="600" WindowStartupLocation="CenterScreen" WindowState="Normal" 
        md:DialogServiceViews.IsRegistered="True" Background="White"
        >
    
    <Window.Resources>

        <converters:IsFactoryUserToCollapsedConverter x:Key="IsFactoryUserToCollapsedConverter"/>
        
        
    </Window.Resources>

    <Border Margin="4">
        <Grid Margin="0" Background="White"         dx:ThemeManager.ThemeName="MetropolisLight">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource MainBorderBrush}" Background="{DynamicResource LightGreyBrush}" >
                <Grid Margin="10,0,0,0">
                    <TextBlock Text="{Binding HeaderText, FallbackValue=Header Text}" Style="{DynamicResource GreyHeaderTextBlockStyle}"/>
                </Grid>
            </Border>
            <Border Grid.Row="1">
                <Grid Margin="0">
                    <Grid x:Name="ControlsGrid" Grid.RowSpan="2" Grid.Row="1" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="First Name" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,0,20"/>
                        <TextBox Text="{Binding CurrentGlobeweighUser.FirstName, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource TransactionTextBoxStyle}" Margin="0,0,0,20" Width="200"/>
                        <TextBlock Text="Surname" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,0,20" Grid.Row="1"/>
                        <TextBox Text="{Binding CurrentGlobeweighUser.Surname, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource TransactionTextBoxStyle}" Margin="0,0,0,20" Grid.Row="1" Width="200"/>
                        <TextBlock Text="Username (Login)" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,0,20" Grid.Row="3" Visibility="{Binding CurrentGlobeweighUser.RoleId, Converter={StaticResource IsFactoryUserToCollapsedConverter}}"/>
                        <TextBox Text="{Binding CurrentGlobeweighUser.Username, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource TransactionTextBoxStyle}" Margin="0,0,0,20" Visibility="{Binding CurrentGlobeweighUser.RoleId, Converter={StaticResource IsFactoryUserToCollapsedConverter}}" Grid.Row="3" Width="130"/>
                        <TextBlock Text="Password" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,0,20" Grid.Row="4" Visibility="{Binding CurrentGlobeweighUser.RoleId, Converter={StaticResource IsFactoryUserToCollapsedConverter}}"/>
                        <!--<dxe:PasswordBoxEdit Text="{Binding CurrentGlobeweighUser.Password, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Margin="0,0,0,20" HorizontalAlignment="Left" Grid.Row="3" Width="200"/>-->
                        <TextBox Text="{Binding CurrentGlobeweighUser.Password, UpdateSourceTrigger=PropertyChanged}"  Grid.Column="1" Style="{DynamicResource TransactionTextBoxStyle}" Margin="0,0,0,20" Visibility="{Binding CurrentGlobeweighUser.RoleId, Converter={StaticResource IsFactoryUserToCollapsedConverter}}" Grid.Row="4" Width="130"/>
                        <TextBlock Text="Role:" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,10,20" Grid.Row="2" FontFamily="Segoe UI Semibold" />
                        <dxe:ComboBoxEdit x:Name="cboProductType" Grid.Column="1" Grid.Row="2"  ItemsSource="{Binding Source={model:Enum {x:Type model:eUserRole}}}" EditValue="{Binding CurrentGlobeweighUser.RoleId,UpdateSourceTrigger=PropertyChanged}" Foreground="Black" IsTextEditable="False" DisplayMember="Description" ValueMember="Value" Margin="0,0,0,16" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="130" ShowNullTextForEmptyValue="False" ShowError="False" ShowErrorToolTip="False"/>
                        <TextBlock Text="Costing Access:" Style="{DynamicResource TransactionLabelTextBlockStyle}" Margin="0,0,10,20" Grid.Row="5" FontFamily="Segoe UI Semibold" Visibility="{Binding CurrentGlobeweighUser.RoleId, Converter={StaticResource IsFactoryUserToCollapsedConverter}}" />
                        <CheckBox Grid.Column="1" Grid.Row="5" IsChecked="{Binding CurrentGlobeweighUser.CostingAccess}" Margin="0,0,0,20" Visibility="{Binding CurrentGlobeweighUser.RoleId, Converter={StaticResource IsFactoryUserToCollapsedConverter}}" />

                    </Grid>
                </Grid>

            </Border>

            <Border Background="{DynamicResource LightGreyBrush}" Padding="0" Margin="0" Grid.Row="2" BorderBrush="{DynamicResource MainBorderBrush}">
                <Grid>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Save" Width="100" Command="{Binding SaveCommand}"/>
                        <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}" Margin="20,0,6,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</shared:WindowBase>
