<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
             md:DialogServiceViews.IsRegistered="True"
           xmlns:controls="clr-namespace:Globeweigh.Shared.Controls;assembly=Globeweigh.Shared"
           xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
           x:Class="Globeweigh.Admin.AddressListView"
             mc:Ignorable="d"  dx:ThemeManager.ThemeName="MetropolisLight"
             d:DesignHeight="300" d:DesignWidth="800"
             shared:ViewModelBehavior.LoadUnload="True"
             DataContext="{Binding AddressListView, Source={StaticResource Locator}}" Background="{DynamicResource LightGreyBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Globeweigh.Shared;component/ResourceDictionaries/SharedElementStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>

            <Style x:Key="LeftMenuEntityItemContainerStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource LeftMenuItemContainerStyleBase}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Grid Background="{TemplateBinding Background}">
                                <TextBlock Text="{TemplateBinding Content}" TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Margin="0,3" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"/>
                                <Trigger Property="Selector.IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="#FF0063B1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource LightGreyBrush}" Margin="0,0,10,10">

        <Grid Margin="0" >
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="453*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource LightGreyBrush}" BorderBrush="{DynamicResource MainBorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Addresses" Style="{DynamicResource DefaultLabelStyle}" Grid.Row="3" FontFamily="Segoe UI Semibold" FontSize="13"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0" HorizontalAlignment="Right" Grid.Column="1" >
                        <controls:ImageButton Content="Add" ImageSource="/Images\Add-Square-32.png" Command="{Binding AddCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                        <controls:ImageButton Content="Edit" ImageSource="/Images\Add-Square-32.png" Command="{Binding EditCommand}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                        <controls:ImageButton Content="Delete" ImageSource="/Images\Delete-32.png" Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedItems.Count, ElementName=grd}" Style="{DynamicResource ToolbarButtonStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border BorderThickness="1" Grid.Row="1" Visibility="{Binding SelectedEntity, Converter={StaticResource NullToCollapsedConverter}}">
                <Grid>
                    <dxg:GridControl x:Name="grd1" ItemsSource="{Binding AddressList}" SelectedItem="{Binding SelectedAddress}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="0,10,0,0">
                        <dxg:GridControl.View>
                            <dxg:TableView x:Name="tvGrid1" >
                            </dxg:TableView>
                        </dxg:GridControl.View>
                        <dxg:GridColumn FieldName="AddressName" Header="Address Name" Width="200" FixedWidth="True"/>
                        <dxg:GridColumn FieldName="AddressDisplayOneLine" Header="Address" />
                    </dxg:GridControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
