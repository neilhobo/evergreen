<MahApps:MetroWindow
    x:Class="Globeweigh.Admin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:MahApps="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:controls="clr-namespace:Globeweigh.Admin.Controls"
    xmlns:converters="clr-namespace:Globeweigh.Shared.Converters;assembly=Globeweigh.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
    xmlns:local="clr-namespace:Globeweigh.Admin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    xmlns:shared="clr-namespace:Globeweigh.Shared;assembly=Globeweigh.Shared"
    Title="Globeweigh"
    Width="1900"
    Height="1024"
    md:DialogServiceViews.IsRegistered="True"
    shared:ViewModelBehavior.LoadUnload="True"
    Background="{DynamicResource DarkGreyBrush}"
    DataContext="{Binding MainWindow, Source={StaticResource Locator}}"
    Icon="Globe-96.ico"
    WindowStartupLocation="CenterScreen"
    WindowTitleBrush="#FF3F3F46"
    mc:Ignorable="d">
    <MahApps:MetroWindow.Resources>
        <converters:TrueToVisibilityConverter x:Key="TrueToVisibilityConverter" />


        <DataTemplate DataType="{x:Type local:GateBarrierViewModel}">
            <local:GateBarrierView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:GateBarrierWebViewModel}">
            <local:GateBarrierWebView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:EntitiesViewModel}">
            <local:EntitiesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ReferenceDataMasterViewModel}">
            <local:ReferenceDataMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ProductionMasterViewModel}">
            <local:ProductionMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CompletedOrderListViewModel}">
            <local:CompletedOrderListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CostingPriceListViewModel}">
            <local:CostingPriceListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ProductsMasterViewModel}">
            <local:ProductsMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:HaulierListViewModel}">
            <local:HaulierListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:WeighbridgeViewModel}">
            <local:WeighbridgeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ReportsMasterViewModel}">
            <local:ReportsMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:DispatchOrderListViewModel}">
            <local:DispatchOrderListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CustomerSupplierListViewModel}">
            <local:CustomerSupplierListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:FinishedProductStockMasterViewModel}">
            <local:FinishedProductStockMasterView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:WeighbridgeRecordsViewModel}">
            <local:WeighbridgeRecordsView />
        </DataTemplate>

        <Style x:Key="MainMenuItemStyle" TargetType="{x:Type controls:MenuListBoxItem}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:MenuListBoxItem}">
                        <Border Height="50" d:DesignWidth="200" Background="{TemplateBinding Background}" BorderBrush="#FF747474" BorderThickness="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Image Margin="8" Source="{Binding ImageSource, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Border x:Name="Bd" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" SnapsToDevicePixels="true">
                                    <TextBlock Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Whitney HTF Medium" FontSize="13" Foreground="White" Text="{TemplateBinding Content}" TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                                <ContentPresenter Grid.RowSpan="2" Grid.ColumnSpan="2" Content="" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GlobeweighLightBlueBrush}" />
                            </Trigger>
                            <Trigger Property="Selector.IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource GlobeweighBlueBrush}" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MyAccountButtonStyle" BasedOn="{StaticResource TransactionButtonStyleBase}" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="9*" />
                                </Grid.ColumnDefinitions>
                                <!--<Image Source="Images/Circled User Male-32.png" VerticalAlignment="Center" HorizontalAlignment="Center" Width="32" Height="32" Margin="0,0,0,0"/>-->
                                <Grid>
                                    <Ellipse Width="36" Height="36" Fill="{DynamicResource GlobeweighBlueBrush}" />
                                    <Label Margin="0,0,2,2" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Tag}" FontFamily="Segoe UI Semibold" FontSize="14" Foreground="White" />
                                </Grid>
                                <TextBlock Name="content" Grid.Column="1" Margin="10,0,10,2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Semibold" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Content}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF536D82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </MahApps:MetroWindow.Resources>

    <Border Margin="0">
        <Grid Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="1089*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource DarkGreyBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border BorderThickness="0,0,1,0">
                            <Grid Margin="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="11*" />
                                    <ColumnDefinition Width="32*" />
                                </Grid.ColumnDefinitions>
                                <Image Margin="2" Source="/Globeweigh.Admin;component/Images/Globe-96.png" />
                                <Grid Grid.Column="1" Margin="8,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="14" Foreground="White" Text="Globeweigh" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock FontSize="14" Foreground="White" Text="Manager" />
                                        <!--<TextBlock Text="{Binding CurrentVersion, FallbackValue=v.1.1}" Foreground="White" VerticalAlignment="Center" Margin="6,3,0,0" FontSize="8" />-->
                                        <dxe:HyperlinkEdit Command="{Binding ShowAboutCommand}" Foreground="White" Text="{Binding CurrentVersion, FallbackValue=v.1.1}" />
                                    </StackPanel>

                                </Grid>
                            </Grid>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="#FF1D8370" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding InTestMode}" Value="True">
                                            <Setter Property="Background" Value="#FF870C0C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                        </Border>

                        <!--<Grid Background="Red">

                    </Grid>-->
                    </Grid>

                    <ListBox
                        x:Name="list"
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Background="{x:Null}"
                        BorderThickness="0"
                        ItemContainerStyle="{DynamicResource MainMenuItemStyle}"
                        Loaded="FrameworkElement_OnLoaded"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectedIndex="0"
                        SelectedItem="{Binding SelectedNavItem}">

                        <controls:MenuListBoxItem x:Name="Weighbridge" Content="Weighbridge" ImageSource="/Globeweigh.Admin;component/Images/weighbridge-96.png" />
                        <controls:MenuListBoxItem x:Name="Dispatch" Content="Orders / Dispatch" ImageSource="/Globeweigh.Admin;component/Images/Dispatch-96.png" />
                        <controls:MenuListBoxItem x:Name="Costing" Content="Costing" ImageSource="/Globeweigh.Admin;component/Images/Money-96.png" />
                        <controls:MenuListBoxItem x:Name="Production" Content="Production" ImageSource="/Globeweigh.Admin;component/Images/Dropbox-96.png" />

                        <controls:MenuListBoxItem x:Name="CompletedOrders" Content="Completed Orders" ImageSource="/Globeweigh.Admin;component/Images/task-completed-96.png" />
                        <!--<controls:MenuListBoxItem x:Name="Stock" Content="Stock" IsSelected="True" ImageSource="/Globeweigh.Admin;component/Images/Stock-96.png"/>-->
                        <controls:MenuListBoxItem x:Name="CustomersSuppliers" Content="Customers/Suppliers" ImageSource="/Globeweigh.Admin;component/Images/Customers-96.png" />
                        <controls:MenuListBoxItem x:Name="Products" Content="Products" ImageSource="/Globeweigh.Admin;component/Images/Product-96.png" />
                        <controls:MenuListBoxItem x:Name="Hauliers" Content="Hauliers" ImageSource="/Globeweigh.Admin;component/Images/Dispatch-96.png" />
                        <!--<controls:MenuListBoxItem x:Name="Reports" Content="Reports"  ImageSource="/Globeweigh.Admin;component/Images/Reports-96.png"/>-->
                        <controls:MenuListBoxItem x:Name="Admin" Content="Admin" ImageSource="/Globeweigh.Admin;component/Images/admin-96.png" Visibility="{Binding DataSetupVisible, Converter={StaticResource TrueToVisibilityConverter}}" />
                        <controls:MenuListBoxItem x:Name="GateBarrier" Content="Gate/Barrier" ImageSource="/Globeweigh.Admin;component/Images/gate-96.png" />
                        <controls:MenuListBoxItem x:Name="GateBarrierWeb" Content="Gate/Barrier (Web)" ImageSource="/Globeweigh.Admin;component/Images/gate-96.png" />
                    </ListBox>


                    <Grid Grid.Row="2" Visibility="{Binding IsGlobeweighAdmin, Converter={StaticResource TrueToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="50*" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="10,0,0,0" FontSize="16" Foreground="White" Style="{DynamicResource HeaderTextBlockStyle}" Text="Globeweigh Admin" />
                        <ListBox Grid.Row="1" Grid.RowSpan="2" Background="{x:Null}" BorderThickness="0" ItemContainerStyle="{DynamicResource MainMenuItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectedItem="{Binding SelectedNavItem}">
                            <controls:MenuListBoxItem x:Name="entities" Content="Entities" ImageSource="/Globeweigh.Admin;component/Images/Dropbox-96.png" />
                            <controls:MenuListBoxItem x:Name="devices" Content="Devices" ImageSource="/Globeweigh.Admin;component/Images/Computer-96.png" />
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource DarkGreyBrush}" BorderThickness="0">
                    <Grid Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center" Visibility="{Binding NewVersionAvailable, Converter={StaticResource TrueToVisibilityConverter}}">
                            <dxe:HyperlinkEdit HorizontalAlignment="Right" Command="{Binding DownloadNewVersionCommand}" EditValue="{Binding NewVersionAvailableMessage}" FontSize="16" Foreground="White" />
                        </Grid>
                        <Button Grid.Column="2" Height="Auto" Command="{Binding MyAccountCommand}" Content="{Binding CurrentGlobeweighUser.FullName, FallbackValue=Administrator}" Style="{DynamicResource MyAccountButtonStyle}" Tag="{Binding CurrentGlobeweighUser.Initials}" />
                        <!--<StackPanel Orientation="Horizontal"  Grid.Column="2" Margin="10,0,30,0">
                            <Image Source="Images/Circled User Male-32.png" VerticalAlignment="Center" HorizontalAlignment="Center" Width="32" Height="32" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding LoggedInUserDisplay, FallbackValue=Administrator}" Style="{DynamicResource TransactionHeaderTextBlockStyle}" Grid.Column="3" FontSize="16" Foreground="White"/>
                        </StackPanel>-->
                    </Grid>
                </Border>
                <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
            </Grid>

        </Grid>
    </Border>
</MahApps:MetroWindow>

