        "theme": "Dark",
        "decorations": false,
        "backgroundColor": "#0d1624",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --unsafely-treat-insecure-origin-as-secure=http://192.168.250.5:5099,http://192.168.250.5,http://evergreen:5099,http://evergreen,http://evergreen.tail9b21d.ts.net"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNUYwMEJFRDA3OTU5NTIKUldSU1dYblF2Z0JmYzRtSzBEQThtUW5yODlhSFBjWE1NN2xiU2hJdmprQWowVDgxVDJoVnZJYk8K",
      "endpoints": ["http://192.168.250.5:5099/api/admin-app/latest.json"],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
