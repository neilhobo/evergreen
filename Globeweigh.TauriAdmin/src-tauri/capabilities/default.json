{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — applies to the bundled loader page AND the server-hosted UI (remote urls below), so the remote page keeps Tauri plugin access (http/updater/process/opener).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://192.168.250.5/*",
      "http://192.168.250.5:5099/*",
      "http://evergreen/*",
      "http://evergreen:5099/*",
      "http://evergreen.tail9b21d.ts.net/*",
      "http://localhost:5099/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-launch-vnc",
    "allow-print-system-dialog",
    "allow-export-pdf",
    "allow-print-note",
    "allow-list-printers",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-is-decorated",
    "opener:default",
    "updater:default",
    "process:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "adb", "cmd": "adb", "args": true },
        { "name": "scrcpy", "cmd": "scrcpy", "args": true }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
