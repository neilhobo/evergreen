{
  "name": "globeweigh-tauriadmin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:VITE_API_TARGET='production'; & ./dev.ps1 dev\"",
    "dev:vite": "node ./dev-vite.mjs",
    "predev:api": "powershell -NoProfile -Command \"$api=(Resolve-Path '../Globeweigh.Api').Path; Get-Process Globeweigh.Api -ErrorAction SilentlyContinue | Where-Object { $_.Path -like ($api+'\\*') } | Stop-Process -Force; exit 0\"",
    "dev:api": "dotnet watch --non-interactive --project ../Globeweigh.Api/Globeweigh.Api.csproj run --launch-profile http",
    "dev:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1 dev",
    "dev:full": "concurrently --kill-others --names api,vite,tauri --prefix-colors blue,magenta,green \"npm:dev:api\" \"vite\" \"powershell -NoProfile -ExecutionPolicy Bypass -File ./dev.ps1 dev -ExternalVite\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ../Globeweigh.Api/deploy/deploy-to-evergreen.ps1",
    "deploy:api": "powershell -NoProfile -ExecutionPolicy Bypass -File ../Globeweigh.Api/deploy/deploy-to-evergreen.ps1 -SkipUi",
    "deploy:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File ./deploy-admin-ui.ps1 -Target \\\\evergreen\\Globeweigh\\EvergreenApi\\wwwroot\\admin"
  },
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "bwip-js": "^4.11.2",
    "exceljs": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
