default_platform(:ios)

platform :ios do
  def asc_api_key
    app_store_connect_api_key(
      key_id: "JMRW9TWS55",
      issuer_id: "0e326619-dad8-4b55-9fc8-e818f924cd83",
      key_filepath: "#{Dir.home}/.appstoreconnect/private_keys/AuthKey_JMRW9TWS55.p8",
      duration: 1200,
      in_house: false,
    )
  end

  desc "Make (or renew) and install the App Store provisioning profile with the API key, so the Release build's manual signing never needs Xcode's own Apple ID login."
  lane :profiles do
    get_provisioning_profile(
      api_key: asc_api_key,
      app_identifier: "com.specdigital.evergreen",
      provisioning_name: "Evergreen App Store",
      readonly: false,
      ignore_profiles_with_different_name: true,
    )
  end

  def latest_ipa
    # Fastlane runs from app/ios/fastlane/, so the project's build/ is two levels up.
    ipa = Dir[File.expand_path("../../build/ios/ipa/*.ipa", __dir__)].first
    UI.user_error!("No IPA found in app/build/ios/ipa/. Run `flutter build ipa` first.") unless ipa
    ipa
  end

  desc "Upload the latest IPA to TestFlight."
  lane :beta do
    pilot(
      api_key: asc_api_key,
      ipa: latest_ipa,
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "Internal build",
    )
  end

  desc "Submit the already-uploaded (TestFlight-processed) build for App Store review with auto-release on approval. Skips build + upload — use after a beta upload of the same IPA. Pass build_number:<n> when build/ios/ipa no longer holds the release IPA (a later Shorebird patch build overwrites it), otherwise deliver waits forever for a build that was never uploaded."
  lane :promote do |options|
    common = {
      api_key: asc_api_key,
      skip_binary_upload: true,
      # Metadata NOT skipped: uploads only the files present under
      # fastlane/metadata/ (currently just release_notes.txt — Apple requires
      # a "What's New" on every new version of a previously-released app).
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      reject_if_possible: true,
      # API-key auth can't inspect IAPs (fastlane limitation); the app has
      # none, so exclude them or precheck aborts the submission.
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    }
    if options[:build_number]
      # deliver refuses build_number together with ipa, so name the version
      # in full instead: fastlane ios promote build_number:118 app_version:1.2.4
      version = options[:app_version] ||
                UI.user_error!("app_version:x.y.z is required with build_number:")
      deliver(common.merge(
        app_identifier: "com.specdigital.evergreen",
        app_version: version.to_s,
        build_number: options[:build_number].to_s,
      ))
    else
      deliver(common.merge(ipa: latest_ipa))
    end
  end

  desc "Upload to TestFlight then submit the build for App Store review with auto-release on approval."
  lane :production do
    ipa = latest_ipa
    api_key = asc_api_key

    # 1. Push the binary to App Store Connect (also makes it available on TestFlight).
    pilot(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: false, # need the build processed before deliver
      changelog: ENV["CHANGELOG"] || "Production build",
    )

    # 2. Submit the just-uploaded build for App Store review.
    # skip_binary_upload: true — pilot already pushed it.
    # skip_metadata / skip_screenshots — relies on whatever's already configured
    # in App Store Connect for this version. First-time prod setups still need
    # screenshots, description, nutrition label etc. set in App Store Connect.
    deliver(
      api_key: api_key,
      ipa: ipa,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true, # don't show HTML preview
      reject_if_possible: true, # cancel any pending review for the same version
      precheck_include_in_app_purchases: false, # API-key auth can't check IAPs
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end
end
