{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window — applies to the bundled loader page AND the server-hosted UI (remote urls below), so the remote page keeps Tauri plugin access (http/updater/process/opener).",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://192.168.250.5/*",
      "http://192.168.250.5:5099/*",
      "http://evergreen/*",
      "http://evergreen:5099/*",
      "http://evergreen.tail9b21d.ts.net/*",
      "http://localhost:5099/*"
    ]
  },
  "permissions": [
    "allow-list-com-ports",
    "allow-probe-com-ports",
    "allow-list-printers",
    "allow-print-raw",
    "allow-print-image",
    "allow-weighscale-connect",
    "allow-weighscale-disconnect",
    "allow-probe-relay-ports",
    "allow-relay-connect",
    "allow-relay-set",
    "allow-relay-disconnect",
    "core:default",
    "opener:default",
    "updater:default",
    "process:default",
    "os:default",
    "os:allow-hostname",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
